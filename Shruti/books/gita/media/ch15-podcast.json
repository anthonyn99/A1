.118,"in"],[8.987,0.526,"fire"],[9.539,0.118,"to"],[9.671,0.118,"be"],[9.803,0.447,"Mine"]]},{"s":"A","start":259.176,"end":273.864,"text":"Fifteen point thirteen and fourteen: entering the earth, I support all beings with My energy. Becoming the moon, I nourish all the plants. Becoming the digestive fire in the body, I digest all types of food.","L":["L3"],"words":[[0.092,0.5,"Fifteen"],[0.605,0.276,"point"],[0.895,0.474,"thirteen"],[1.382,0.118,"and"],[1.513,0.658,"fourteen"],[2.855,0.382,"entering"],[3.25,0.118,"the"],[3.382,0.355,"earth"],[4.039,0.066,"I"],[4.118,0.474,"support"],[4.605,0.211,"all"],[4.829,0.447,"beings"],[5.289,0.184,"with"],[5.487,0.171,"My"],[5.671,0.618,"energy"],[6.711,0.421,"Becoming"],[7.145,0.079,"the"],[7.237,0.421,"moon"],[7.974,0.039,"I"],[8.026,0.5,"nourish"],[8.539,0.171,"all"],[8.724,0.105,"the"],[8.842,0.711,"plants"],[9.974,0.434,"Becoming"],[10.421,0.105,"the"],[10.539,0.671,"digestive"],[11.224,0.382,"fire"],[11.618,0.092,"in"],[11.724,0.092,"the"],[11.829,0.447,"body"],[12.566,0.092,"I"],[12.671,0.539,"digest"],[13.224,0.197,"all"],[13.434,0.342,"types"],[13.789,0.066,"of"],[13.868,0.434,"food"]]},{"s":"B","start":274.152,"end":281.688,"text":"That's the verse behind the mealtime tradition. Saying it is a way of remembering who's really doing the digesting.","L":["L3"],"words":[[0.079,0.303,"That's"],[0.395,0.105,"the"],[0.513,0.474,"verse"],[1.0,0.5,"behind"],[1.513,0.079,"the"],[1.605,0.539,"mealtime"],[2.158,0.658,"tradition"],[3.237,0.355,"Saying"],[3.605,0.184,"it"],[3.803,0.171,"is"],[3.987,0.105,"a"],[4.105,0.342,"way"],[4.461,0.184,"of"],[4.658,0.658,"remembering"],[5.329,0.276,"who's"],[5.618,0.316,"really"],[5.947,0.316,"doing"],[6.276,0.105,"the"],[6.395,0.75,"digesting"]]},{"s":"A","start":281.976,"end":293.688,"text":"And fifteen point fifteen: I am seated in the heart of all beings. Memory, Self-knowledge, and the removal of doubts come from Me. I am to be known by all the Vedas.","L":["L3"],"words":[[0.105,0.132,"And"],[0.25,0.513,"fifteen"],[0.776,0.276,"point"],[1.066,0.632,"fifteen"],[2.434,0.053,"I"],[2.5,0.145,"am"],[2.658,0.421,"seated"],[3.092,0.105,"in"],[3.211,0.079,"the"],[3.303,0.289,"heart"],[3.605,0.118,"of"],[3.737,0.158,"all"],[3.908,0.671,"beings"],[5.0,0.474,"Memory"],[5.5,0.882,"Self-knowledge"],[6.697,0.118,"and"],[6.829,0.105,"the"],[6.947,0.5,"removal"],[7.461,0.132,"of"],[7.605,0.382,"doubts"],[8.0,0.237,"come"],[8.25,0.224,"from"],[8.487,0.316,"Me"],[9.224,0.118,"I"],[9.355,0.184,"am"],[9.553,0.105,"to"],[9.671,0.132,"be"],[9.816,0.303,"known"],[10.132,0.184,"by"],[10.329,0.211,"all"],[10.553,0.092,"the"],[10.658,0.671,"Vedas"]]},{"s":"B","start":293.976,"end":305.784,"text":"So God isn't only up at the root of the upside-down tree. He's also right here, in the light we read by, in the food on the plate, in the heart, and in the moment a doubt suddenly clears.","L":[],"words":[[0.051,0.25,"So"],[0.314,0.368,"God"],[0.709,0.329,"isn't"],[1.051,0.408,"only"],[1.472,0.25,"up"],[1.748,0.145,"at"],[1.906,0.066,"the"],[1.985,0.408,"root"],[2.419,0.145,"of"],[2.577,0.092,"the"],[2.682,0.684,"upside-down"],[3.38,0.421,"tree"],[4.237,0.211,"He's"],[4.461,0.342,"also"],[4.816,0.25,"right"],[5.079,0.408,"here"],[5.513,0.132,"in"],[5.658,0.105,"the"],[5.776,0.303,"light"],[6.092,0.132,"we"],[6.237,0.276,"read"],[6.526,0.368,"by"],[6.921,0.145,"in"],[7.079,0.092,"the"],[7.184,0.316,"food"],[7.513,0.105,"on"],[7.632,0.079,"the"],[7.724,0.395,"plate"],[8.145,0.132,"in"],[8.289,0.079,"the"],[8.382,0.461,"heart"],[9.092,0.211,"and"],[9.316,0.105,"in"],[9.434,0.079,"the"],[9.526,0.382,"moment"],[9.921,0.092,"a"],[10.026,0.329,"doubt"],[10.368,0.434,"suddenly"],[10.816,0.592,"clears"]]},{"s":"A","start":306.072,"end":314.544,"text":"I love that memory is on that list. The next time you suddenly remember something important, this verse says that's grace too.","L":[],"words":[[0.092,0.079,"I"],[0.184,0.289,"love"],[0.487,0.197,"that"],[0.697,0.474,"memory"],[1.184,0.145,"is"],[1.342,0.145,"on"],[1.5,0.237,"that"],[1.75,0.526,"list"],[2.711,0.092,"The"],[2.816,0.329,"next"],[3.158,0.211,"time"],[3.382,0.105,"you"],[3.5,0.5,"suddenly"],[4.013,0.487,"remember"],[4.513,0.395,"something"],[4.921,0.645,"important"],[6.158,0.224,"this"],[6.395,0.316,"verse"],[6.724,0.263,"says"],[7.0,0.25,"that's"],[7.263,0.368,"grace"],[7.645,0.421,"too"]]},{"s":"B","start":314.832,"end":328.464,"text":"Then the summit of the chapter. Fifteen point sixteen: there are two entities in the cosmos, the temporal and the unchangeable eternal. All created beings change; the Eternal does not change.","L":["L4"],"words":[[0.079,0.329,"Then"],[0.421,0.105,"the"],[0.539,0.487,"summit"],[1.039,0.145,"of"],[1.197,0.092,"the"],[1.303,0.684,"chapter"],[2.408,0.474,"Fifteen"],[2.895,0.276,"point"],[3.184,0.724,"sixteen"],[4.579,0.197,"there"],[4.789,0.105,"are"],[4.908,0.303,"two"],[5.224,0.566,"entities"],[5.803,0.145,"in"],[5.961,0.079,"the"],[6.053,0.697,"cosmos"],[6.776,0.118,"the"],[6.908,0.592,"temporal"],[7.513,0.118,"and"],[7.645,0.079,"the"],[7.737,0.697,"unchangeable"],[8.447,0.566,"eternal"],[9.434,0.171,"All"],[9.618,0.447,"created"],[10.079,0.316,"beings"],[10.408,0.671,"change"],[11.632,0.079,"the"],[11.724,0.474,"Eternal"],[12.211,0.171,"does"],[12.395,0.25,"not"],[12.658,0.579,"change"]]},{"s":"A","start":328.752,"end":342.672,"text":"Fifteen point seventeen and eighteen: the Supreme Being is beyond both, the temporal and the eternal, sustaining both by pervading everything. Therefore I am known in the world and in the Vedas as the Supreme Being.","L":["L4"],"words":[[0.092,0.513,"Fifteen"],[0.618,0.303,"point"],[0.934,0.592,"seventeen"],[1.539,0.132,"and"],[1.684,0.539,"eighteen"],[2.855,0.092,"the"],[2.961,0.474,"Supreme"],[3.447,0.289,"Being"],[3.75,0.145,"is"],[3.908,0.474,"beyond"],[4.395,0.382,"both"],[5.039,0.118,"the"],[5.171,0.539,"temporal"],[5.724,0.092,"and"],[5.829,0.092,"the"],[5.934,0.632,"eternal"],[6.882,0.592,"sustaining"],[7.487,0.289,"both"],[7.789,0.132,"by"],[7.934,0.579,"pervading"],[8.526,0.711,"everything"],[9.671,0.5,"Therefore"],[10.184,0.118,"I"],[10.316,0.158,"am"],[10.487,0.25,"known"],[10.75,0.105,"in"],[10.868,0.092,"the"],[10.974,0.408,"world"],[11.395,0.118,"and"],[11.526,0.105,"in"],[11.645,0.092,"the"],[11.75,0.5,"Vedas"],[12.263,0.158,"as"],[12.434,0.092,"the"],[12.539,0.487,"Supreme"],[13.039,0.5,"Being"]]},{"s":"B","start":342.96,"end":349.056,"text":"In Sanskrit that's Purushottama, the highest Person, and the traditional name of this chapter.","L":["L4"],"words":[[0.079,0.105,"In"],[0.197,0.645,"Sanskrit"],[0.855,0.263,"that's"],[1.132,0.921,"Purushottama"],[2.079,0.105,"the"],[2.197,0.421,"highest"],[2.632,0.526,"Person"],[3.474,0.25,"and"],[3.737,0.079,"the"],[3.829,0.579,"traditional"],[4.421,0.342,"name"],[4.776,0.118,"of"],[4.908,0.171,"this"],[5.092,0.618,"chapter"]]},{"s":"A","start":349.344,"end":365.4,"text":"Let me try to put the three side by side, because it's subtle. First, everything that changes: bodies, worlds, created beings. Second, the soul, which doesn't change. And third, the Supreme, who is beyond both and holds both.","L":[],"words":[[0.092,0.145,"Let"],[0.25,0.118,"me"],[0.382,0.197,"try"],[0.592,0.118,"to"],[0.724,0.184,"put"],[0.921,0.105,"the"],[1.039,0.263,"three"],[1.316,0.316,"side"],[1.645,0.158,"by"],[1.816,0.5,"side"],[2.605,0.342,"because"],[2.961,0.184,"it's"],[3.158,0.487,"subtle"],[4.079,0.382,"First"],[4.513,0.487,"everything"],[5.013,0.171,"that"],[5.197,0.684,"changes"],[6.053,0.566,"bodies"],[7.053,0.526,"worlds"],[7.645,0.461,"created"],[8.118,0.658,"beings"],[9.211,0.526,"Second"],[9.763,0.105,"the"],[9.882,0.408,"soul"],[10.329,0.224,"which"],[10.566,0.355,"doesn't"],[10.934,0.618,"change"],[11.987,0.171,"And"],[12.171,0.368,"third"],[12.566,0.105,"the"],[12.684,0.632,"Supreme"],[13.592,0.118,"who"],[13.724,0.145,"is"],[13.882,0.474,"beyond"],[14.368,0.289,"both"],[14.671,0.092,"and"],[14.776,0.355,"holds"],[15.145,0.513,"both"]]},{"s":"B","start":365.688,"end":376.56,"text":"Like the ocean, the waves, and the water. Our image, not the book's. The waves come and go, the water stays, and yet the ocean is more than either picture.","L":[],"words":[[0.092,0.184,"Like"],[0.289,0.066,"the"],[0.368,0.592,"ocean"],[0.987,0.118,"the"],[1.118,0.526,"waves"],[1.671,0.158,"and"],[1.842,0.092,"the"],[1.947,0.513,"water"],[2.841,0.145,"Our"],[2.999,0.592,"image"],[3.854,0.342,"not"],[4.209,0.105,"the"],[4.328,0.5,"book's"],[5.237,0.092,"The"],[5.342,0.421,"waves"],[5.776,0.263,"come"],[6.053,0.132,"and"],[6.197,0.421,"go"],[6.632,0.145,"the"],[6.789,0.329,"water"],[7.132,0.592,"stays"],[8.039,0.197,"and"],[8.25,0.25,"yet"],[8.513,0.066,"the"],[8.592,0.421,"ocean"],[9.026,0.145,"is"],[9.184,0.289,"more"],[9.487,0.145,"than"],[9.645,0.263,"either"],[9.921,0.553,"picture"]]},{"s":"A","start":376.848,"end":390.456,"text":"And the close, fifteen point twenty: thus I have explained this most secret science. Having understood it, one becomes enlightened, all duties are accomplished, and the goal of human life is achieved.","L":["L4"],"words":[[0.105,0.118,"And"],[0.237,0.092,"the"],[0.342,0.447,"close"],[0.816,0.487,"fifteen"],[1.316,0.276,"point"],[1.605,0.474,"twenty"],[2.763,0.25,"thus"],[3.026,0.092,"I"],[3.132,0.184,"have"],[3.329,0.553,"explained"],[3.895,0.171,"this"],[4.079,0.276,"most"],[4.368,0.382,"secret"],[4.763,0.763,"science"],[5.974,0.329,"Having"],[6.316,0.592,"understood"],[6.921,0.224,"it"],[7.487,0.25,"one"],[7.75,0.434,"becomes"],[8.197,0.632,"enlightened"],[9.132,0.184,"all"],[9.329,0.461,"duties"],[9.803,0.118,"are"],[9.934,0.803,"accomplished"],[11.053,0.105,"and"],[11.171,0.118,"the"],[11.303,0.276,"goal"],[11.592,0.105,"of"],[11.711,0.382,"human"],[12.105,0.289,"life"],[12.408,0.118,"is"],[12.539,0.671,"achieved"]]},{"s":"B","start":390.744,"end":397.104,"text":"All duties are accomplished. That's a remarkable promise for the end of such a short chapter.","L":[],"words":[[0.092,0.171,"All"],[0.276,0.539,"duties"],[0.829,0.197,"are"],[1.039,0.816,"accomplished"],[2.276,0.211,"That's"],[2.5,0.066,"a"],[2.579,0.645,"remarkable"],[3.237,0.618,"promise"],[3.868,0.184,"for"],[4.066,0.066,"the"],[4.145,0.368,"end"],[4.526,0.092,"of"],[4.632,0.276,"such"],[4.921,0.039,"a"],[4.974,0.368,"short"],[5.355,0.618,"chapter"]]},{"s":"B","start":397.968,"end":403.344,"text":"Lesson one: the world is a tree of Maya. Cut it with Self-knowledge.","L":["L1"],"words":[[0.052,0.408,"Lesson"],[0.473,0.421,"one"],[1.184,0.171,"the"],[1.368,0.408,"world"],[1.789,0.158,"is"],[1.96,0.066,"a"],[2.039,0.316,"tree"],[2.368,0.118,"of"],[2.499,0.487,"Maya"],[3.382,0.197,"Cut"],[3.592,0.171,"it"],[3.776,0.184,"with"],[3.974,1.0,"Self-knowledge"]]},{"s":"A","start":403.632,"end":414.0,"text":"Creation is like an upside-down banyan, rooted above in the Supreme, branching down into the world. Its roots here are ego, attachment and desire.","L":["L1"],"words":[[0.092,0.566,"Creation"],[0.671,0.158,"is"],[0.842,0.197,"like"],[1.053,0.132,"an"],[1.197,0.711,"upside-down"],[1.921,0.5,"banyan"],[2.763,0.263,"rooted"],[3.039,0.342,"above"],[3.395,0.092,"in"],[3.5,0.092,"the"],[3.605,0.632,"Supreme"],[4.605,0.474,"branching"],[5.092,0.289,"down"],[5.395,0.224,"into"],[5.632,0.105,"the"],[5.75,0.513,"world"],[6.684,0.197,"Its"],[6.895,0.303,"roots"],[7.211,0.25,"here"],[7.474,0.132,"are"],[7.618,0.487,"ego"],[8.566,0.632,"attachment"],[9.211,0.092,"and"],[9.316,0.671,"desire"]]},{"s":"B","start":414.288,"end":422.496,"text":"Those roots have to be cut with the axe of Self-knowledge and detachment. Then you can find the eternal abode the tree hides.","L":["L1"],"words":[[0.092,0.289,"Those"],[0.395,0.342,"roots"],[0.75,0.237,"have"],[1.0,0.105,"to"],[1.118,0.145,"be"],[1.276,0.368,"cut"],[1.658,0.184,"with"],[1.855,0.092,"the"],[1.961,0.395,"axe"],[2.368,0.118,"of"],[2.5,0.855,"Self-knowledge"],[3.368,0.118,"and"],[3.5,0.776,"detachment"],[4.684,0.197,"Then"],[4.895,0.132,"you"],[5.039,0.171,"can"],[5.224,0.487,"find"],[5.724,0.066,"the"],[5.803,0.579,"eternal"],[6.408,0.5,"abode"],[6.921,0.079,"the"],[7.013,0.263,"tree"],[7.289,0.526,"hides"]]},{"s":"A","start":422.784,"end":436.56,"text":"In daily life, the roots show up as small things. Needing to be right. Needing to have more. Needing things to go my way. Each time one of those is noticed and set down, a root gets a little looser.","L":[],"words":[[0.092,0.132,"In"],[0.237,0.355,"daily"],[0.605,0.447,"life"],[1.368,0.105,"the"],[1.487,0.289,"roots"],[1.789,0.237,"show"],[2.039,0.158,"up"],[2.211,0.118,"as"],[2.342,0.329,"small"],[2.684,0.592,"things"],[3.697,0.329,"Needing"],[4.039,0.118,"to"],[4.171,0.145,"be"],[4.329,0.487,"right"],[5.237,0.342,"Needing"],[5.592,0.118,"to"],[5.724,0.211,"have"],[5.947,0.487,"more"],[6.855,0.368,"Needing"],[7.237,0.303,"things"],[7.553,0.118,"to"],[7.684,0.158,"go"],[7.855,0.184,"my"],[8.053,0.461,"way"],[8.934,0.237,"Each"],[9.184,0.303,"time"],[9.5,0.171,"one"],[9.684,0.092,"of"],[9.789,0.276,"those"],[10.079,0.132,"is"],[10.224,0.5,"noticed"],[10.737,0.118,"and"],[10.868,0.276,"set"],[11.158,0.368,"down"],[11.868,0.026,"a"],[11.908,0.303,"root"],[12.224,0.237,"gets"],[12.474,0.053,"a"],[12.539,0.276,"little"],[12.829,0.539,"looser"]]},{"s":"A","start":437.424,"end":441.984,"text":"Lesson two: the soul carries impressions from body to body.","L":["L2"],"words":[[0.105,0.434,"Lesson"],[0.553,0.355,"two"],[1.408,0.118,"the"],[1.539,0.303,"soul"],[1.855,0.395,"carries"],[2.263,0.697,"impressions"],[2.974,0.197,"from"],[3.184,0.316,"body"],[3.513,0.132,"to"],[3.658,0.513,"body"]]},{"s":"B","start":442.272,"end":449.592,"text":"As the wind carries a flower's fragrance, the soul carries the senses and mind from one body to the next.","L":["L2"],"words":[[0.092,0.158,"As"],[0.263,0.105,"the"],[0.382,0.355,"wind"],[0.75,0.434,"carries"],[1.197,0.066,"a"],[1.276,0.5,"flower's"],[1.789,0.632,"fragrance"],[3.013,0.092,"the"],[3.118,0.395,"soul"],[3.526,0.421,"carries"],[3.961,0.092,"the"],[4.066,0.605,"senses"],[4.684,0.184,"and"],[4.882,0.408,"mind"],[5.303,0.197,"from"],[5.513,0.224,"one"],[5.75,0.421,"body"],[6.197,0.118,"to"],[6.329,0.092,"the"],[6.434,0.487,"next"]]},{"s":"A","start":449.88,"end":458.4,"text":"The ignorant can't perceive it. Those with the eye of Self-knowledge can. That's how transmigration works, in the Gita's picture.","L":["L2"],"words":[[0.105,0.079,"The"],[0.197,0.539,"ignorant"],[0.75,0.263,"can't"],[1.026,0.447,"perceive"],[1.487,0.342,"it"],[2.263,0.263,"Those"],[2.539,0.145,"with"],[2.697,0.118,"the"],[2.829,0.224,"eye"],[3.066,0.118,"of"],[3.197,0.803,"Self-knowledge"],[4.013,0.474,"can"],[4.921,0.237,"That's"],[5.171,0.145,"how"],[5.329,1.092,"transmigration"],[6.434,0.447,"works"],[6.921,0.118,"in"],[7.053,0.092,"the"],[7.158,0.382,"Gita's"],[7.553,0.579,"picture"]]},{"s":"B","start":458.688,"end":466.56,"text":"And it means the habits we build now travel with us. Like a fragrance. Which is a good reason to choose them carefully.","L":[],"words":[[0.092,0.132,"And"],[0.237,0.105,"it"],[0.355,0.329,"means"],[0.697,0.105,"the"],[0.816,0.513,"habits"],[1.342,0.158,"we"],[1.513,0.342,"build"],[1.868,0.237,"now"],[2.118,0.474,"travel"],[2.605,0.211,"with"],[2.829,0.368,"us"],[3.605,0.145,"Like"],[3.763,0.066,"a"],[3.842,0.763,"fragrance"],[5.026,0.158,"Which"],[5.197,0.118,"is"],[5.329,0.092,"a"],[5.434,0.224,"good"],[5.671,0.434,"reason"],[6.118,0.132,"to"],[6.263,0.342,"choose"],[6.618,0.171,"them"],[6.803,0.671,"carefully"]]},{"s":"B","start":467.424,"end":472.488,"text":"Lesson three: God is the inner light and sustainer of all life.","L":["L3"],"words":[[0.079,0.368,"Lesson"],[0.461,0.513,"three"],[1.645,0.382,"God"],[2.039,0.184,"is"],[2.237,0.079,"the"],[2.329,0.316,"inner"],[2.658,0.382,"light"],[3.053,0.118,"and"],[3.184,0.658,"sustainer"],[3.855,0.118,"of"],[3.987,0.224,"all"],[4.224,0.461,"life"]]},{"s":"A","start":472.776,"end":482.16,"text":"The light of the sun, moon and fire is God's radiance. God holds up the earth, feeds the plants, and is the fire that digests our food.","L":["L3"],"words":[[0.092,0.092,"The"],[0.197,0.289,"light"],[0.5,0.118,"of"],[0.632,0.105,"the"],[0.75,0.447,"sun"],[1.461,0.224,"moon"],[1.697,0.132,"and"],[1.842,0.434,"fire"],[2.289,0.145,"is"],[2.447,0.382,"God's"],[2.842,0.75,"radiance"],[4.026,0.197,"God"],[4.237,0.342,"holds"],[4.592,0.145,"up"],[4.75,0.118,"the"],[4.882,0.368,"earth"],[5.553,0.329,"feeds"],[5.895,0.105,"the"],[6.013,0.553,"plants"],[6.842,0.145,"and"],[7.0,0.105,"is"],[7.118,0.118,"the"],[7.25,0.382,"fire"],[7.645,0.171,"that"],[7.829,0.553,"digests"],[8.395,0.132,"our"],[8.539,0.461,"food"]]},{"s":"B","start":482.448,"end":492.024,"text":"And God sits in every heart as memory, understanding, and the clearing of doubt. Every meal, every insight, is a small meeting.","L":["L3"],"words":[[0.092,0.132,"And"],[0.237,0.316,"God"],[0.566,0.421,"sits"],[1.0,0.237,"in"],[1.25,0.25,"every"],[1.513,0.355,"heart"],[1.882,0.158,"as"],[2.053,0.5,"memory"],[3.211,0.855,"understanding"],[4.579,0.092,"and"],[4.684,0.092,"the"],[4.789,0.526,"clearing"],[5.329,0.132,"of"],[5.474,0.434,"doubt"],[6.329,0.276,"Every"],[6.618,0.461,"meal"],[7.105,0.355,"every"],[7.474,0.539,"insight"],[8.039,0.145,"is"],[8.197,0.066,"a"],[8.276,0.395,"small"],[8.684,0.487,"meeting"]]},{"s":"A","start":492.312,"end":504.792,"text":"A tiny practice from this lesson: before eating, pause for one breath and remember that the fire inside isn't only ours. Many families recite fifteen point fourteen for exactly that reason.","L":[],"words":[[0.092,0.079,"A"],[0.184,0.355,"tiny"],[0.553,0.5,"practice"],[1.066,0.171,"from"],[1.25,0.211,"this"],[1.474,0.487,"lesson"],[2.316,0.395,"before"],[2.724,0.408,"eating"],[3.382,0.303,"pause"],[3.697,0.197,"for"],[3.908,0.237,"one"],[4.158,0.395,"breath"],[4.566,0.118,"and"],[4.697,0.526,"remember"],[5.237,0.158,"that"],[5.408,0.105,"the"],[5.526,0.408,"fire"],[5.947,0.5,"inside"],[6.461,0.303,"isn't"],[6.776,0.289,"only"],[7.079,0.553,"ours"],[8.053,0.276,"Many"],[8.342,0.526,"families"],[8.882,0.447,"recite"],[9.342,0.461,"fifteen"],[9.816,0.263,"point"],[10.092,0.526,"fourteen"],[10.632,0.171,"for"],[10.816,0.553,"exactly"],[11.382,0.237,"that"],[11.632,0.461,"reason"]]},{"s":"A","start":505.656,"end":511.2,"text":"And lesson four: three entities, the temporal, the eternal, and the Supreme.","L":["L4"],"words":[[0.105,0.145,"And"],[0.263,0.395,"lesson"],[0.671,0.395,"four"],[1.447,0.276,"three"],[1.737,0.579,"entities"],[2.355,0.105,"the"],[2.474,0.566,"temporal"],[3.316,0.105,"the"],[3.434,0.592,"eternal"],[4.25,0.092,"and"],[4.355,0.092,"the"],[4.461,0.684,"Supreme"]]},{"s":"B","start":511.488,"end":522.264,"text":"Created beings are temporal and always changing. The soul is eternal and unchanging. And the Supreme Being is beyond both, pervading and sustaining them.","L":["L4"],"words":[[0.092,0.434,"Created"],[0.539,0.421,"beings"],[0.974,0.158,"are"],[1.145,0.618,"temporal"],[1.789,0.158,"and"],[1.961,0.368,"always"],[2.342,0.645,"changing"],[3.395,0.066,"The"],[3.474,0.461,"soul"],[3.947,0.197,"is"],[4.158,0.645,"eternal"],[4.816,0.171,"and"],[5.0,0.842,"unchanging"],[6.263,0.118,"And"],[6.395,0.079,"the"],[6.487,0.526,"Supreme"],[7.026,0.342,"Being"],[7.382,0.211,"is"],[7.605,0.513,"beyond"],[8.132,0.447,"both"],[8.605,0.711,"pervading"],[9.329,0.145,"and"],[9.487,0.605,"sustaining"],[10.105,0.276,"them"]]},{"s":"A","start":522.552,"end":528.528,"text":"Knowing that is the most secret science, and Krishna says it completes the goal of human life.","L":["L4"],"words":[[0.092,0.382,"Knowing"],[0.487,0.171,"that"],[0.671,0.132,"is"],[0.816,0.092,"the"],[0.921,0.276,"most"],[1.211,0.434,"secret"],[1.658,0.632,"science"],[2.592,0.158,"and"],[2.763,0.447,"Krishna"],[3.224,0.237,"says"],[3.474,0.092,"it"],[3.579,0.526,"completes"],[4.118,0.118,"the"],[4.25,0.329,"goal"],[4.592,0.092,"of"],[4.697,0.382,"human"],[5.092,0.487,"life"]]},{"s":"B","start":528.816,"end":542.328,"text":"It's the answer to Arjuna's oldest worry, too. Everything he's afraid of losing belongs to the first entity, the changing one. What he really is belongs to the second. And the third holds them all.","L":[],"words":[[0.05,0.184,"It's"],[0.247,0.066,"the"],[0.326,0.474,"answer"],[0.813,0.145,"to"],[0.971,0.618,"Arjuna's"],[1.603,0.474,"oldest"],[2.089,0.461,"worry"],[2.8,0.408,"too"],[3.632,0.474,"Everything"],[4.118,0.237,"he's"],[4.368,0.487,"afraid"],[4.868,0.171,"of"],[5.053,0.447,"losing"],[5.513,0.553,"belongs"],[6.079,0.118,"to"],[6.211,0.118,"the"],[6.342,0.382,"first"],[6.737,0.5,"entity"],[7.263,0.105,"the"],[7.382,0.474,"changing"],[7.868,0.355,"one"],[8.645,0.132,"What"],[8.789,0.197,"he"],[9.0,0.447,"really"],[9.461,0.224,"is"],[9.697,0.553,"belongs"],[10.263,0.118,"to"],[10.395,0.105,"the"],[10.513,0.592,"second"],[11.5,0.118,"And"],[11.632,0.105,"the"],[11.75,0.342,"third"],[12.105,0.408,"holds"],[12.526,0.171,"them"],[12.711,0.421,"all"]]},{"s":"B","start":543.192,"end":556.776,"text":"So, Chapter Fifteen. Cut the roots of the upside-down tree, see the soul travel like fragrance on the wind, notice God in sunlight and in your own digestion, and know the Supreme beyond all.","L":["L1","L2","L3","L4"],"words":[[0.051,0.303,"So"],[0.38,0.487,"Chapter"],[0.88,0.684,"Fifteen"],[1.987,0.25,"Cut"],[2.25,0.079,"the"],[2.342,0.368,"roots"],[2.724,0.092,"of"],[2.829,0.105,"the"],[2.947,0.711,"upside-down"],[3.671,0.421,"tree"],[4.684,0.263,"see"],[4.961,0.092,"the"],[5.066,0.355,"soul"],[5.434,0.447,"travel"],[5.895,0.197,"like"],[6.105,0.553,"fragrance"],[6.671,0.092,"on"],[6.776,0.079,"the"],[6.868,0.447,"wind"],[7.908,0.421,"notice"],[8.342,0.276,"God"],[8.632,0.105,"in"],[8.75,0.618,"sunlight"],[9.395,0.118,"and"],[9.526,0.092,"in"],[9.632,0.184,"your"],[9.829,0.184,"own"],[10.026,0.763,"digestion"],[11.237,0.211,"and"],[11.461,0.25,"know"],[11.724,0.092,"the"],[11.829,0.592,"Supreme"],[12.434,0.382,"beyond"],[12.829,0.355,"all"]]},{"s":"A","start":557.064,"end":563.856,"text":"Four lessons: the upside-down tree, fragrance on the wind, the inner light, and beyond both.","L":["L1","L2","L3","L4"],"words":[[0.092,0.158,"Four"],[0.263,0.632,"lessons"],[1.303,0.118,"the"],[1.434,0.737,"upside-down"],[2.184,0.395,"tree"],[2.882,0.553,"fragrance"],[3.447,0.118,"on"],[3.579,0.092,"the"],[3.684,0.421,"wind"],[4.434,0.092,"the"],[4.539,0.316,"inner"],[4.868,0.382,"light"],[5.342,0.105,"and"],[5.461,0.447,"beyond"],[5.921,0.487,"both"]]},{"s":"B","start":564.144,"end":571.632,"text":"Next time, Chapter Sixteen: the divine and the demonic qualities. Thanks for listening to Shruti.","L":[],"words":[[0.092,0.329,"Next"],[0.434,0.447,"time"],[0.895,0.434,"Chapter"],[1.342,0.763,"Sixteen"],[2.684,0.158,"the"],[2.855,0.592,"divine"],[3.461,0.184,"and"],[3.658,0.105,"the"],[3.776,0.461,"demonic"],[4.25,0.711,"qualities"],[5.382,0.342,"Thanks"],[5.737,0.171,"for"],[5.921,0.447,"listening"],[6.382,0.118,"to"],[6.513,0.579,"Shruti"]]}]}