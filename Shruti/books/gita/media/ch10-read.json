n detail, Your yogic power and glory because I am not satiated by hearing Your nectar-like words.","start":125.472,"dur":43.2,"words":[[0.113,0.163,"O"],[0.287,0.575,"Krishna"],[1.15,0.125,"I"],[1.288,0.475,"believe"],[1.775,0.2,"all"],[1.988,0.163,"that"],[2.163,0.1,"You"],[2.275,0.163,"have"],[2.45,0.287,"told"],[2.75,0.138,"me"],[2.9,0.1,"to"],[3.013,0.138,"be"],[3.163,0.45,"true"],[3.987,0.138,"O"],[4.138,0.425,"Lord"],[4.85,0.362,"neither"],[5.225,0.125,"the"],[5.362,0.575,"celestial"],[5.95,0.7,"controllers"],[6.662,0.212,"nor"],[6.888,0.138,"the"],[7.037,0.487,"demons"],[7.537,0.287,"fully"],[7.838,0.637,"understand"],[8.488,0.113,"Your"],[8.613,0.312,"real"],[8.938,0.537,"nature"],[9.85,0.175,"O"],[10.037,0.575,"Creator"],[10.625,0.175,"and"],[10.812,0.3,"Lord"],[11.125,0.1,"of"],[11.238,0.163,"all"],[11.412,0.5,"beings"],[12.162,0.188,"God"],[12.363,0.125,"of"],[12.5,0.15,"all"],[12.662,0.575,"celestial"],[13.25,0.463,"rulers"],[13.95,0.438,"Supreme"],[14.4,0.512,"person"],[15.137,0.125,"and"],[15.275,0.237,"Lord"],[15.525,0.087,"of"],[15.625,0.075,"the"],[15.713,0.6,"universe"],[16.6,0.138,"You"],[16.75,0.35,"alone"],[17.113,0.15,"know"],[17.275,0.475,"Yourself"],[17.762,0.113,"by"],[17.887,0.688,"Yourself"],[18.975,0.588,"Therefore"],[19.837,0.138,"You"],[19.988,0.4,"alone"],[20.4,0.075,"are"],[20.488,0.3,"able"],[20.8,0.113,"to"],[20.925,0.312,"fully"],[21.25,0.562,"describe"],[21.825,0.188,"Your"],[22.025,0.225,"own"],[22.262,0.362,"divine"],[22.637,0.975,"manifestations"],[23.625,0.163,"by"],[23.8,0.225,"which"],[24.038,0.1,"You"],[24.15,0.412,"exist"],[24.575,0.6,"pervading"],[25.188,0.163,"all"],[25.363,0.087,"the"],[25.462,0.875,"universes"],[26.738,0.175,"How"],[26.925,0.188,"may"],[27.125,0.087,"I"],[27.225,0.237,"know"],[27.475,0.325,"You"],[27.975,0.075,"O"],[28.062,0.475,"Lord"],[28.775,0.138,"by"],[28.925,0.55,"constant"],[29.488,0.938,"contemplation"],[30.8,0.15,"In"],[30.962,0.237,"what"],[31.212,0.325,"form"],[31.55,0.113,"of"],[31.675,0.9,