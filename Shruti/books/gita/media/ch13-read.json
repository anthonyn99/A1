arma is the cause of birth of living entity (jiva) in good and evil wombs.","start":227.952,"dur":42.984,"words":[[0.1,0.212,"Know"],[0.375,0.15,"that"],[0.575,0.275,"both"],[0.9,0.1,"the"],[1.012,0.55,"material"],[1.562,0.438,"Nature"],[2.15,0.35,"and"],[2.513,0.125,"the"],[2.638,0.55,"Spiritual"],[3.2,0.263,"Being"],[3.538,0.05,"are"],[3.675,0.575,"beginningless"],[5.338,0.188,"All"],[5.525,0.912,"manifestations"],[6.463,0.2,"and"],[6.7,0.25,"three"],[7.025,0.312,"states"],[7.362,0.087,"of"],[7.5,0.312,"mind"],[7.85,0.05,"and"],[7.938,0.4,"matter"],[8.7,0.3,"called"],[9.062,0.338,"modes"],[9.463,0.113,"or"],[9.637,0.525,"Gunas"],[10.45,0.1,"are"],[10.65,0.237,"born"],[10.912,0.075,"of"],[11.037,0.525,"Prakriti"],[12.562,0.562,"Prakriti"],[13.3,0.25,"is"],[13.562,0.212,"said"],[13.775,0.125,"to"],[13.9,0.113,"be"],[14.075,0.062,"the"],[14.15,0.3,"cause"],[14.463,0.1,"of"],[14.588,0.562,"production"],[15.275,0.188,"of"],[15.475,0.113,"the"],[15.6,0.4,"physical"],[16.012,0.312,"body"],[16.462,0.225,"and"],[16.688,0.087,"the"],[16.837,0.312,"eleven"],[17.2,0.425,"organs"],[17.637,0.113,"of"],[17.788,0.525,"perception"],[18.438,0.188,"and"],[18.663,0.438,"action"],[20.1,0.45,"Purusha"],[20.738,0.738,"Consciousness"],[21.7,0.537,"Spirit"],[22.525,0.338,"is"],[22.875,0.212,"said"],[23.087,0.125,"to"],[23.212,0.1,"be"],[23.363,0.075,"the"],[23.45,0.3,"cause"],[23.762,0.1,"of"],[23.887,0.738,"experiencing"],[24.675,0.35,"pleasure"],[25.087,0.175,"and"],[25.325,0.35,"pain"],[26.637,0.463,"Purusha"],[27.125,0.487,"enjoys"],[27.7,0.237,"three"],[28.012,0.312,"modes"],[28.35,0.087,"of"],[28.462,0.537,"material"],[29.0,0.4,"Nature"],[29.65,0.65,"Prakriti"],[30.725,0.125,"by"],[30.95,0.713,"associating"],[31.712,0.125,"with"],[31.875,0.537,"Prakriti"],[33.425,0.625,"Attachment"],[34.112,0.113,"to"],[34.225,0.087,"the"],[34.325,0.5,"Gunas"],[34.888,0.25,"due"],[35.15,0.087,"to"],[35.263,0.425,"ignorance"],[35.788,0.412,"caused"],[36.3,0.087,"by"],[36.462,0.45,"previous"],[36.925,