,0.237,"Some"],[22.15,0.388,"perceive"],[22.55,0.125,"the"],[22.675,0.613,"supersoul"],[23.35,0.15,"in"],[23.512,0.138,"their"],[23.712,0.225,"inner"],[23.962,0.375,"psyche"],[24.438,0.175,"through"],[24.613,0.325,"mind"],[24.988,0.087,"and"],[25.113,0.525,"intellect"],[25.812,0.212,"that"],[26.038,0.1,"have"],[26.137,0.15,"been"],[26.325,0.613,"purified"],[27.012,0.338,"either"],[27.363,0.125,"by"],[27.55,0.637,"meditation"],[28.425,0.338,"or"],[28.8,0.113,"by"],[28.988,0.613,"metaphysical"],[29.6,0.35,"knowledge"],[30.125,0.188,"or"],[30.413,0.1,"by"],[30.587,0.662,"Karma-yoga"]]},{"b":10,"part":0,"text":"The faith alone can lead to Nirvana","start":303.24,"dur":3.192,"words":[[0.1,0.087,"The"],[0.212,0.25,"faith"],[0.5,0.35,"alone"],[0.975,0.2,"can"],[1.225,0.263,"lead"],[1.512,0.138,"to"],[1.663,0.512,"Nirvana"]]},{"b":11,"part":0,"text":"Others, however, do not know the yoga of meditation, knowledge, and work; but they perform deity worship with faith, as mentioned in the scriptures by the saints and sages. They also transcend death by virtue of their firm faith in what they have heard. Whatever is born, animate or inanimate, know them to be born from the union of the matter and Spirit, O Arjuna.","start":306.432,"dur":24.84,"words":[[0.1,0.3,"Others"],[0.537,0.463,"however"],[1.275,0.287,"do"],[1.575,0.2,"not"],[1.788,0.163,"know"],[2.013,0.062,"the"],[2.087,0.325,"yoga"],[2.438,0.075,"of"],[2.55,0.637,"meditation"],[3.375,0.438,"knowledge"],[4.0,0.138,"and"],[4.188,0.338,"work"],[4.862,0.188,"but"],[5.05,0.113,"they"],[5.213,0.375,"perform"],[5.625,0.375,"deity"],[6.05,0.4,"worship"],[6.5,0.125,"with"],[6.65,0.35,"faith"],[7.388,0.163,"as"],[7.562,0.45,"mentioned"],[8.025,0.087,"in"],[8.125,0.113,"the"],[8.238,0.525,"scriptures"],[8.887,0.175,"by"],[9.125,0.087,"the"],[9.213,0.338,"saints"],[9.588,0.113,"and"],[9.75,0.487,"sages"],[11.25,0.075,"They"],[11.4,0.35,"also"],[11.8,0.575,"transcend"],[12.4,0.275,"death"],[12.863,0.113,"by"],[13.05,0.438,"virtue"],[