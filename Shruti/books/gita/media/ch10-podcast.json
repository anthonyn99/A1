,0.588,"Arjuna"],[6.463,0.225,"among"],[6.7,0.075,"the"],[6.787,0.6,"sages"],[7.412,0.425,"Vyasa"],[8.225,0.362,"So"],[8.6,0.487,"Arjuna"],[9.1,0.637,"himself"],[9.825,0.125,"is"],[9.963,0.113,"on"],[10.088,0.062,"the"],[10.15,0.463,"list"],[11.012,0.275,"And"],[11.412,0.287,"ten"],[11.713,0.3,"point"],[12.025,0.512,"thirty-eight"],[13.2,0.188,"I"],[13.4,0.175,"am"],[13.575,0.75,"silence"],[14.463,0.237,"among"],[14.713,0.075,"the"],[14.8,0.662,"secrets"]]},{"s":"B","start":316.584,"end":334.656,"text":"And the conclusion, which is breathtaking. Ten point forty and forty-one: there is no end to My divine manifestations. Whatever is endowed with glory, brilliance and power, know that to be a manifestation of a very small fraction of My splendor.","L":["L5"],"words":[[0.1,0.087,"And"],[0.2,0.075,"the"],[0.287,0.8,"conclusion"],[1.3,0.163,"which"],[1.462,0.1,"is"],[1.562,0.85,"breathtaking"],[2.812,0.237,"Ten"],[3.05,0.275,"point"],[3.325,0.625,"forty"],[4.025,0.125,"and"],[4.162,0.7,"forty-one"],[5.312,0.15,"there"],[5.463,0.113,"is"],[5.575,0.4,"no"],[6.088,0.325,"end"],[6.425,0.087,"to"],[6.513,0.2,"My"],[6.725,0.613,"divine"],[7.35,1.15,"manifestations"],[8.9,0.412,"Whatever"],[9.312,0.15,"is"],[9.475,0.675,"endowed"],[10.15,0.175,"with"],[10.338,0.637,"glory"],[11.213,0.762,"brilliance"],[12.1,0.125,"and"],[12.225,0.6,"power"],[13.287,0.212,"know"],[13.5,0.113,"that"],[13.625,0.075,"to"],[13.7,0.163,"be"],[13.875,0.025,"a"],[13.9,1.038,"manifestation"],[15.0,0.075,"of"],[15.075,0.075,"a"],[15.162,0.412,"very"],[15.575,0.35,"small"],[15.925,0.713,"fraction"],[16.887,0.087,"of"],[16.975,0.138,"My"],[17.113,0.6,"splendor"]]},{"s":"A","start":334.944,"end":344.832,"text":"And ten point forty-two: what is the need for all this detail, Arjuna? I support the entire universe by a small fraction of My divine power.","L":["L5"],"words":[[0.087,0.287,"And"],[0.475,0.287,"ten"],[0.775,0.25,"point"],[1.038,0.537,"forty-two"],[2.15,0.1,"what"],[2.263,0.1,"is"],[2.375,0.062,"the"],[2.45,0.312,"need"],[2.775,0.212,"for"],[3.0,0.15,"all"],[3.163,0.175,"this"],[3.35,0.512,"detail"],[3.875,0.525,"Arjuna"],[4.875,0.1,"I"],[4.987,0.438,"support"],[5.438,0.05,"the"],[5.5,0.475,"entire"],[5.987,0.575,"universe"],[6.775,0.125,"by"],[6.912,0.062,"a"],[6.987,0.438,"small"],[7.438,0.6,"fraction"],[8.262,0.138,"of"],[8.412,0.188,"My"],[8.613,0.438,"divine"],[9.062,0.487,"power"]]},{"s":"B","start":345.12,"end":353.784,"text":"The whole universe, all of it, is a small fraction. Which sets up Chapter Eleven, where Arjuna asks to see it for himself.","L":[],"words":[[0.113,0.062,"The"],[0.175,0.312,"whole"],[0.487,0.738,"universe"],[1.438,0.263,"all"],[1.712,0.113,"of"],[1.825,0.15,"it"],[2.413,0.087,"is"],[2.5,0.05,"a"],[2.55,0.362,"small"],[2.925,0.6,"fraction"],[3.938,0.113,"Which"],[4.062,0.2,"sets"],[4.275,0.15,"up"],[4.438,0.475,"Chapter"],[4.925,0.388,"Eleven"],[5.725,0.125,"where"],[5.85,0.562,"Arjuna"],[6.588,0.35,"asks"],[6.938,0.1,"to"],[7.05,0.312,"see"],[7.362,0.125,"it"],[7.5,0.15,"for"],[7.65,0.65,"himself"]]},{"s":"A","start":354.648,"end":361.2,"text":"Lesson one: God is the origin of all, including all the qualities in human beings.","L":["L1"],"words":[[0.087,0.388,"Lesson"],[0.487,0.263,"one"],[1.3,0.35,"God"],[1.712,0.125,"is"],[1.837,0.138,"the"],[2.038,0.463,"origin"],[2.513,0.1,"of"],[2.625,0.35,"all"],[3.425,0.575,"including"],[4.075,0.163,"all"],[4.25,0.087,"the"],[4.35,0.662,"qualities"],[5.025,0.188,"in"],[5.225,0.362,"human"],[5.588,0.613,"beings"]]},{"s":"B","start":361.488,"end":373.416,"text":"Intelligence, forgiveness, truthfulness, fearlessness, nonviolence, contentment, even fame and suffering: every quality that shows up in us comes from God.","L":["L1"],"words":[[0.1,0.887,"Intelligence"],[1.062,0.95,"forgiveness"],[2.2,0.875,"truthfulness"],[3.3,0.875,"fearlessness"],[4.438,0.975,"nonviolence"],[5.562,0.65,"contentment"],[6.6,0.275,"even"],[6.875,0.562,"fame"],[7.662,0.113,"and"],[7.775,0.625,"suffering"],[8.95,0.312,"every"],[9.275,0.512,"quality"],[9.8,0.1,"that"],[9.912,0.388,"shows"],[10.3,0.175,"up"],[10.488,0.087,"in"],[10.588,0.175,"us"],[10.762,0.263,"comes"],[11.025,0.15,"from"],[11.175,0.375,"God"]]},{"s":"A","start":373.704,"end":380.088,"text":"Seeing that deepens devotion and dissolves ego. Your gifts aren't trophies. They're on loan.","L":["L1"],"words":[[0.087,0.338,"Seeing"],[0.425,0.188,"that"],[0.625,0.45,"deepens"],[1.075,0.637,"devotion"],[1.788,0.125,"and"],[1.925,0.525,"dissolves"],[2.513,0.487,"ego"],[3.362,0.175,"Your"],[3.55,0.325,"gifts"],[3.888,0.275,"aren't"],[4.162,0.7,"trophies"],[5.25,0.138,"They're"],[5.388,0.15,"on"],[5.537,0.475,"loan"]]},{"s":"B","start":380.952,"end":387.192,"text":"Lesson two: understanding God's manifestations leads to unwavering devotion.","L":["L2"],"words":[[0.087,0.388,"Lesson"],[0.487,0.475,"two"],[1.5,0.688,"understanding"],[2.188,0.388,"God's"],[2.587,1.075,"manifestations"],[3.862,0.3,"leads"],[4.162,0.237,"to"],[4.475,0.8,"unwavering"],[5.287,0.6,"devotion"]]},{"s":"A","start":387.48,"end":393.624,"text":"Those who truly see God's glory in the world become united with Him through steady love.","L":["L2"],"words":[[0.1,0.325,"Those"],[0.438,0.138,"who"],[0.588,0.487,"truly"],[1.087,0.237,"see"],[1.337,0.312,"God's"],[1.663,0.537,"glory"],[2.212,0.1,"in"],[2.325,0.1,"the"],[2.438,0.35,"world"],[2.8,0.412,"become"],[3.475,0.575,"united"],[4.05,0.125,"with"],[4.188,0.325,"Him"],[4.688,0.188,"through"],[4.888,0.388,"steady"],[5.287,0.487,"love"]]},{"s":"B","start":393.912,"end":401.352,"text":"This isn't only intellectual knowledge. It fuels love and commitment, and people who share it light each other up.","L":["L2"],"words":[[0.1,0.125,"This"],[0.237,0.237,"isn't"],[0.575,0.375,"only"],[0.963,0.613,"intellectual"],[1.575,0.625,"knowledge"],[2.6,0.087,"It"],[2.7,0.5,"fuels"],[3.212,0.575,"love"],[3.9,0.125,"and"],[4.037,0.55,"commitment"],[5.0,0.087,"and"],[5.1,0.3,"people"],[5.4,0.087,"who"],[5.5,0.325,"share"],[5.825,0.087,"it"],[5.912,0.312,"light"],[6.438,0.175,"each"],[6.625,0.237,"other"],[6.862,0.225,"up"]]},{"s":"A","start":402.216,"end":407.208,"text":"Lesson three: God gives inner spiritual knowledge to devoted seekers.","L":["L3"],"words":[[0.087,0.425,"Lesson"],[0.525,0.388,"three"],[1.512,0.312,"God"],[1.837,0.25,"gives"],[2.15,0.25,"inner"],[2.413,0.55,"spiritual"],[2.975,0.512,"knowledge"],[3.5,0.1,"to"],[3.6,0.412,"devoted"],[4.025,0.6,"seekers"]]},{"s":"B","start":407.496,"end":418.32,"text":"To those who love and worship constantly, God gives the understanding by which they come to Him, lighting a lamp of knowledge inside their own consciousness.","L":["L3"],"words":[[0.087,0.075,"To"],[0.163,0.325,"those"],[0.487,0.138,"who"],[0.637,0.562,"love"],[1.337,0.125,"and"],[1.462,0.613,"worship"],[2.075,0.738,"constantly"],[3.263,0.412,"God"],[3.825,0.25,"gives"],[4.075,0.125,"the"],[4.25,0.713,"understanding"],[4.963,0.163,"by"],[5.138,0.2,"which"],[5.338,0.163,"they"],[5.5,0.263,"come"],[5.775,0.125,"to"],[5.912,0.275,"Him"],[6.775,0.325,"lighting"],[7.112,0.062,"a"],[7.188,0.4,"lamp"],[7.6,0.087,"of"],[7.7,0.662,"knowledge"],[8.488,0.713,"inside"],[9.213,0.15,"their"],[9.363,0.263,"own"],[9.625,0.85,"consciousness"]]},{"s":"A","start":418.608,"end":424.728,"text":"God isn't a distant examiner. God is an active guide for anyone who sincerely seeks.","L":["L3"],"words":[[0.1,0.263,"God"],[0.463,0.287,"isn't"],[0.825,0.138,"a"],[0.975,0.375,"distant"],[1.35,0.6,"examiner"],[2.337,0.35,"God"],[2.75,0.138,"is"],[2.9,0.113,"an"],[3.025,0.325,"active"],[3.35,0.338,"guide"],[3.7,0.175,"for"],[3.938,0.388,"anyone"],[4.338,0.2,"who"],[4.55,0.637,"sincerely"],[5.2,0.537,"seeks"]]},{"s":"B","start":425.592,"end":429.504,"text":"Lesson four: no one can fully know God's real nature.","L":["L4"],"words":[[0.1,0.287,"Lesson"],[0.388,0.362,"four"],[1.312,0.175,"no"],[1.488,0.125,"one"],[1.613,0.113,"can"],[1.725,0.4,"fully"],[2.125,0.263,"know"],[2.388,0.4,"God's"],[2.788,0.263,"real"],[3.05,0.5,"nature"]]},{"s":"A","start":429.792,"end":435.912,"text":"Not the gods, not the great sages. Only God knows God, by Himself.","L":["L4"],"words":[[0.062,0.237,"Not"],[0.3,0.075,"the"],[0.388,0.562,"gods"],[1.137,0.3,"not"],[1.45,0.075,"the"],[1.538,0.275,"great"],[1.825,0.688,"sages"],[2.9,0.275,"Only"],[3.188,0.4,"God"],[3.725,0.325,"knows"],[4.062,0.425,"God"],[4.912,0.15,"by"],[5.062,0.688,"Himself"]]},{"s":"B","start":436.2,"end":443.736,"text":"That calls for humility. The infinite can't be fully held by a finite mind. It can be approached, and loved.","L":["L4"],"words":[[0.1,0.125,"That"],[0.225,0.375,"calls"],[0.6,0.138,"for"],[0.738,0.7,"humility"],[1.837,0.1,"The"],[1.95,0.45,"infinite"],[2.4,0.287,"can't"],[2.7,0.113,"be"],[2.812,0.45,"fully"],[3.263,0.45,"held"],[3.888,0.175,"by"],[4.062,0.05,"a"],[4.125,0.562,"finite"],[4.688,0.425,"mind"],[5.513,0.062,"It"],[5.575,0.062,"can"],[5.638,0.113,"be"],[5.75,0.637,"approached"],[6.588,0.163,"and"],[6.75,0.412,"loved"]]},{"s":"A","start":444.6,"end":450.384,"text":"And lesson five: whatever has glory, brilliance or power is a fragment of God.","L":["L5"],"words":[[0.1,0.175,"And"],[0.287,0.312,"lesson"],[0.613,0.362,"five"],[1.462,0.325,"whatever"],[1.8,0.188,"has"],[2.0,0.55,"glory"],[2.8,0.65,"brilliance"],[3.5,0.175,"or"],[3.688,0.512,"power"],[4.213,0.113,"is"],[4.338,0.062,"a"],[4.412,0.512,"fragment"],[4.925,0.087,"of"],[5.025,0.4,"God"]]},{"s":"B","start":450.672,"end":463.92,"text":"Light, strength, beauty, wisdom, courage, the ocean, the Himalaya, the spring: each is a tiny piece of God's splendor. And the whole universe is held up by a small portion of His power.","L":["L5"],"words":[[0.1,0.287,"Light"],[0.625,0.625,"strength"],[1.538,0.525,"beauty"],[2.288,0.625,"wisdom"],[3.337,0.425,"courage"],[3.825,0.125,"the"],[3.962,0.425,"ocean"],[4.388,0.075,"the"],[4.463,0.7,"Himalaya"],[5.375,0.075,"the"],[5.45,0.525,"spring"],[6.537,0.225,"each"],[6.775,0.113,"is"],[6.888,0.05,"a"],[6.938,0.5,"tiny"],[7.438,0.45,"piece"],[7.888,0.125,"of"],[8.012,0.375,"God's"],[8.4,0.65,"splendor"],[9.463,0.075,"And"],[9.55,0.075,"the"],[9.637,0.275,"whole"],[9.925,0.55,"universe"],[10.537,0.138,"is"],[10.675,0.275,"held"],[10.963,0.225,"up"],[11.188,0.125,"by"],[11.325,0.05,"a"],[11.375,0.362,"small"],[11.738,0.5,"portion"],[12.238,0.062,"of"],[12.3,0.113,"His"],[12.425,0.463,"power"]]},{"s":"A","start":464.208,"end":470.976,"text":"Recognizing that changes how you see the world. Every time something takes your breath away, that's a glimpse.","L":["L5"],"words":[[0.05,0.713,"Recognizing"],[0.775,0.175,"that"],[0.95,0.475,"changes"],[1.438,0.163,"how"],[1.6,0.125,"you"],[1.738,0.25,"see"],[2.0,0.113,"the"],[2.125,0.5,"world"],[3.025,0.237,"Every"],[3.275,0.287,"time"],[3.575,0.4,"something"],[3.987,0.325,"takes"],[4.325,0.087,"your"],[4.425,0.225,"breath"],[4.662,0.425,"away"],[5.537,0.225,"that's"],[5.763,0.062,"a"],[5.838,0.562,"glimpse"]]},{"s":"B","start":471.84,"end":486.696,"text":"So, Chapter Ten. Arjuna asks where to find God, and Krishna answers: wherever there's glory, brilliance or power, in the sun, the mountains, the good, even in you. And all of it is just a fraction.","L":["L1","L5"],"words":[[0.1,0.212,"So"],[0.325,0.4,"Chapter"],[0.738,0.35,"Ten"],[1.488,0.575,"Arjuna"],[2.075,0.463,"asks"],[2.55,0.087,"where"],[2.65,0.062,"to"],[2.725,0.412,"find"],[3.15,0.425,"God"],[3.975,0.1,"and"],[4.075,0.388,"Krishna"],[4.475,0.575,"answers"],[5.487,0.4,"wherever"],[5.888,0.212,"there's"],[6.112,0.637,"glory"],[7.037,0.75,"brilliance"],[7.875,0.15,"or"],[8.037,0.6,"power"],[8.925,0.05,"in"],[8.988,0.075,"the"],[9.062,0.463,"sun"],[9.975,0.075,"the"],[10.05,0.762,"mountains"],[10.988,0.125,"the"],[11.125,0.35,"good"],[11.988,0.225,"even"],[12.213,0.15,"in"],[12.363,0.312,"you"],[13.075,0.125,"And"],[13.2,0.212,"all"],[13.412,0.075,"of"],[13.488,0.062,"it"],[13.55,0.113,"is"],[13.662,0.188,"just"],[13.85,0.025,"a"],[13.875,0.613,"fraction"]]},{"s":"A","start":486.984,"end":497.088,"text":"Five lessons: every quality from one source, seeing leads to loving, the lamp within, beyond full knowing, and a fragment of splendor.","L":["L1","L2","L3","L4","L5"],"words":[[0.163,0.275,"Five"],[0.45,0.6,"lessons"],[1.663,0.287,"every"],[1.962,0.463,"quality"],[2.438,0.212,"from"],[2.65,0.212,"one"],[2.875,0.475,"source"],[3.737,0.325,"seeing"],[4.075,0.275,"leads"],[4.362,0.113,"to"],[4.487,0.425,"loving"],[5.338,0.1,"the"],[5.45,0.338,"lamp"],[5.787,0.425,"within"],[6.588,0.475,"beyond"],[7.062,0.3,"full"],[7.375,0.475,"knowing"],[8.238,0.163,"and"],[8.4,0.037,"a"],[8.45,0.588,"fragment"],[9.05,0.075,"of"],[9.125,0.613,"splendor"]]},{"s":"B","start":497.376,"end":504.264,"text":"Next time, Chapter Eleven: Arjuna asks to see the cosmic form. Thanks for listening to Shruti.","L":[],"words":[[0.087,0.188,"Next"],[0.275,0.362,"time"],[0.925,0.388,"Chapter"],[1.312,0.375,"Eleven"],[2.188,0.588,"Arjuna"],[2.875,0.312,"asks"],[3.188,0.075,"to"],[3.263,0.325,"see"],[3.587,0.1,"the"],[3.7,0.463,"cosmic"],[4.162,0.388,"form"],[4.975,0.163,"Thanks"],[5.138,0.125,"for"],[5.275,0.525,"listening"],[5.912,0.087,"to"],[6.0,0.512,"Shruti"]]}]}