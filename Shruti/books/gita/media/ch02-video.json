"],[0.212,0.325,"now"],[0.55,0.087,"the"],[0.65,0.312,"most"],[0.975,0.438,"famous"],[1.425,0.362,"verse"],[1.8,0.125,"of"],[1.938,0.087,"the"],[2.038,0.475,"Gita"],[2.9,0.388,"Verse"],[3.3,0.838,"forty-seven"],[4.525,0.075,"You"],[4.612,0.163,"have"],[4.787,0.562,"control"],[5.375,0.25,"over"],[5.638,0.15,"your"],[5.8,0.512,"respective"],[6.325,0.35,"duty"],[6.688,0.475,"only"],[7.588,0.225,"but"],[7.825,0.2,"no"],[8.037,0.575,"control"],[8.625,0.15,"or"],[8.787,0.4,"claim"],[9.213,0.225,"over"],[9.45,0.087,"the"],[9.55,0.562,"results"],[10.5,0.075,"The"],[10.588,0.325,"fruits"],[10.925,0.125,"of"],[11.062,0.3,"work"],[11.375,0.225,"should"],[11.613,0.275,"not"],[11.9,0.138,"be"],[12.05,0.2,"your"],[12.262,0.275,"only"],[12.55,0.525,"motive"],[13.113,0.138,"and"],[13.262,0.087,"you"],[13.363,0.212,"should"],[13.588,0.3,"never"],[13.9,0.138,"be"],[14.05,0.65,"inactive"]]},{"layout":"verse","headline":"","visual":[],"L":["L7"],"ref":"2.48","verse":"Do your duty to the best of your ability, O Arjuna, with your mind attached to the Lord, abandoning worry and attachment to the results, and remaining calm in both success and failure. The calmness of mind is called Karma-yoga.","key":true,"vs":[8,48],"say":"Krishna gives this calm a name. Verse forty-eight. Do your duty to the best of your ability, O Arjuna, with your mind attached to the Lord, abandoning worry and attachment to the results, and remaining calm in both success and failure. The calmness of mind is called Karma-yoga.","start":157.704,"at":158.28,"end":177.504,"words":[[0.062,0.4,"Krishna"],[0.475,0.25,"gives"],[0.738,0.2,"this"],[0.95,0.35,"calm"],[1.312,0.05,"a"],[1.375,0.463,"name"],[2.225,0.338,"Verse"],[2.575,0.7,"forty-eight"],[3.675,0.062,"Do"],[3.75,0.125,"your"],[3.888,0.338,"duty"],[4.237,0.113,"to"],[4.362,0.1,"the"],[4.475,0.287,"best"],[4.775,0.062,"of"],[4.85,0.15,"your"],[5.013,0.55,"ability"],[5.925,0.188,"O"],[6.125,0.613,"Arjuna"],[6.975,0.175,"with"],[7.162,0.113,"your"],[7.287,0.312,"mind"