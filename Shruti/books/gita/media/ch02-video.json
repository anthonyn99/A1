5,0.225,"this"],[14.475,0.525,"evenness"],[15.012,0.15,"of"],[15.175,0.338,"mind"],[15.525,0.475,"yoga"]]},{"layout":"compare","headline":"Running away is not compassion","visual":["What Arjuna thought | What Krishna showed","Avoiding the battle is kind | Doing what is right is kind","Pity for those in front of him | Care for justice and the world","Comfort now | Courage now, peace later"],"L":["L8"],"say":"Lesson eight. There is a difference between running away and true compassion. Arjuna believed that avoiding the battle was kindness. Krishna shows that real compassion includes doing what is right and just, even when it hurts. Turning away from your duty is not mercy. It is fear wearing mercy's clothes.","start":373.152,"at":373.728,"end":393.984,"words":[[0.062,0.362,"Lesson"],[0.438,0.325,"eight"],[1.137,0.15,"There"],[1.3,0.138,"is"],[1.45,0.087,"a"],[1.55,0.5,"difference"],[2.062,0.438,"between"],[2.513,0.312,"running"],[2.837,0.463,"away"],[3.312,0.15,"and"],[3.475,0.237,"true"],[3.725,0.7,"compassion"],[4.825,0.475,"Arjuna"],[5.312,0.6,"believed"],[5.925,0.25,"that"],[6.2,0.562,"avoiding"],[6.775,0.087,"the"],[6.875,0.35,"battle"],[7.237,0.175,"was"],[7.425,0.662,"kindness"],[8.488,0.362,"Krishna"],[8.863,0.425,"shows"],[9.3,0.225,"that"],[9.537,0.225,"real"],[9.775,0.562,"compassion"],[10.35,0.5,"includes"],[10.863,0.325,"doing"],[11.2,0.138,"what"],[11.35,0.138,"is"],[11.5,0.362,"right"],[11.887,0.125,"and"],[12.025,0.35,"just"],[12.725,0.312,"even"],[13.05,0.15,"when"],[13.213,0.075,"it"],[13.3,0.5,"hurts"],[14.188,0.3,"Turning"],[14.5,0.325,"away"],[14.838,0.188,"from"],[15.037,0.125,"your"],[15.175,0.45,"duty"],[15.637,0.175,"is"],[15.825,0.287,"not"],[16.125,0.537,"mercy"],[17.025,0.125,"It"],[17.163,0.138,"is"],[17.312,0.388,"fear"],[17.712,0.35,"wearing"],[18.075,0.412,"mercy's"],[18.5,0.525,"clothes"]]},{"layout":"lesson","headline":"Understanding Changes Everything","visual":["Arjuna's whole view of the battle shifts","Not killing, but a role in a larger order","Knowing the truth changes how you act"],"L":["L9"],"say":"Lesson nine. Understanding changes everything. Nothing on the battlefield has changed, yet once Arjuna understands the eternal Self, the battle means something else entirely. It is no longer about killing; it is about his part in a larger order. When you see the real nature of a situation, your response changes with it.","start":393.984,"at":394.56,"end":416.424,"words":[[0.062,0.3,"Lesson"],[0.375,0.412,"nine"],[1.188,0.713,"Understanding"],[1.913,0.562,"changes"],[2.487,0.637,"everything"],[3.525,0.388,"Nothing"],[3.925,0.1,"on"],[4.037,0.075,"the"],[4.125,0.575,"battlefield"],[4.713,0.175,"has"],[4.9,0.662,"changed"],[5.95,0.25,"yet"],[6.213,0.325,"once"],[6.55,0.525,"Arjuna"],[7.088,0.662,"understands"],[7.763,0.062,"the"],[7.838,0.375,"eternal"],[8.225,0.525,"Self"],[9.025,0.125,"the"],[9.162,0.325,"battle"],[9.5,0.275,"means"],[9.787,0.362,"something"],[10.162,0.275,"else"],[10.45,0.725,"entirely"],[11.537,0.087,"It"],[11.637,0.125,"is"],[11.775,0.175,"no"],[11.963,0.375,"longer"],[12.35,0.3,"about"],[12.662,0.487,"killing"],[13.7,0.15,"it"],[13.863,0.138,"is"],[14.012,0.263,"about"],[14.287,0.2,"his"],[14.5,0.362,"part"],[14.875,0.125,"in"],[15.012,0.062,"a"],[15.088,0.425,"larger"],[15.525,0.438,"order"],[16.375,0.138,"When"],[16.525,0.087,"you"],[16.625,0.3,"see"],[16.938,0.1,"the"],[17.05,0.325,"real"],[17.387,0.475,"nature"],[17.875,0.087,"of"],[17.975,0.05,"a"],[18.038,0.8,"situation"],[18.863,0.237,"your"],[19.113,0.55,"response"],[19.675,0.475,"changes"],[20.163,0.188,"with"],[20.363,0.263,"it"]]},{"layout":"lesson","headline":"Peace Comes From Alignment With Truth and Duty","visual":["Aligned with what is true","Aligned with your duty and role","Aligned with your values and integrity"],"L":["L10"],"say":"Lesson ten. Peace comes from alignment with truth and duty. When what you do agrees with what is true, with your role, and with your values, you can be at peace even in the middle of difficulty. Like rivers entering a full ocean, desires come and go, and the ocean stays calm.","start":416.424,"at":417.0,"end":435.312,"words":[[0.062,0.338,"Lesson"],[0.412,0.4,"ten"],[1.2,0.275,"Peace"],[1.488,0.338,"comes"],[1.837,0.2,"from"],[2.05,0.613,"alignment"],[2.675,0.163,"with"],[2.85,0.425,"truth"],[3.288,0.125,"and"],[3.425,0.45,"duty"],[4.275,0.175,"When"],[4.463,0.163,"what"],[4.638,0.1,"you"],[4.75,0.175,"do"],[4.938,0.487,"agrees"],[5.438,0.15,"with"],[5.6,0.163,"what"],[5.775,0.125,"is"],[5.912,0.425,"true"],[6.362,0.163,"with"],[6.537,0.163,"your"],[6.713,0.438,"role"],[7.412,0.212,"and"],[7.638,0.15,"with"],[7.8,0.125,"your"],[7.938,0.537,"values"],[8.5,0.125,"you"],[8.637,0.15,"can"],[8.8,0.138,"be"],[8.95,0.125,"at"],[9.088,0.362,"peace"],[9.475,0.287,"even"],[9.775,0.1,"in"],[9.887,0.075,"the"],[9.975,0.275,"middle"],[10.262,0.1,"of"],[10.375,0.662,"difficulty"],[11.425,0.188,"Like"],[11.625,0.45,"rivers"],[12.088,0.35,"entering"],[12.45,0.062,"a"],[12.525,0.325,"full"],[12.863,0.4,"ocean"],[13.8,0.575,"desires"],[14.387,0.263,"come"],[14.662,0.113,"and"],[14.787,0.362,"go"],[15.65,0.113,"and"],[15.775,0.087,"the"],[15.875,0.388,"ocean"],[16.275,0.35,"stays"],[16.637,0.45,"calm"]]},{"layout":"lesson","headline":"You Are Not Responsible for Things Beyond Your Control","visual":["You own your effort and intention","You do not own outcomes","Do your part; let the rest go"],"L":["L11"],"say":"Lesson eleven. You are not responsible for things beyond your control. This lifts an impossible weight. Your part is your effort and your intention. The outcome belongs to something larger than you. Do your part well, and let the universe handle the rest.","start":435.312,"at":435.888,"end":452.928,"words":[[0.062,0.338,"Lesson"],[0.412,0.588,"eleven"],[1.387,0.138,"You"],[1.538,0.087,"are"],[1.637,0.312,"not"],[1.962,0.688,"responsible"],[2.663,0.175,"for"],[2.85,0.35,"things"],[3.212,0.375,"beyond"],[3.6,0.125,"your"],[3.737,0.6,"control"],[4.713,0.212,"This"],[4.938,0.438,"lifts"],[5.4,0.138,"an"],[5.55,0.637,"impossible"],[6.2,0.388,"weight"],[6.975,0.138,"Your"],[7.125,0.375,"part"],[7.513,0.175,"is"],[7.7,0.237,"your"],[7.95,0.463,"effort"],[8.438,0.125,"and"],[8.575,0.175,"your"],[8.762,0.675,"intention"],[9.838,0.075,"The"],[9.938,0.55,"outcome"],[10.5,0.512,"belongs"],[11.025,0.1,"to"],[11.137,0.425,"something"],[11.575,0.45,"larger"],[12.037,0.15,"than"],[12.2,0.35,"you"],[12.95,0.062,"Do"],[13.025,0.15,"your"],[13.188,0.3,"part"],[13.5,0.388,"well"],[13.912,0.2,"and"],[14.125,0.188,"let"],[14.325,0.05,"the"],[14.387,0.45,"universe"],[14.85,0.35,"handle"],[15.213,0.087,"the"],[15.312,0.5,"rest"]]},{"layout":"compare","headline":"The same action, two different worlds","visual":["With ignorance | With wisdom","Fighting from anger or fear | Fighting from duty and understanding","Bound by the result | Free in the result","The ego acts | The Self is at peace"],"L":["L12"],"say":"Lesson twelve. The same action can be done with wisdom or with ignorance. Arjuna could fight out of anger, or fear, or pride. Or he could fight knowing the eternal Self and his duty. From outside, the two look identical. Inside, they are completely different, and that inner difference is what the Gita cares about.","start":452.928,"at":453.504,"end":474.336,"words":[[0.062,0.325,"Lesson"],[0.4,0.55,"twelve"],[1.337,0.062,"The"],[1.413,0.312,"same"],[1.738,0.438,"action"],[2.188,0.163,"can"],[2.362,0.125,"be"],[2.5,0.312,"done"],[2.825,0.188,"with"],[3.025,0.575,"wisdom"],[3.625,0.2,"or"],[3.837,0.175,"with"],[4.025,0.65,"ignorance"],[5.075,0.463,"Arjuna"],[5.55,0.188,"could"],[5.75,0.325,"fight"],[6.088,0.138,"out"],[6.237,0.113,"of"],[6.362,0.512,"anger"],[6.9,0.175,"or"],[7.088,0.5,"fear"],[7.612,0.163,"or"],[7.787,0.525,"pride"],[8.725,0.15,"Or"],[8.887,0.163,"he"],[9.062,0.163,"could"],[9.238,0.4,"fight"],[9.65,0.412,"knowing"],[10.075,0.062,"the"],[10.15,0.4,"eternal"],[10.562,0.438,"Self"],[11.025,0.113,"and"],[11.15,0.175,"hi