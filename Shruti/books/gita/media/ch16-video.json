,0.438,"highest"],[12.85,0.388,"goal"],[13.625,0.562,"Scripture"],[14.2,0.512,"exists"],[14.725,0.113,"to"],[14.85,0.325,"show"],[15.188,0.212,"what"],[15.412,0.312,"should"],[15.738,0.113,"and"],[15.863,0.2,"should"],[16.075,0.225,"not"],[16.312,0.113,"be"],[16.438,0.388,"done"]]},{"layout":"closing","headline":"Choose what you grow","visual":["Divine qualities free; demonic ones bind","Close the gates of lust, anger and greed","Let scripture light the way"],"L":[],"say":"So, Chapter Sixteen. Divine qualities lead to freedom, and demonic qualities lead to bondage, and every day we are growing one or the other. Close the three gates of lust, anger and greed, and let scripture light the way. Next, Krishna explains three kinds of faith.","start":219.504,"at":220.08,"end":239.424,"words":[[0.113,0.475,"So"],[0.863,0.412,"Chapter"],[1.288,0.725,"Sixteen"],[2.413,0.4,"Divine"],[2.825,0.625,"qualities"],[3.462,0.25,"lead"],[3.725,0.087,"to"],[3.825,0.512,"freedom"],[4.612,0.087,"and"],[4.713,0.463,"demonic"],[5.188,0.588,"qualities"],[5.787,0.212,"lead"],[6.013,0.087,"to"],[6.112,0.512,"bondage"],[6.925,0.113,"and"],[7.05,0.25,"every"],[7.312,0.263,"day"],[7.588,0.138,"we"],[7.737,0.062,"are"],[7.812,0.388,"growing"],[8.213,0.35,"one"],[8.575,0.1,"or"],[8.688,0.138,"the"],[8.838,0.35,"other"],[9.55,0.412,"Close"],[9.975,0.113,"the"],[10.1,0.287,"three"],[10.4,0.312,"gates"],[10.725,0.1,"of"],[10.838,0.487,"lust"],[11.588,0.45,"anger"],[12.125,0.138,"and"],[12.275,0.45,"greed"],[13.0,0.113,"and"],[13.125,0.212,"let"],[13.35,0.45,"scripture"],[13.812,0.25,"light"],[14.075,0.087,"the"],[14.175,0.4,"way"],[14.963,0.537,"Next"],[15.775,0.412,"Krishna"],[16.2,0.662,"explains"],[16.875,0.25,"three"],[17.137,0.338,"kinds"],[17.488,0.087,"of"],[17.587,0.512,"faith"]]}]}