.237,"see"],[12.762,0.4,"this"],[13.562,0.312,"Those"],[13.887,0.163,"with"],[14.062,0.075,"the"],[14.15,0.312,"eye"],[14.475,0.113,"of"],[14.6,0.425,"knowledge"],[15.037,0.4,"can"]]},{"layout":"lesson","headline":"God Is the Inner Light and Sustainer of All Life","visual":["The light of the sun, the moon and fire","The nourishment in the plants, the fire within","Memory and knowledge come from Him"],"L":["L3"],"say":"Lesson three. God is the inner light and sustainer of all life. The light of the sun, the moon and fire is his. He nourishes the plants and digests our food. He sits in every heart, and from him come memory, knowledge and the clearing of doubt.","start":217.464,"at":218.04,"end":235.896,"words":[[0.062,0.362,"Lesson"],[0.438,0.45,"three"],[1.288,0.287,"God"],[1.587,0.175,"is"],[1.775,0.075,"the"],[1.863,0.3,"inner"],[2.175,0.362,"light"],[2.55,0.125,"and"],[2.688,0.662,"sustainer"],[3.362,0.113,"of"],[3.487,0.225,"all"],[3.725,0.475,"life"],[4.588,0.1,"The"],[4.7,0.325,"light"],[5.037,0.1,"of"],[5.15,0.087,"the"],[5.25,0.463,"sun"],[5.737,0.125,"the"],[5.875,0.35,"moon"],[6.237,0.113,"and"],[6.362,0.475,"fire"],[6.85,0.163,"is"],[7.025,0.438,"his"],[7.862,0.138,"He"],[8.012,0.562,"nourishes"],[8.588,0.113,"the"],[8.713,0.5,"plants"],[9.225,0.175,"and"],[9.412,0.6,"digests"],[10.025,0.163,"our"],[10.2,0.45,"food"],[11.05,0.087,"He"],[11.15,0.362,"sits"],[11.525,0.15,"in"],[11.688,0.275,"every"],[11.975,0.425,"heart"],[12.875,0.15,"and"],[13.037,0.2,"from"],[13.25,0.263,"him"],[13.525,0.225,"come"],[13.762,0.5,"memory"],[14.75,0.613,"knowledge"],[15.387,0.113,"and"],[15.512,0.087,"the"],[15.613,0.45,"clearing"],[16.075,0.125,"of"],[16.212,0.412,"doubt"]]},{"layout":"steps","headline":"Three levels of being","visual":["Temporal beings","The eternal soul","The Supreme Being"],"L":["L4"],"say":"Lesson four. Three entities: temporal beings, the eternal soul, and the Supreme. All created things change and pass. The individual soul does not change. And the Supreme Being, God, is beyond both, sustaining and pervading them. Whoever knows this, knows everything.","start":235.896,"at":236.472,"end":255.6,"words":[[0.062,0.325,"Lesson"],[0.4,0.438,"four"],[1.238,0.375,"Three"],[1.625,0.7,"entities"],[2.7,0.412,"temporal"],[3.125,0.463,"beings"],[3.612,0.075,"the"],[3.7,0.412,"eternal"],[4.125,0.475,"soul"],[4.625,0.15,"and"],[4.787,0.075,"the"],[4.875,0.65,"Supreme"],[5.925,0.15,"All"],[6.088,0.388,"created"],[6.487,0.275,"things"],[6.775,0.475,"change"],[7.263,0.113,"and"],[7.388,0.525,"pass"],[8.287,0.062,"The"],[8.363,0.562,"individual"],[8.938,0.4,"soul"],[9.35,0.188,"does"],[9.55,0.25,"not"],[9.812,0.6,"change"],[10.8,0.1,"And"],[10.912,0.075,"the"],[11.0,0.525,"Supreme"],[11.537,0.375,"Being"],[11.925,0.537,"God"],[12.775,0.212,"is"],[13.0,0.463,"beyond"],[13.475,0.338,"both"],[13.825,0.762,"sustaining"],[14.6,0.138,"and"],[14.75,0.5,"pervading"],[15.262,0.263,"them"],[15.912,0.312,"Whoever"],[16.238,0.338,"knows"],[16.587,0.338,"this"],[16.938,0.362,"knows"],[17.312,0.588,"everything"]]},{"layout":"closing","headline":"Cut the roots, find the source","visual":["The world is a tree rooted in God","The soul moves on like a fragrance","God is the light in all, and beyond all"],"L":[],"say":"So, Chapter Fifteen. The world is a great tree whose roots reach up to God, and the axe of detachment cuts us free. The soul moves from body to body like a fragrance on the wind. And God is the light in everything, and beyond everything. Next, Krishna describes two kinds of people.","start":255.6,"at":256.176,"end":276.096,"words":[[0.05,0.287,"So"],[0.362,0.463,"Chapter"],[0.838,0.65,"Fifteen"],[1.887,0.087,"The"],[1.988,0.325,"world"],[2.325,0.113,"is"],[2.45,0.062,"a"],[2.525,0.275,"great"],[2.812,0.338,"tree"],[3.163,0.25,"whose"],[3.425,0.35,"roots"],[3.788,0.237,"reach"],[4.037,0.125,"up"],[4.175,0.113,"to"],[4.3,0.475,"God"],[5.263,0.175,"and"],[5.45,0.075,"the"],[5.537,0.35,"axe"],[5.9,0.1,"of"],[6.013,0.625,"detachment"],[6.65