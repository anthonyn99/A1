p in a spot sheltered by the Eternal Being from the wind of desires does not flicker; this simile is used for the subdued mind of a yogi, practicing meditation on the Eternal Being.","start":168.792,"dur":39.072,"words":[[0.138,0.263,"This"],[0.412,0.438,"yoga"],[0.863,0.15,"is"],[1.025,0.225,"not"],[1.262,0.537,"possible"],[1.975,0.1,"O"],[2.087,0.575,"Arjuna"],[2.938,0.087,"for"],[3.038,0.087,"the"],[3.138,0.2,"one"],[3.35,0.138,"who"],[3.5,0.25,"eats"],[3.763,0.188,"too"],[3.962,0.35,"much"],[4.325,0.062,"or"],[4.4,0.138,"who"],[4.55,0.15,"does"],[4.713,0.212,"not"],[4.938,0.15,"eat"],[5.1,0.125,"at"],[5.237,0.25,"all"],[5.8,0.075,"who"],[5.888,0.4,"sleeps"],[6.3,0.188,"too"],[6.5,0.375,"much"],[6.888,0.075,"or"],[6.975,0.15,"who"],[7.138,0.287,"keeps"],[7.438,0.5,"awake"],[8.3,0.212,"But"],[8.525,0.113,"for"],[8.65,0.087,"the"],[8.75,0.212,"one"],[8.975,0.138,"who"],[9.125,0.113,"is"],[9.25,0.425,"moderate"],[9.688,0.125,"in"],[9.825,0.463,"eating"],[10.488,0.762,"recreation"],[11.537,0.525,"working"],[12.3,0.562,"sleeping"],[13.025,0.125,"and"],[13.162,0.525,"waking"],[13.988,0.087,"the"],[14.088,0.362,"yoga"],[14.463,0.1,"of"],[14.575,0.675,"meditation"],[15.262,0.575,"destroys"],[15.85,0.2,"all"],[16.062,0.5,"sorrow"],[16.962,0.087,"A"],[17.062,0.438,"person"],[17.512,0.113,"is"],[17.637,0.225,"said"],[17.875,0.087,"to"],[17.975,0.15,"have"],[18.137,0.425,"achieved"],[18.575,0.45,"yoga"],[19.262,0.075,"the"],[19.35,0.463,"union"],[19.825,0.138,"with"],[19.975,0.1,"the"],[20.087,0.463,"Eternal"],[20.562,0.375,"Being"],[21.238,0.125,"when"],[21.375,0.1,"the"],[21.488,0.525,"perfectly"],[22.025,0.537,"disciplined"],[22.575,0.362,"mind"],[22.95,0.362,"becomes"],[23.325,0.263,"free"],[23.6,0.188,"from"],[23.8,0.163,"all"],[23.975,0.613,"desires"],[24.6,0.15,"and"],[24.762,0.225,"gets"],[25.0,0.525,"completely"],[25.538,0.487,"united"],[26.038,0.15,"with"],[26.2,0.3,"God"],[26.512,0.15,"in"],[26.675,0.6,"Samadhi"],[27.45,0.637,"trance"],[28.475,0.075,"A"],[28.562,0