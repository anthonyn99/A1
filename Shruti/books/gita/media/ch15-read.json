oleheartedly, O Arjuna. Thus, I have explained this most secret science of Self-knowledge, O sinless Arjuna. Having understood this, one becomes enlightened; one’s all duties are accomplished; and the goal of human life is achieved, O Arjuna.","start":241.32,"dur":58.968,"words":[[0.1,0.125,"There"],[0.312,0.013,"are"],[0.388,0.237,"two"],[0.7,0.512,"entities"],[1.225,0.087,"in"],[1.312,0.113,"the"],[1.438,0.55,"cosmos"],[2.538,0.138,"The"],[2.688,0.425,"temporal"],[3.112,0.412,"Divine"],[3.562,0.388,"Beings"],[3.975,0.237,"and"],[4.225,0.087,"the"],[4.4,0.65,"unchangeable"],[5.062,0.45,"Eternal"],[5.513,0.35,"Being"],[6.838,0.175,"All"],[7.05,0.525,"created"],[7.612,0.338,"beings"],[7.963,0.1,"are"],[8.113,0.45,"subject"],[8.6,0.1,"to"],[8.713,0.425,"change"],[9.5,0.212,"but"],[9.713,0.113,"the"],[9.887,0.412,"Eternal"],[10.3,0.275,"Being"],[10.625,0.15,"does"],[10.812,0.25,"not"],[11.088,0.487,"change"],[12.625,0.087,"The"],[12.725,0.475,"Supreme"],[13.238,0.287,"Being"],[13.662,0.175,"is"],[13.838,0.4,"beyond"],[14.3,0.237,"both"],[14.588,0.1,"the"],[14.688,0.45,"Temporal"],[15.137,0.425,"Divine"],[15.613,0.4,"Beings"],[16.05,0.25,"and"],[16.3,0.087,"the"],[16.45,0.425,"Eternal"],[16.875,0.35,"Being"],[18.212,0.087,"He"],[18.375,0.062,"is"],[18.438,0.4,"also"],[18.9,0.275,"called"],[19.188,0.075,"the"],[19.35,0.55,"Absolute"],[20.3,0.588,"Reality"],[21.312,0.312,"God"],[21.863,0.1,"the"],[21.975,0.312,"Source"],[22.663,0.237,"who"],[22.962,0.45,"sustains"],[23.45,0.25,"both"],[23.725,0.087,"the"],[23.825,0.45,"Temporal"],[24.325,0.125,"and"],[24.45,0.087,"the"],[24.587,0.412,"Eternal"],[25.012,0.125,"by"],[25.212,0.463,"pervading"],[25.738,0.487,"everything"],[27.2,0.212,"Because"],[27.413,0.125,"I"],[27.65,0.037,"am"],[27.725,0.35,"beyond"],[28.125,0.237,"both"],[28.4,0.1,"the"],[28.5,0.438,"Temporal"],[28.975,0.1,"and"],[29.075,0.087,"the"],[29.225,0.475,"Eternal"],[30.137,0.4,"therefore"],[30.55,0.087,"I"],[30.738,0.037,"am"],[30.825,0.3,"known"],[31.15,0.087,