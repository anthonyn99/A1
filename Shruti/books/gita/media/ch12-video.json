,"has"],[9.262,0.1,"the"],[9.375,0.3,"best"],[9.688,0.3,"knowledge"],[10.0,0.1,"of"],[10.113,0.463,"yoga"],[10.7,0.25,"those"],[10.963,0.787,"ever-steadfast"],[11.762,0.613,"devotees"],[12.387,0.1,"who"],[12.5,0.438,"worship"],[12.95,0.138,"You"],[13.1,0.113,"as"],[13.225,0.5,"Krishna"],[13.988,0.113,"Your"],[14.113,0.487,"personal"],[14.613,0.525,"aspect"],[15.425,0.075,"or"],[15.512,0.25,"those"],[15.775,0.087,"who"],[15.875,0.438,"worship"],[16.325,0.125,"Your"],[16.462,0.562,"impersonal"],[17.038,0.537,"aspect"],[17.812,0.087,"the"],[17.913,0.412,"Eternal"],[18.337,0.412,"Being"]]},{"layout":"verse","headline":"","visual":[],"L":["L1"],"ref":"12.02","verse":"The Supreme Lord said: I consider the best yogis to be those ever-steadfast devotees who worship with supreme faith by fixing their mind on Me as their personal god.","key":true,"vs":[6,35],"say":"Krishna's answer is clear. Verse two. The Supreme Lord said: I consider the best yogis to be those ever-steadfast devotees who worship with supreme faith by fixing their mind on Me as their personal god.","start":30.288,"at":30.864,"end":45.336,"words":[[0.1,0.55,"Krishna's"],[0.662,0.438,"answer"],[1.113,0.188,"is"],[1.312,0.487,"clear"],[2.163,0.45,"Verse"],[2.625,0.438,"two"],[3.462,0.113,"The"],[3.587,0.45,"Supreme"],[4.05,0.237,"Lord"],[4.3,0.325,"said"],[4.938,0.075,"I"],[5.025,0.45,"consider"],[5.487,0.113,"the"],[5.612,0.287,"best"],[5.912,0.412,"yogis"],[6.338,0.1,"to"],[6.45,0.163,"be"],[6.625,0.275,"those"],[6.912,0.825,"ever-steadfast"],[7.75,0.65,"devotees"],[8.412,0.113,"who"],[8.537,0.475,"worship"],[9.025,0.125,"with"],[9.162,0.463,"supreme"],[9.637,0.425,"faith"],[10.075,0.15,"by"],[10.238,0.412,"fixing"],[10.662,0.113,"their"],[10.787,0.325,"mind"],[11.125,0.113,"on"],[11.25,0.225,"Me"],[11.488,0.15,"as"],[11.65,0.113,"their"],[11.775,0.487,"personal"],[12.275,0.388,"god"]]},{"layout":"verse","headline":"","visual":[],"L":["L1"],"ref":"12.05","verse":"Self-realization is more difficult for those w