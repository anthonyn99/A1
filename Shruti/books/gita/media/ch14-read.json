7.425,0.575,"inaction"],[58.275,0.525,"laziness"],[58.812,0.138,"by"],[58.962,0.4,"covering"],[59.375,0.825,"Self-knowledge"]]},{"b":5,"part":0,"text":"Characteristics of three modes of nature","start":102.792,"dur":3.048,"words":[[0.1,1.087,"Characteristics"],[1.2,0.175,"of"],[1.387,0.275,"three"],[1.675,0.312,"modes"],[2.0,0.113,"of"],[2.125,0.562,"nature"]]},{"b":6,"part":0,"text":"Goodness prevails by suppressing passion and ignorance; passion prevails by suppressing goodness and ignorance; and ignorance prevails by suppressing goodness and passion, O Arjuna. When the light of Self-knowledge illuminates all the senses in the body, then it should be known that goodness is predominant. O Arjuna, when passion is predominant, greed, activity, undertaking of selfish work, restlessness, excitement, etc. arise. O Arjuna, when inertia is predominant, ignorance, inactivity, carelessness, delusion, etc. arise.","start":105.84,"dur":35.016,"words":[[0.1,0.5,"Goodness"],[0.613,0.562,"prevails"],[1.188,0.15,"by"],[1.35,0.55,"suppressing"],[1.913,0.425,"passion"],[2.35,0.113,"and"],[2.475,0.6,"ignorance"],[3.388,0.375,"passion"],[3.775,0.525,"prevails"],[4.312,0.15,"by"],[4.475,0.55,"suppressing"],[5.037,0.412,"goodness"],[5.463,0.1,"and"],[5.575,0.537,"ignorance"],[6.425,0.113,"and"],[6.55,0.425,"ignorance"],[6.987,0.512,"prevails"],[7.513,0.15,"by"],[7.675,0.537,"suppressing"],[8.225,0.412,"goodness"],[8.65,0.1,"and"],[8.762,0.512,"passion"],[9.463,0.138,"O"],[9.613,0.613,"Arjuna"],[10.625,0.175,"When"],[10.812,0.087,"the"],[10.912,0.3,"light"],[11.225,0.113,"of"],[11.35,0.738,"Self-knowledge"],[12.1,0.7,"illuminates"],[12.812,0.188,"all"],[13.012,0.1,"the"],[13.125,0.438,"senses"],[13.575,0.1,"in"],[13.688,0.087,"the"],[13.787,0.375,"body"],[14.5,0.138,"then"],[14.65,0.087,"it"],[14.75,0.188,"should"],[14.95,0.1,"be"],[15.062,0.325,"known"],[15.4,0.163,"that"],[15.575,0.425,"goodness"],[16.012,0.113,"is"],[16.137,0.8,"predominant"],[17.325,0.188,"O"],[17.525,0.6,"Arjuna"],[18.375,0.163,"when"],[18.55,0.375,"passion"],[18.938,0.1,"is"],[19.05,0.713,"predominant"],[19.988,0.425,"greed"],[20.65,0.7,"activity"],[21.637,0.6,"undertaking"],[22.25,0.087,"of"],[22.35,0.425,"selfish"],[22.788,0.4,"work"],[23.488,0.787,"restlessness"],[24.475,0.7,"excitement"],[25.375,0.537,"etc."],[25.925,0.6,"arise"],[26.913,0.188,"O"],[27.113,0.613,"Arjuna"],[27.975,0.138,"when"],[28.125,0.475,"inertia"],[28.613,0.138,"is"],[28.762,0.688,"predominant"],[29.688,0.613,"ignorance"],[30.525,0.775,"inactivity"],[31.6,0.787,"carelessness"],[32.625,0.637,"delusion"],[33.45,0.55,"etc."],[34.013,0.625,"arise"]]},{"b":7,"part":0,"text":"Three modes are also the vehicles of transmigration","start":140.856,"dur":3.816,"words":[[0.125,0.312,"Three"],[0.45,0.45,"modes"],[0.912,0.163,"are"],[1.087,0.45,"also"],[1.55,0.125,"the"],[1.688,0.55,"vehicles"],[2.25,0.1,"of"],[2.362,1.075,"transmigration"]]},{"b":8,"part":0,"text":"One who dies when goodness dominates goes to heaven — the pure world of knowers of the Supreme. One who dies when passion dominates is reborn attached to action or the utilitarian type. One who dies in ignorance is reborn as a lower creature. The fruit of good action is said to be beneficial and pure; the fruit of passionate action is pain; and the fruit of ignorant action is laziness. Self-knowledge arises from the mode of goodness; greed arises from the mode of passion; and negligence, delusion, and slowness of mind arise from the mode of ignorance. They who are established in goodness go to heaven; passionate persons are reborn in the mortal world; and the ignorant, abiding in the lowest mode of ignorance, go to lower planets or hell (or take birth as lower creatures).","start":144.672,"dur":46.488,"words":[[0.138,0.237,"One"],[0.388,0.175,"who"],[0.575,0.425,"dies"],[1.012,0.188,"when"],[1.212,0.4,"goodness"],[1.625,0.55,"dominates"],[2.188,0.225,"goes"],[2.425,0.113,"to"],[2.55,0.45,"heaven"],[3.125,0.113,"the"],[3.25,0.237,"pure"],[3.5,0.438,"world"],[3.95,0.125,"of"],[4.088,0.362,"knowers"],[4.463,0.087,"of"],[4.562,0.087,"the"],[4.662,0.613,"Supreme"],[5.675,0.237,"One"],[5.925,0.175,"who"],[6.112,0.412,"dies"],[6.537,0.188,"when"],[6.737,0.4,"passion"],[7.15,0.575,"dominates"],[7.737,0.15,"is"],[7.9,0.537,"reborn"],[8.45,0.45,"attached"],[8.912,0.087,"to"],[9.012,0.575,"action"],[9.6,0.138,"or"],[9.75,0.1,"the"],[9.863,0.838,"utilitarian"],[10.713,0.487,"type"],[11.6,0.25,"One"],[11.863,0.175,"who"],[12.05,0.35,"dies"],[12.412,0.1,"in"],[12.525,0.588,"ignorance"],[13.125,0.175,"is"],[13.312,0.562,"reborn"],[13.887,0.163,"as"],[14.062,0.05,"a"],[14.125,0.325,"lower"],[14.463,0.6,"creature"],[15.463,0.125,"The"],[15.6,0.3,"fruit"],[15.912,0.138,"of"],[16.062,0.163,"good"],[16.238,0.5,"action"],[16.75,0.15,"is"],[16.913,0.225,"said"],[17.15,0.075,"to"],[17.238,0.138,"be"],[17.387,0.662,"beneficial"],[18.062,0.113,"and"],[18.188,0.388,"pure"],[18.9,0.1,"the"],[19.012,0.287,"fruit"],[19.312,0.125,"of"],[19.45,0.487,"passionate"],[19.95,0.35,"action"],[20.312,0.113,"is"],[20.438,0.425,"pain"],[21.163,0.1,"and"],[21.275,0.087,"the"],[21.375,0.275,"fruit"],[21.663,0.1,"of"],[21.775,0.375,"ignorant"],[22.163,0.412,"action"],[22.587,0.163,"is"],[22.762,0.738,"laziness"],[23.887,0.762,"Self-knowledge"],[24.663,0.512,"arises"],[25.188,0.163,"from"],[25.363,0.075,"the"],[25.45,0.237,"mode"],[25.7,0.113,"of"],[25.825,0.562,"goodness"],[26.688,0.275,"greed"],[26.975,0.525,"arises"],[27.512,0.15,"from"],[27.675,0.075,"the"],[27.762,0.225,"mode"],[28.0,0.113,"of"],[28.125,0.5,"passion"],[28.913,0.15,"and"],[29.075,0.7,"negligence"],[29.962,0.625,"delusion"],[30.775,0.125,"and"],[30.913,0.45,"slowness"],[31.375,0.113,"of"],[31.5,0.375,"mind"],[31.887,0.45,"arise"],[32.35,0.138,"from"],[32.5,0.075,"the"],[32.587,0.25,"mode"],[32.85,0.087,"of"],[32.95,0.675,"ignorance"],[34.013,0.188,"They"],[34.212,0.163,"who"],[34.388,0.113,"are"],[34.513,0.625,"established"],[35.15,0.1,"in"],[35.263,0.45,"goodness"],[35.725,0.175,"go"],[