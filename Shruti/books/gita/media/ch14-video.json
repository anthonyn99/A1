 is freed from birth, old age and death.","start":227.88,"at":228.456,"end":243.552,"words":[[0.062,0.325,"Lesson"],[0.4,0.438,"four"],[1.238,0.475,"Rising"],[1.725,0.463,"above"],[2.2,0.1,"the"],[2.312,0.3,"three"],[2.625,0.425,"modes"],[3.062,0.362,"brings"],[3.438,0.725,"liberation"],[4.575,0.1,"The"],[4.688,0.225,"one"],[4.925,0.15,"who"],[5.088,0.3,"neither"],[5.4,0.35,"hates"],[5.763,0.087,"the"],[5.862,0.425,"modes"],[6.3,0.138,"when"],[6.45,0.113,"they"],[6.575,0.438,"arrive"],[7.025,0.188,"nor"],[7.225,0.362,"longs"],[7.6,0.125,"for"],[7.737,0.237,"them"],[7.987,0.125,"when"],[8.125,0.138,"they"],[8.275,0.463,"leave"],[9.15,0.2,"who"],[9.363,0.412,"watches"],[9.787,0.175,"them"],[9.975,0.312,"without"],[10.3,0.212,"being"],[10.525,0.487,"moved"],[11.438,0.212,"is"],[11.662,0.338,"freed"],[12.012,0.188,"from"],[12.213,0.425,"birth"],[12.675,0.3,"old"],[12.988,0.325,"age"],[13.325,0.113,"and"],[13.45,0.412,"death"]]},{"layout":"lesson","headline":"Devotional Love Cuts the Bonds of the Modes","visual":["Not suppression, not analysis","Unswerving loving devotion","Lifts the soul above all three"],"L":["L5"],"say":"Lesson five. Devotional love cuts the bonds of the modes. The way beyond the three ropes is not suppression or endless self-analysis. It is unswerving, loving service to God. That love lifts the soul above all three.","start":243.552,"at":244.128,"end":260.16,"words":[[0.062,0.325,"Lesson"],[0.4,0.512,"five"],[1.325,0.613,"Devotional"],[1.95,0.325,"love"],[2.288,0.362,"cuts"],[2.663,0.125,"the"],[2.8,0.4,"bonds"],[3.212,0.1,"of"],[3.325,0.075,"the"],[3.413,0.525,"modes"],[4.338,0.1,"The"],[4.45,0.263,"way"],[4.725,0.487,"beyond"],[5.225,0.1,"the"],[5.338,0.287,"three"],[5.638,0.412,"ropes"],[6.075,0.163,"is"],[6.25,0.287,"not"],[6.55,0.65,"suppression"],[7.213,0.263,"or"],[7.487,0.325,"endless"],[7.825,0.963,"self-analysis"],[9.15,0.125,"It"],[9.287,0.163,"is"],[9.463,0.887,"unswerving"],[10.512,0.4,"loving"],[10.925,0.475,"service"],[11.412,0.1,"to"]