{"v":1,"book":"gita","n":16,"voice":"en-GB-SoniaNeural","engine":"edge","duration":255.552,"segs":[{"b":0,"part":0,"text":"A list of divine qualities to be cultivated","start":0.0,"dur":3.408,"words":[[0.113,0.087,"A"],[0.212,0.35,"list"],[0.575,0.138,"of"],[0.725,0.45,"divine"],[1.188,0.662,"qualities"],[1.863,0.1,"to"],[1.975,0.125,"be"],[2.112,0.925,"cultivated"]]},{"b":1,"part":0,"text":"The Supreme Lord said: Fearlessness, purity of the inner psyche, perseverance in the yoga of Self-knowledge, charity, sense-restraint, sacrifice, study of the scriptures, austerity, honesty; non-violence, truthfulness, absence of anger, renunciation, calmness, abstinence from malicious talk, compassion for all creatures, freedom from greed, gentleness, modesty, absence of fickleness, splendor, forgiveness, fortitude, cleanliness, absence of malice, and absence of pride — these are the (twenty-six) qualities of those endowed with divine virtues, O Arjuna.","start":3.408,"dur":39.288,"words":[[0.1,0.15,"The"],[0.263,0.475,"Supreme"],[0.75,0.25,"Lord"],[1.012,0.3,"said"],[1.613,0.762,"Fearlessness"],[2.6,0.425,"purity"],[3.038,0.087,"of"],[3.138,0.087,"the"],[3.237,0.25,"inner"],[3.5,0.525,"psyche"],[4.263,0.738,"perseverance"],[5.013,0.075,"in"],[5.1,0.075,"the"],[5.188,0.362,"yoga"],[5.562,0.087,"of"],[5.662,0.787,"Self-knowledge"],[6.688,0.562,"charity"],[7.525,0.825,"sense-restraint"],[8.613,0.775,"sacrifice"],[9.65,0.362,"study"],[10.025,0.087,"of"],[10.125,0.087,"the"],[10.225,0.625,"scriptures"],[11.062,0.7,"austerity"],[12.05,0.525,"honesty"],[12.938,0.85,"non-violence"],[14.012,0.75,"truthfulness"],[15.012,0.4,"absence"],[15.425,0.087,"of"],[15.525,0.388,"anger"],[16.175,0.912,"renunciation"],[17.375,0.625,"calmness"],[18.25,0.575,"abstinence"],[18.837,0.163,"from"],[19.012,0.438,"malicious"],[19.462,0.463,"talk"],[20.163,0.662,"compassion"],[20.837,0.125,"for"],[20.975,0.212,"all"],[21.2,0.6,"creatures"],[22.05,0.375,"freedom"],[22.438,0.188,"from"],[22.637,0.438,"greed"]