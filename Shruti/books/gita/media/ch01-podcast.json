92,"the"],[2.039,0.461,"verses"],[2.513,0.132,"our"],[2.658,0.25,"book"],[2.921,0.289,"leaves"],[3.224,0.329,"out"],[3.724,0.145,"is"],[3.882,0.118,"the"],[4.013,0.645,"build-up"],[5.092,0.737,"Duryodhana"],[5.842,0.368,"walks"],[6.224,0.105,"up"],[6.342,0.132,"to"],[6.487,0.197,"his"],[6.697,0.526,"teacher"],[7.25,0.526,"Drona"],[8.066,0.158,"and"],[8.237,0.289,"lists"],[8.539,0.105,"the"],[8.658,0.329,"great"],[9.0,0.566,"warriors"],[9.579,0.145,"on"],[9.737,0.263,"both"],[10.013,0.645,"sides"],[11.079,0.092,"The"],[11.184,0.289,"old"],[11.487,0.711,"grandsire"],[12.237,0.539,"Bhishma"],[13.079,0.303,"blows"],[13.395,0.197,"his"],[13.605,0.289,"conch"],[13.908,0.276,"shell"],[14.197,0.171,"like"],[14.382,0.053,"a"],[14.447,0.461,"lion's"],[14.921,0.434,"roar"],[15.789,0.171,"Then"],[15.974,0.553,"conches"],[16.539,0.118,"and"],[16.671,0.408,"drums"],[17.092,0.118,"and"],[17.224,0.355,"horns"],[17.592,0.303,"sound"],[17.908,0.75,"everywhere"],[19.092,0.408,"Krishna"],[19.513,0.303,"blows"],[19.829,0.184,"his"],[20.026,0.447,"conch"],[20.75,0.434,"Arjuna"],[21.197,0.355,"blows"],[21.566,0.355,"his"],[22.276,0.118,"and"],[22.408,0.092,"the"],[22.513,0.355,"noise"],[22.895,0.118,"the"],[23.026,0.368,"text"],[23.408,0.368,"says"],[24.013,0.276,"makes"],[24.303,0.105,"the"],[24.421,0.408,"sky"],[24.842,0.118,"and"],[24.974,0.092,"the"],[25.079,0.25,"earth"],[25.342,0.566,"tremble"]]},{"s":"B","start":169.032,"end":189.384,"text":"And then the moment that starts everything. Arjuna is the great archer of the Pandavas, and Krishna is driving his chariot, as a friend. Our book's summary picks it up here: Arjuna asked his charioteer-friend, Lord Krishna, to drive his chariot between the two armies so that he could see the armies on both sides.","L":[],"words":[[0.092,0.132,"And"],[0.237,0.289,"then"],[0.539,0.092,"the"],[0.645,0.5,"moment"],[1.158,0.171,"that"],[1.342,0.408,"starts"],[1.776,0.671,"everything"],[2.868,0.553,"Arjuna"],[3.434,0.197,"is"],[3.645,0.105,"the"],[3.763,0.355,"great"],[4.145,0.513,"archer"],[4.671,0.079,"of"],[4.763,0.092,"the"],[4.868,0.803,"Pandavas"],[5.987,0.25,"and"],[6.25,0.526,"Krishna"],[6.789,0.158,"is"],[6.961,0.434,"driving"],[7.408,0.171,"his"],[7.592,0.592,"chariot"],[8.197,0.197,"as"],[8.408,0.066,"a"],[8.487,0.5,"friend"],[9.408,0.171,"Our"],[9.592,0.237,"book's"],[9.842,0.421,"summary"],[10.276,0.263,"picks"],[10.553,0.079,"it"],[10.645,0.132,"up"],[10.789,0.382,"here"],[11.776,0.566,"Arjuna"],[12.355,0.329,"asked"],[12.697,0.132,"his"],[12.842,1.066,"charioteer-friend"],[14.145,0.303,"Lord"],[14.461,0.539,"Krishna"],[15.316,0.118,"to"],[15.447,0.316,"drive"],[15.776,0.132,"his"],[15.921,0.487,"chariot"],[16.421,0.329,"between"],[16.763,0.079,"the"],[16.855,0.224,"two"],[17.092,0.461,"armies"],[17.566,0.171,"so"],[17.75,0.105,"that"],[17.868,0.118,"he"],[18.0,0.132,"could"],[18.145,0.224,"see"],[18.382,0.079,"the"],[18.474,0.474,"armies"],[18.961,0.184,"on"],[19.158,0.25,"both"],[19.421,0.539,"sides"]]},{"s":"A","start":189.672,"end":198.288,"text":"He just wants to look. To see who he'll be fighting. And Krishna parks the chariot right in the middle, facing Bhishma and Drona.","L":[],"words":[[0.105,0.079,"He"],[0.197,0.276,"just"],[0.487,0.289,"wants"],[0.789,0.132,"to"],[0.934,0.421,"look"],[1.776,0.092,"To"],[1.882,0.25,"see"],[2.145,0.132,"who"],[2.289,0.145,"he'll"],[2.447,0.118,"be"],[2.579,0.566,"fighting"],[3.592,0.132,"And"],[3.737,0.526,"Krishna"],[4.276,0.355,"parks"],[4.645,0.118,"the"],[4.776,0.526,"chariot"],[5.316,0.224,"right"],[5.553,0.105,"in"],[5.671,0.079,"the"],[5.763,0.447,"middle"],[6.526,0.421,"facing"],[6.961,0.513,"Bhishma"],[7.487,0.158,"and"],[7.658,0.566,"Drona"]]},{"s":"B","start":198.576,"end":207.024,"text":"That detail is from the full text, and it's a pointed choice. Bhishma, who raised him. Drona, who taught him to shoot.","L":["L2"],"words":[[0.079,0.184,"That"],[0.276,0.539,"detail"],[0.829,0.211,"is"],[1.053,0.211,"from"],[1.276,0.079,"the"],[1.368,0.263,"full"],[1.645,0.579,"text"],[2.618,0.184,"and"],[2.816,0.145,"it's"],[2.974,0.066,"a"],[3.053,0.368,"pointed"],[3.434,0.553,"choice"],[4.395,0.474,"Bhishma"],[4.882,0.224,"who"],[5.118,0.382,"raised"],[5.513,0.316,"him"],[6.25,0.539,"Drona"],[6.816,0.197,"who"],[7.026,0.263,"taught"],[7.303,0.171,"him"],[7.487,0.092,"to"],[7.592,0.461,"shoot"]]},{"s":"A","start":207.312,"end":225.96,"text":"And Arjuna looks across, and he doesn't see an army. He sees people. Grandfathers, teachers, uncles, brothers, cousins, sons, friends. Our summary says: Arjuna felt great compassion to see his friends and relatives on the opposite side, whom he must kill to win this war.","L":["L2"],"words":[[0.105,0.145,"And"],[0.263,0.5,"Arjuna"],[0.776,0.276,"looks"],[1.066,0.579,"across"],[1.908,0.118,"and"],[2.039,0.118,"he"],[2.171,0.368,"doesn't"],[2.553,0.184,"see"],[2.75,0.105,"an"],[2.868,0.487,"army"],[3.789,0.092,"He"],[3.895,0.329,"sees"],[4.237,0.553,"people"],[5.211,0.842,"Grandfathers"],[6.105,0.566,"teachers"],[6.697,0.447,"uncles"],[7.171,0.513,"brothers"],[7.711,0.566,"cousins"],[8.316,0.368,"sons"],[8.711,0.618,"friends"],[9.763,0.145,"Our"],[9.921,0.474,"summary"],[10.408,0.487,"says"],[11.355,0.474,"Arjuna"],[11.842,0.276,"felt"],[12.132,0.276,"great"],[12.421,0.618,"compassion"],[13.053,0.118,"to"],[13.184,0.224,"see"],[13.421,0.211,"his"],[13.645,0.368,"friends"],[14.026,0.118,"and"],[14.158,0.566,"relatives"],[14.737,0.092,"on"],[14.842,0.105,"the"],[14.961,0.513,"opposite"],[15.487,0.408,"side"],[16.434,0.145,"whom"],[16.592,0.105,"he"],[16.711,0.289,"must"],[17.013,0.263,"kill"],[17.289,0.132,"to"],[17.434,0.197,"win"],[17.645,0.197,"this"],[17.855,0.408,"war"]]},{"s":"B","start":226.248,"end":239.592,"text":"In the full Gita, his body reacts first. His limbs give way, his mouth goes dry, he trembles, his skin burns, his great bow Gandiva slips from his hand. He says he can't even stand.","L":[],"words":[[0.053,0.105,"In"],[0.171,0.092,"the"],[0.276,0.289,"full"],[0.579,0.434,"Gita"],[1.039,0.25,"his"],[1.303,0.355,"body"],[1.671,0.474,"reacts"],[2.158,0.539,"first"],[3.132,0.197,"His"],[3.342,0.329,"limbs"],[3.684,0.211,"give"],[3.908,0.368,"way"],[4.289,0.263,"his"],[4.566,0.316,"mouth"],[4.895,0.237,"goes"],[5.145,0.5,"dry"],[5.816,0.25,"he"],[6.079,0.632,"trembles"],[6.724,0.197,"his"],[6.934,0.342,"skin"],[7.289,0.539,"burns"],[8.0,0.395,"his"],[8.408,0.355,"great"],[8.776,0.263,"bow"],[9.053,0.513,"Gandiva"],[9.579,0.434,"slips"],[10.026,0.158,"from"],[10.197,0.132,"his"],[10.342,0.434,"hand"],[11.184,0.066,"He"],[11.263,0.25,"says"],[11.526,0.145,"he"],[11.684,0.355,"can't"],[12.053,0.237,"even"],[12.303,0.645,"stand"]]},{"s":"A","start":239.88,"end":255.288,"text":"Then come his arguments, and they're not foolish. He says: I don't want victory, or a kingdom, or pleasures, if the price is killing these people. What would a kingdom be worth without them? Even if they want to kill me, I don't want to kill them.","L":[],"words":[[0.105,0.197,"Then"],[0.316,0.211,"come"],[0.539,0.197,"his"],[0.75,0.697,"arguments"],[1.526,0.132,"and"],[1.671,0.145,"they're"],[1.829,0.263,"not"],[2.105,0.671,"foolish"],[3.224,0.145,"He"],[3.382,0.474,"says"],[4.237,0.066,"I"],[4.316,0.237,"don't"],[4.566,0.184,"want"],[4.763,0.605,"victory"],[5.395,0.145,"or"],[5.553,0.066,"a"],[5.632,0.513,"kingdom"],[6.224,0.105,"or"],[6.342,0.618,"pleasures"],[7.25,0.118,"if"],[7.382,0.105,"the"],[7.5,0.368,"price"],[7.882,0.158,"is"],[8.053,0.368,"killing"],[8.434,0.211,"these"],[8.658,0.487,"people"],[9.579,0.145,"What"],[9.737,0.145,"would"],[9.895,0.079,"a"],[9.987,0.408,"kingdom"],[10.408,0.145,"be"],[10.566,0.355,"worth"],[10.934,0.382,"without"],[11.329,0.329,"them"],[12.079,0.276,"Even"],[12.368,0.132,"if"],[12.513,0.118,"they"],[12.645,0.224,"want"],[12.882,0.092,"to"],[12.987,0.276,"kill"],[13.276,0.276,"me"],[13.842,0.079,"I"],[13.934,0.224,"don't"],[14.171,0.171,"want"],[14.355,0.066,"to"],[14.434,0.25,"kill"],[14.697,0.316,"them"]]},{"s":"B","start":255.576,"end":280.536,"text":"He goes further. Wars destroy families. When families are destroyed, their traditions are lost, the moral order collapses, and society falls into chaos. He's thinking like a responsible man, not a coward. Our book puts it simply: he became confused, spoke of the evils of war, and refused to fight or do his duty as a warrior.","L":["L4","L6"],"words":[[0.079,0.079,"He"],[0.171,0.263,"goes"],[0.447,0.566,"further"],[1.421,0.368,"Wars"],[1.803,0.513,"destroy"],[2.329,0.697,"families"],[3.447,0.145,"When"],[3.605,0.513,"families"],[4.132,0.092,"are"],[4.237,0.724,"destroyed"],[5.526,0.158,"their"],[5.697,0.566,"traditions"],[6.276,0.105,"are"],[6.395,0.566,"lost"],[7.408,0.105,"the"],[7.526,0.447,"moral"],[7.987,0.289,"order"],[8.289,0.75,"collapses"],[9.474,0.171,"and"],[9.658,0.605,"society"],[10.276,0.408,"falls"],[10.697,0.211,"into"],[10.921,0.658,"chaos"],[11.961,0.184,"He's"],[12.158,0.382,"thinking"],[12.553,0.197,"like"],[12.763,0.039,"a"],[12.816,0.711,"responsible"],[13.539,0.474,"man"],[14.263,0.303,"not"],[14.579,0.066,"a"],[14.658,0.645,"coward"],[15.724,0.171,"Our"],[15.908,0.276,"book"],[16.197,0.224,"puts"],[16.434,0.092,"it"],[16.539,0.553,"simply"],[17.408,0.632,"he"],[18.053,0.355,"became"],[18.421,0.776,"confused"],[19.539,0.421,"spoke"],[19.974,0.079,"of"],[20.066,0.053,"the"],[20.132,0.434,"evils"],[20.579,0.132,"of"],[20.724,0.447,"war"],[21.513,0.211,"and"],[21.737,0.5,"refused"],[22.25,0.079,"to"],[22.342,0.408,"fight"],[22.763,0.145,"or"],[22.921,0.184,"do"],[23.118,0.197,"his"],[23.329,0.421,"duty"],[23.763,0.132,"as"],[23.908,0.079,"a"],[24.0,0.566,"warrior"]]},{"s":"A","start":280.824,"end":292.08,"text":"And the chapter ends with one of the saddest images in the whole book, verse one point forty-seven: Arjuna sat down on the back seat of the chariot with his mind overwhelmed with sorrow.","L":[],"words":[[0.105,0.092,"And"],[0.211,0.079,"the"],[0.303,0.526,"chapter"],[0.842,0.224,"ends"],[1.079,0.158,"with"],[1.25,0.171,"one"],[1.434,0.079,"of"],[1.526,0.105,"the"],[1.645,0.5,"saddest"],[2.158,0.487,"images"],[2.658,0.079,"in"],[2.75,0.066,"the"],[2.829,0.237,"whole"],[3.079,0.368,"book"],[3.908,0.276,"verse"],[4.197,0.211,"one"],[4.421,0.303,"point"],[4.737,0.789,"forty-seven"],[6.211,0.461,"Arjuna"],[6.684,0.276,"sat"],[6.974,0.25,"down"],[7.237,0.092,"on"],[7.342,0.092,"the"],[7.447,0.289,"back"],[7.75,0.25,"seat"],[8.013,0.079,"of"],[8.105,0.105,"the"],[8.224,0.553,"chariot"],[8.789,0.132,"with"],[8.934,0.158,"his"],[9.105,0.395,"mind"],[9.513,0.658,"overwhelmed"],[10.184,0.158,"with"],[10.355,0.513,"sorrow"]]},{"s":"B","start":292.368,"end":301.344,"text":"Bow down. Arrows down. The greatest warrior of his age, sitting in his chariot between two armies, unable to move.","L":[],"words":[[0.092,0.158,"Bow"],[0.263,0.421,"down"],[1.064,0.368,"Arrows"],[1.446,0.434,"down"],[2.303,0.079,"The"],[2.395,0.5,"greatest"],[2.908,0.487,"warrior"],[3.408,0.066,"of"],[3.487,0.211,"his"],[3.711,0.5,"age"],[4.632,0.421,"sitting"],[5.066,0.092,"in"],[5.171,0.158,"his"],[5.342,0.539,"chariot"],[5.895,0.355,"between"],[6.263,0.25,"two"],[6.526,0.592,"armies"],[7.526,0.447,"unable"],[7.987,0.118,"to"],[8.118,0.474,"move"]]},{"s":"A","start":301.632,"end":310.752,"text":"And then, at the start of Chapter Two, he turns to Krishna and asks for help. Which is where the teaching begins. But that's next time.","L":["L5"],"words":[[0.105,0.132,"And"],[0.25,0.25,"then"],[0.526,0.092,"at"],[0.632,0.092,"the"],[0.737,0.316,"start"],[1.066,0.105,"of"],[1.184,0.461,"Chapter"],[1.658,0.368,"Two"],[2.434,0.118,"he"],[2.566,0.355,"turns"],[2.934,0.118,"to"],[3.066,0.553,"Krishna"],[3.645,0.184,"and"],[3.842,0.342,"asks"],[4.197,0.132,"for"],[4.342,0.461,"help"],[5.237,0.171,"Which"],[5.421,0.145,"is"],[5.579,0.171,"where"],[5.763,0.118,"the"],[5.895,0.447,"teaching"],[6.355,0.724,"begins"],[7.513,0.092,"But"],[7.618,0.303,"that's"],[7.934,0.329,"next"],[8.276,0.447,"time"]]},{"s":"B","start":311.616,"end":318.936,"text":"So let's take the lessons one at a time. The first: duty versus emotion, and both matter.","L":["L1"],"words":[[0.051,0.158,"So"],[0.222,0.263,"let's"],[0.499,0.263,"take"],[0.775,0.105,"the"],[0.893,0.5,"lessons"],[1.407,0.355,"one"],[1.775,0.132,"at"],[1.92,0.066,"a"],[1.999,0.526,"time"],[2.908,0.092,"The"],[3.013,0.566,"first"],[3.987,0.408,"duty"],[4.408,0.434,"versus"],[4.855,0.697,"emotion"],[5.829,0.263,"and"],[6.105,0.289,"both"],[6.408,0.526,"matter"]]},{"s":"A","start":319.224,"end":337.968,"text":"Arjuna is caught between what he should do, fight for justice, and what he feels, love for his relatives. The tempting thing is to say one of those is the real Arjuna and the other is noise. Either he's a soldier who should stop feeling, or he's a loving man who should stop pretending to be a soldier.","L":["L1"],"words":[[0.092,0.5,"Arjuna"],[0.605,0.145,"is"],[0.763,0.263,"caught"],[1.039,0.355,"between"],[1.408,0.145,"what"],[1.566,0.132,"he"],[1.711,0.224,"should"],[1.947,0.342,"do"],[2.526,0.25,"fight"],[2.789,0.171,"for"],[2.974,0.645,"justice"],[3.921,0.145,"and"],[4.079,0.145,"what"],[4.237,0.145,"he"],[4.395,0.487,"feels"],[5.026,0.263,"love"],[5.303,0.171,"for"],[5.487,0.197,"his"],[5.697,0.763,"relatives"],[6.882,0.092,"The"],[6.987,0.487,"tempting"],[7.487,0.237,"thing"],[7.737,0.132,"is"],[7.882,0.118,"to"],[8.013,0.276,"say"],[8.303,0.211,"one"],[8.526,0.118,"of"],[8.658,0.316,"those"],[8.987,0.118,"is"],[9.118,0.105,"the"],[9.237,0.289,"real"],[9.539,0.605,"Arjuna"],[10.553,0.132,"and"],[10.697,0.132,"the"],[10.842,0.263,"other"],[11.118,0.158,"is"],[11.289,0.592,"noise"],[12.303,0.25,"Either"],[12.566,0.224,"he's"],[12.803,0.066,"a"],[12.882,0.474,"soldier"],[13.368,0.132,"who"],[13.513,0.211,"should"],[13.737,0.342,"stop"],[14.092,0.474,"feeling"],[15.053,0.092,"or"],[15.158,0.197,"he's"],[15.368,0.066,"a"],[15.447,0.382,"loving"],[15.842,0.289,"man"],[16.145,0.132,"who"],[16.289,0.211,"should"],[16.513,0.303,"stop"],[16.829,0.539,"pretending"],[17.382,0.118,"to"],[17.513,0.132,"be"],[17.658,0.066,"a"],[17.737,0.618,"soldier"]]},{"s":"B","start":338.256,"end":353.304,"text":"And the lesson says no. Acknowledge both. Don't dismiss either one. His love is real. His duty is real. The Gita doesn't start by telling him to stop caring. It starts by letting him say all of it out loud.","L":["L1"],"words":[[0.066,0.118,"And"],[0.197,0.105,"the"],[0.316,0.408,"lesson"],[0.737,0.316,"says"],[1.066,0.421,"no"],[1.866,0.645,"Acknowledge"],[2.524,0.487,"both"],[3.408,0.25,"Don't"],[3.671,0.553,"dismiss"],[4.237,0.303,"either"],[4.553,0.395,"one"],[5.355,0.171,"His"],[5.539,0.303,"love"],[5.855,0.197,"is"],[6.066,0.461,"real"],[6.934,0.145,"His"],[7.092,0.395,"duty"],[7.5,0.197,"is"],[7.711,0.461,"real"],[8.579,0.079,"The"],[8.671,0.342,"Gita"],[9.026,0.329,"doesn't"],[9.368,0.434,"start"],[9.816,0.145,"by"],[9.974,0.355,"telling"],[10.342,0.211,"him"],[10.566,0.092,"to"],[10.671,0.342,"stop"],[11.026,0.513,"caring"],[11.918,0.105,"It"],[12.037,0.329,"starts"],[12.379,0.197,"by"],[12.589,0.276,"letting"],[12.879,0.145,"him"],[13.037,0.395,"say"],[13.445,0.25,"all"],[13.708,0.092,"of"],[13.813,0.092,"it"],[13.918,0.224,"out"],[14.155,0.487,"loud"]]},{"s":"A","start":354.168,"end":358.896,"text":"Lesson two: ignorance is not bliss. Face reality.","L":["L2"],"words":[[0.092,0.408,"Lesson"],[0.513,0.355,"two"],[1.276,0.579,"ignorance"],[1.868,0.145,"is"],[2.026,0.263,"not"],[2.303,0.553,"bliss"],[3.289,0.316,"Face"],[3.618,0.711,"reality"]]},{"s":"B","start":359.184,"end":369.048,"text":"Arjuna asked to see the armies. He could have charged in without looking. Once he looked and recognized the people he loved, he couldn't unsee it.","L":["L2"],"words":[[0.092,0.513,"Arjuna"],[0.618,0.382,"asked"],[1.013,0.079,"to"],[1.105,0.25,"see"],[1.368,0.092,"the"],[1.474,0.605,"armies"],[2.487,0.079,"He"],[2.579,0.145,"could"],[2.737,0.105,"have"],[2.855,0.513,"charged"],[3.382,0.25,"in"],[3.645,0.395,"without"],[4.053,0.487,"looking"],[4.961,0.289,"Once"],[5.263,0.132,"he"],[5.408,0.395,"looked"],[5.816,0.171,"and"],[6.0,0.75,"recognized"],[6.763,0.066,"the"],[6.842,0.316,"people"],[7.171,0.118,"he"],[7.303,0.5,"loved"],[8.263,0.224,"he"],[8.5,0.303,"couldn't"],[8.816,0.395,"unsee"],[9.224,0.25,"it"]]},{"s":"A","start":369.336,"end":383.28,"text":"It would have been easier not to look. But the lesson is that facing a difficult truth, even a painful one, is the first step to wisdom. Everything Krishna teaches later only happens because Arjuna looked first.","L":["L2"],"words":[[0.105,0.105,"It"],[0.224,0.118,"would"],[0.355,0.118,"have"],[0.487,0.184,"been"],[0.684,0.474,"easier"],[1.171,0.237,"not"],[1.421,0.118,"to"],[1.553,0.447,"look"],[2.434,0.105,"But"],[2.553,0.118,"the"],[2.684,0.447,"lesson"],[3.145,0.145,"is"],[3.303,0.171,"that"],[3.487,0.461,"facing"],[3.961,0.079,"a"],[4.053,0.526,"difficult"],[4.592,0.447,"truth"],[5.382,0.25,"even"],[5.645,0.066,"a"],[5.724,0.461,"painful"],[6.197,0.316,"one"],[6.947,0.105,"is"],[7.066,0.118,"the"],[7.197,0.342,"first"],[7.553,0.276,"step"],[7.842,0.132,"to"],[7.987,0.579,"wisdom"],[9.0,0.526,"Everything"],[9.539,0.5,"Krishna"],[10.053,0.461,"teaches"],[10.526,0.382,"later"],[10.921,0.276,"only"],[11.211,0.566,"happens"],[11.789,0.355,"because"],[12.158,0.487,"Arjuna"],[12.658,0.25,"looked"],[12.921,0.632,"first"]]},{"s":"B","start":384.144,"end":388.08,"text":"Lesson three: it's okay to doubt and feel lost.","L":["L3"],"words":[[0.053,0.355,"Lesson"],[0.421,0.487,"three"],[1.5,0.211,"it's"],[1.724,0.289,"okay"],[2.026,0.105,"to"],[2.145,0.408,"doubt"],[2.566,0.132,"and"],[2.711,0.316,"feel"],[3.039,0.513,"lost"]]},{"s":"A","start":388.368,"end":397.416,"text":"Arjuna doesn't pretend to be brave. In front of two armies, he admits he doesn't know what to do. That takes a kind of courage too.","L":["L3"],"words":[[0.105,0.513,"Arjuna"],[0.632,0.368,"doesn't"],[1.013,0.461,"pretend"],[1.487,0.092,"to"],[1.592,0.145,"be"],[1.75,0.579,"brave"],[2.75,0.145,"In"],[2.908,0.303,"front"],[3.224,0.105,"of"],[3.342,0.237,"two"],[3.592,0.566,"armies"],[4.421,0.118,"he"],[4.553,0.368,"admits"],[4.934,0.105,"he"],[5.053,0.368,"doesn't"],[5.434,0.145,"know"],[5.592,0.171,"what"],[5.776,0.118,"to"],[5.908,0.395,"do"],[6.737,0.171,"That"],[6.921,0.303,"takes"],[7.237,0.053,"a"],[7.303,0.289,"kind"],[7.605,0.118,"of"],[7.737,0.5,"courage"],[8.25,0.395,"too"]]},{"s":"B","start":397.704,"end":409.776,"text":"Confusion and doubt are natural parts of life. They don't make you weak. They make you honest. And honestly, a hero who never doubts would have nothing to learn from this book.","L":["L3"],"words":[[0.092,0.658,"Confusion"],[0.763,0.145,"and"],[0.921,0.434,"doubt"],[1.382,0.158,"are"],[1.553,0.5,"natural"],[2.066,0.355,"parts"],[2.434,0.145,"of"],[2.592,0.5,"life"],[3.487,0.092,"They"],[3.592,0.237,"don't"],[3.842,0.237,"make"],[4.092,0.158,"you"],[4.263,0.5,"weak"],[5.158,0.105,"They"],[5.276,0.237,"make"],[5.526,0.171,"you"],[5.711,0.605,"honest"],[6.737,0.132,"And"],[6.882,0.763,"honestly"],[8.026,0.105,"a"],[8.145,0.461,"hero"],[8.618,0.158,"who"],[8.789,0.329,"never"],[9.132,0.434,"doubts"],[9.579,0.145,"would"],[9.737,0.171,"have"],[9.921,0.395,"nothing"],[10.329,0.132,"to"],[10.474,0.329,"learn"],[10.816,0.211,"from"],[11.039,0.197,"this"],[11.25,0.434,"book"]]},{"s":"A","start":410.64,"end":415.2,"text":"Lesson four: some situations have no perfect solution.","L":["L4"],"words":[[0.092,0.408,"Lesson"],[0.513,0.395,"four"],[1.526,0.211,"some"],[1.75,0.803,"situations"],[2.566,0.184,"have"],[2.763,0.224,"no"],[3.0,0.447,"perfect"],[3.461,0.711,"solution"]]},{"s":"B","start":415.488,"end":430.92,"text":"Think about Arjuna's options. If he fights, people he loves will die. If he walks away, the injustice wins, the people who trusted him are abandoned, and a cruel ruler keeps the kingdom. Someone suffers either way.","L":["L4"],"words":[[0.092,0.237,"Think"],[0.342,0.395,"about"],[0.763,0.566,"Arjuna's"],[1.342,0.697,"options"],[2.418,0.132,"If"],[2.563,0.118,"he"],[2.695,0.539,"fights"],[3.261,0.303,"people"],[3.576,0.132,"he"],[3.721,0.355,"loves"],[4.089,0.158,"will"],[4.261,0.474,"die"],[5.116,0.145,"If"],[5.274,0.092,"he"],[5.379,0.329,"walks"],[5.721,0.487,"away"],[6.655,0.079,"the"],[6.747,0.658,"injustice"],[7.418,0.526,"wins"],[8.247,0.132,"the"],[8.392,0.316,"people"],[8.721,0.105,"who"],[8.839,0.434,"trusted"],[9.287,0.237,"him"],[9.537,0.158,"are"],[9.708,0.645,"abandoned"],[10.879,0.171,"and"],[11.063,0.066,"a"],[11.142,0.395,"cruel"],[11.55,0.421,"ruler"],[11.984,0.316,"keeps"],[12.313,0.079,"the"],[12.405,0.539,"kingdom"],[13.328,0.395,"Someone"],[13.736,0.553,"suffers"],[14.301,0.316,"either"],[14.63,0.408,"way"]]},{"s":"A","start":431.208,"end":444.864,"text":"So the lesson is: in complex situations, accept that you can't make everyone happy. Choose based on principle, not on avoiding all pain. Avoiding all pain isn't one of the choices on the table.","L":["L4"],"words":[[0.092,0.158,"So"],[0.263,0.132,"the"],[0.408,0.421,"lesson"],[0.842,0.329,"is"],[1.553,0.171,"in"],[1.737,0.539,"complex"],[2.289,0.842,"situations"],[3.461,0.395,"accept"],[3.868,0.158,"that"],[4.039,0.105,"you"],[4.158,0.289,"can't"],[4.461,0.224,"make"],[4.776,0.447,"everyone"],[5.237,0.553,"happy"],[6.211,0.329,"Choose"],[6.553,0.329,"based"],[6.895,0.132,"on"],[7.039,0.697,"principle"],[8.053,0.224,"not"],[8.289,0.132,"on"],[8.434,0.5,"avoiding"],[8.947,0.158,"all"],[9.118,0.474,"pain"],[10.013,0.526,"Avoiding"],[10.553,0.211,"all"],[10.776,0.382,"pain"],[11.171,0.329,"isn't"],[11.513,0.145,"one"],[11.671,0.092,"of"],[11.776,0.105,"the"],[11.895,0.553,"choices"],[12.461,0.132,"on"],[12.605,0.092,"the"],[12.711,0.553,"table"]]},{"s":"B","start":445.728,"end":449.28,"text":"Lesson five: seek wisdom when you're lost.","L":["L5"],"words":[[0.092,0.303,"Lesson"],[0.408,0.474,"five"],[1.513,0.316,"seek"],[1.842,0.487,"wisdom"],[2.342,0.145,"when"],[2.5,0.132,"you're"],[2.645,0.526,"lost"]]},{"s":"A","start":449.568,"end":460.296,"text":"Arjuna could have decided alone and gone home. Instead, he turns to the person beside him, Krishna, and asks. The whole Gita is the answer to that question.","L":["L5"],"words":[[0.105,0.5,"Arjuna"],[0.618,0.171,"could"],[0.803,0.118,"have"],[0.934,0.526,"decided"],[1.474,0.408,"alone"],[1.895,0.105,"and"],[2.013,0.25,"gone"],[2.276,0.487,"home"],[3.184,0.539,"Instead"],[3.75,0.132,"he"],[3.895,0.342,"turns"],[4.25,0.105,"to"],[4.368,0.118,"the"],[4.5,0.434,"person"],[4.947,0.434,"beside"],[5.395,0.263,"him"],[5.697,0.579,"Krishna"],[6.5,0.158,"and"],[6.671,0.645,"asks"],[7.75,0.066,"The"],[7.829,0.276,"whole"],[8.118,0.461,"Gita"],[8.592,0.158,"is"],[8.763,0.118,"the"],[8.895,0.408,"answer"],[9.316,0.118,"to"],[9.447,0.224,"that"],[9.684,0.658,"question"]]},{"s":"B","start":460.584,"end":474.264,"text":"For us, that means when a big life question hits, talk to mentors, counselors, wise people who can see what we can't. Arjuna had the best guide there could be, sitting in the driver's seat the whole time. He just had to ask.","L":["L5"],"words":[[0.092,0.263,"For"],[0.368,0.303,"us"],[0.697,0.224,"that"],[0.934,0.342,"means"],[1.289,0.145,"when"],[1.447,0.092,"a"],[1.553,0.224,"big"],[1.789,0.25,"life"],[2.053,0.395,"question"],[2.461,0.395,"hits"],[2.882,0.263,"talk"],[3.158,0.092,"to"],[3.263,0.553,"mentors"],[3.842,0.618,"counselors"],[4.487,0.329,"wise"],[4.829,0.276,"people"],[5.118,0.118,"who"],[5.25,0.118,"can"],[5.382,0.237,"see"],[5.632,0.132,"what"],[5.776,0.105,"we"],[5.895,0.474,"can't"],[6.763,0.474,"Arjuna"],[7.25,0.211,"had"],[7.474,0.092,"the"],[7.579,0.289,"best"],[7.882,0.342,"guide"],[8.237,0.158,"there"],[8.408,0.197,"could"],[8.618,0.355,"be"],[9.5,0.408,"sitting"],[9.921,0.092,"in"],[10.026,0.079,"the"],[10.118,0.513,"driver's"],[10.645,0.303,"seat"],[10.961,0.079,"the"],[11.053,0.224,"whole"],[11.289,0.447,"time"],[12.132,0.079,"He"],[12.224,0.211,"just"],[12.447,0.184,"had"],[12.645,0.079,"to"],[12.737,0.553,"ask"]]},{"s":"A","start":475.128,"end":479.016,"text":"Lesson six: your role and responsibility matter.","L":["L6"],"words":[[0.092,0.461,"Lesson"],[0.566,0.513,"six"],[1.329,0.171,"your"],[1.513,0.355,"role"],[1.882,0.132,"and"],[2.026,0.947,"responsibility"],[2.987,0.5,"matter"]]},{"s":"B","start":479.304,"end":490.344,"text":"Arjuna is a warrior. In his world, his duty is to protect people from injustice. That role isn't a costume he can take off when it gets uncomfortable.","L":["L6"],"words":[[0.053,0.566,"Arjuna"],[0.632,0.197,"is"],[0.842,0.092,"a"],[0.947,0.632,"warrior"],[1.987,0.092,"In"],[2.092,0.197,"his"],[2.303,0.592,"world"],[3.079,0.461,"his"],[3.553,0.474,"duty"],[4.039,0.197,"is"],[4.25,0.118,"to"],[4.382,0.5,"protect"],[4.895,0.355,"people"],[5.263,0.224,"from"],[5.5,0.789,"injustice"],[6.697,0.25,"That"],[6.961,0.368,"role"],[7.355,0.289,"isn't"],[7.658,0.066,"a"],[7.737,0.592,"costume"],[8.342,0.158,"he"],[8.513,0.132,"can"],[8.658,0.25,"take"],[8.921,0.355,"off"],[9.289,0.158,"when"],[9.461,0.092,"it"],[9.566,0.25,"gets"],[9.829,0.829,"uncomfortable"]]},{"s":"A","start":490.632,"end":507.408,"text":"So the lesson is to understand your role in life and the responsibilities that come with it, as a parent, a partner, a friend, at work. And to remember that avoiding your duties has consequences too. Walking away is also a choice, and other people live with it.","L":["L6"],"words":[[0.092,0.145,"So"],[0.25,0.145,"the"],[0.408,0.434,"lesson"],[0.855,0.158,"is"],[1.026,0.118,"to"],[1.158,0.632,"understand"],[1.803,0.145,"your"],[1.961,0.237,"role"],[2.211,0.132,"in"],[2.355,0.368,"life"],[2.816,0.079,"and"],[2.908,0.092,"the"],[3.013,1.039,"responsibilities"],[4.066,0.171,"that"],[4.25,0.237,"come"],[4.5,0.197,"with"],[4.711,0.211,"it"],[5.184,0.118,"as"],[5.316,0.066,"a"],[5.395,0.487,"parent"],[6.105,0.066,"a"],[6.184,0.566,"partner"],[7.026,0.039,"a"],[7.079,0.421,"friend"],[7.526,0.132,"at"],[7.671,0.487,"work"],[8.592,0.145,"And"],[8.75,0.132,"to"],[8.895,0.513,"remember"],[9.421,0.171,"that"],[9.605,0.461,"avoiding"],[10.079,0.158,"your"],[10.25,0.487,"duties"],[10.75,0.184,"has"],[10.947,0.908,"consequences"],[11.868,0.408,"too"],[12.697,0.421,"Walking"],[13.132,0.316,"away"],[13.461,0.171,"is"],[13.645,0.342,"also"],[14.0,0.079,"a"],[14.092,0.513,"choice"],[14.829,0.197,"and"],[15.039,0.211,"other"],[15.263,0.355,"people"],[15.632,0.237,"live"],[15.882,0.197,"with"],[16.092,0.289,"it"]]},{"s":"B","start":508.272,"end":512.976,"text":"Lesson seven: compassion doesn't mean avoiding hard choices.","L":["L7"],"words":[[0.092,0.355,"Lesson"],[0.461,0.434,"seven"],[1.566,0.645,"compassion"],[2.224,0.316,"doesn't"],[2.553,0.276,"mean"],[2.842,0.487,"avoiding"],[3.342,0.289,"hard"],[3.645,0.658,"choices"]]},{"s":"A","start":513.264,"end":522.816,"text":"Arjuna loved the people across the field. That love was good. But loving them didn't mean he could ignore what they had done or what would happen if they won.","L":["L7"],"words":[[0.092,0.513,"Arjuna"],[0.618,0.316,"loved"],[0.947,0.079,"the"],[1.039,0.408,"people"],[1.461,0.368,"across"],[1.842,0.105,"the"],[1.961,0.513,"field"],[2.908,0.171,"That"],[3.092,0.25,"love"],[3.355,0.197,"was"],[3.566,0.395,"good"],[4.395,0.145,"But"],[4.553,0.342,"loving"],[4.908,0.158,"them"],[5.079,0.289,"didn't"],[5.382,0.224,"mean"],[5.618,0.158,"he"],[5.789,0.158,"could"],[5.961,0.434,"ignore"],[6.408,0.158,"what"],[6.579,0.118,"they"],[6.711,0.211,"had"],[6.934,0.355,"done"],[7.605,0.118,"or"],[7.737,0.158,"what"],[7.908,0.118,"would"],[8.039,0.395,"happen"],[8.447,0.132,"if"],[8.592,0.132,"they"],[8.737,0.421,"won"]]},{"s":"B","start":523.104,"end":534.6,"text":"Being kind and caring doesn't require you to abandon what's right. Sometimes the most caring thing is the hardest one. Krishna will push that point much further in Chapter Two.","L":["L7"],"words":[[0.079,0.224,"Being"],[0.316,0.526,"kind"],[0.855,0.145,"and"],[1.013,0.5,"caring"],[1.526,0.329,"doesn't"],[1.868,0.461,"require"],[2.342,0.237,"you"],[2.592,0.158,"to"],[2.763,0.539,"abandon"],[3.316,0.263,"what's"],[3.592,0.408,"right"],[4.408,0.592,"Sometimes"],[5.013,0.092,"the"],[5.118,0.303,"most"],[5.434,0.382,"caring"],[5.829,0.289,"thing"],[6.132,0.211,"is"],[6.355,0.092,"the"],[6.461,0.513,"hardest"],[6.987,0.355,"one"],[7.763,0.434,"Krishna"],[8.211,0.184,"will"],[8.408,0.355,"push"],[8.776,0.237,"that"],[9.026,0.316,"point"],[9.355,0.25,"much"],[9.618,0.487,"further"],[10.118,0.145,"in"],[10.276,0.421,"Chapter"],[10.711,0.382,"Two"]]},{"s":"A","start":535.464,"end":542.328,"text":"And lesson eight, the one the whole chapter builds to: the beginning of wisdom is admitting what you don't know.","L":["L8"],"words":[[0.105,0.132,"And"],[0.25,0.421,"lesson"],[0.684,0.329,"eight"],[1.316,0.132,"the"],[1.461,0.237,"one"],[1.711,0.079,"the"],[1.803,0.263,"whole"],[2.079,0.474,"chapter"],[2.566,0.368,"builds"],[2.947,0.224,"to"],[3.684,0.118,"the"],[3.816,0.487,"beginning"],[4.316,0.132,"of"],[4.461,0.434,"wisdom"],[4.921,0.145,"is"],[5.079,0.447,"admitting"],[5.539,0.171,"what"],[5.724,0.079,"you"],[5.816,0.263,"don't"],[6.092,0.382,"know"]]},{"s":"B","start":542.616,"end":551.352,"text":"Arjuna laid down his weapons and in effect said, I don't know what to do. That admission is what opened the door to Krishna's teaching.","L":["L8","L3"],"words":[[0.092,0.487,"Arjuna"],[0.592,0.25,"laid"],[0.855,0.224,"down"],[1.092,0.158,"his"],[1.263,0.566,"weapons"],[1.842,0.158,"and"],[2.013,0.105,"in"],[2.132,0.382,"effect"],[2.526,0.434,"said"],[3.566,0.118,"I"],[3.697,0.145,"don't"],[3.855,0.118,"know"],[3.987,0.132,"what"],[4.132,0.092,"to"],[4.237,0.368,"do"],[5.0,0.211,"That"],[5.224,0.553,"admission"],[5.789,0.211,"is"],[6.013,0.224,"what"],[6.263,0.368,"opened"],[6.645,0.092,"the"],[6.75,0.382,"door"],[7.145,0.132,"to"],[7.289,0.5,"Krishna's"],[7.803,0.553,"teaching"]]},{"s":"A","start":551.64,"end":560.832,"text":"Confidence without wisdom is dangerou