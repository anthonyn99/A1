303,"door"],[0.826,0.158,"is"],[0.997,0.303,"open"],[1.313,0.158,"to"],[1.484,0.605,"everyone"],[2.379,0.382,"whatever"],[2.774,0.237,"name"],[3.024,0.132,"they"],[3.168,0.579,"use"],[4.13,0.224,"The"],[4.366,0.25,"only"],[4.63,0.579,"question"],[5.222,0.197,"is"],[5.432,0.197,"what"],[5.643,0.184,"they're"],[5.84,0.447,"asking"],[6.301,0.395,"for"]]},{"s":"A","start":326.352,"end":347.208,"text":"Then two verses this rendition reads in its own way. Seven point twenty-four and twenty-five: the ignorant, unable to understand My immutable, incomparable, transcendental form, assume that I am formless, or that I take form just as humans do. Concealed by My Maya, I do not reveal Myself to them.","L":["L6"],"words":[[0.142,0.289,"Then"],[0.445,0.263,"two"],[0.721,0.618,"verses"],[1.353,0.224,"this"],[1.589,0.618,"rendition"],[2.221,0.368,"reads"],[2.603,0.092,"in"],[2.708,0.184,"its"],[2.905,0.211,"own"],[3.129,0.434,"way"],[3.945,0.447,"Seven"],[4.406,0.276,"point"],[4.695,0.605,"twenty-four"],[5.314,0.092,"and"],[5.419,0.816,"twenty-five"],[6.564,0.105,"the"],[6.682,0.566,"ignorant"],[7.432,0.382,"unable"],[7.827,0.118,"to"],[7.959,0.684,"understand"],[8.656,0.145,"My"],[8.814,0.711,"immutable"],[9.722,0.816,"incomparable"],[10.735,0.829,"transcendental"],[11.577,0.434,"form"],[12.393,0.395,"assume"],[12.801,0.171,"that"],[12.985,0.079,"I"],[13.077,0.145,"am"],[13.235,0.632,"formless"],[14.116,0.079,"or"],[14.209,0.158,"that"],[14.38,0.079,"I"],[14.472,0.276,"take"],[14.761,0.408,"form"],[15.182,0.276,"just"],[15.472,0.092,"as"],[15.577,0.421,"humans"],[16.011,0.342,"do"],[16.736,0.697,"Concealed"],[17.446,0.132,"by"],[17.591,0.171,"My"],[17.775,0.526,"Maya"],[18.578,0.105,"I"],[18.696,0.158,"do"],[18.867,0.25,"not"],[19.13,0.382,"reveal"],[19.525,0.487,"Myself"],[20.025,0.118,"to"],[20.157,0.316,"them"]]},{"s":"B","start":347.496,"end":362.352,"text":"Translators read these two verses differently. Some stress God's unmanifest nature, some God's personal form. We're giving you this book's reading, which is that God's real form is beyond both of our usual ideas.","L":["L6"],"words":[[0.092,0.75,"Translators"],[0.855,0.382,"read"],[1.25,0.25,"these"],[1.513,0.25,"two"],[1.776,0.461,"verses"],[2.25,0.671,"differently"],[3.342,0.25,"Some"],[3.605,0.434,"stress"],[4.053,0.447,"God's"],[4.513,0.776,"unmanifest"],[5.303,0.487,"nature"],[6.316,0.289,"some"],[6.618,0.447,"God's"],[7.079,0.434,"personal"],[7.526,0.461,"form"],[8.408,0.158,"We're"],[8.579,0.303,"giving"],[8.895,0.211,"you"],[9.118,0.211,"this"],[9.342,0.303,"book's"],[9.658,0.487,"reading"],[10.421,0.276,"which"],[10.711,0.118,"is"],[10.842,0.237,"that"],[11.092,0.368,"God's"],[11.474,0.237,"real"],[11.724,0.395,"form"],[12.132,0.184,"is"],[12.329,0.474,"beyond"],[12.816,0.316,"both"],[13.145,0.132,"of"],[13.289,0.132,"our"],[13.434,0.434,"usual"],[13.882,0.592,"ideas"]]},{"s":"A","start":362.64,"end":385.464,"text":"Seven point twenty-six: I know the beings of the past, the present and the future, but no one really knows Me. And twenty-seven and twenty-eight: all beings are deluded by the pairs of opposites, born of likes and dislikes. But persons of unselfish deeds, whose Karma has come to an end, become free from that delusion and worship Me with firm resolve.","L":["L6"],"words":[[0.129,0.408,"Seven"],[0.55,0.303,"point"],[0.866,0.829,"twenty-six"],[2.037,0.066,"I"],[2.116,0.276,"know"],[2.405,0.132,"the"],[2.55,0.329,"beings"],[2.892,0.092,"of"],[2.997,0.105,"the"],[3.116,0.539,"past"],[3.853,0.092,"the"],[3.958,0.474,"present"],[4.445,0.079,"and"],[4.537,0.092,"the"],[4.642,0.539,"future"],[5.471,0.197,"but"],[5.682,0.211,"no"],[5.905,0.237,"one"],[6.155,0.289,"really"],[6.458,0.316,"knows"],[6.787,0.25,"Me"],[7.461,0.132,"And"],[7.605,0.711,"twenty-seven"],[8.329,0.092,"and"],[8.434,0.724,"twenty-eight"],[9.526,0.211,"all"],[9.75,0.421,"beings"],[10.184,0.053,"are"],[10.25,0.592,"deluded"],[10.855,0.132,"by"],[11.0,0.118,"the"],[11.132,0.303,"pairs"],[11.447,0.105,"of"],[11.566,0.658,"opposites"],[12.5,0.263,"born"],[12.776,0.092,"of"],[12.882,0.421,"likes"],[13.316,0.079,"and"],[13.408,0.763,"dislikes"],[14.566,0.211,"But"],[14.789,0.539,"persons"],[15.342,0.118,"of"],[15.474,0.645,"unselfish"],[16.132,0.447,"deeds"],[16.829,0.171,"whose"],[17.013,0.395,"Karma"],[17.421,0.184,"has"],[17.618,0.224,"come"],[17.855,0.132,"to"],[18.0,0.105,"an"],[18.118,0.342,"end"],[18.763,0.329,"become"],[19.105,0.276,"free"],[19.395,0.184,"from"],[19.592,0.197,"that"],[19.803,0.632,"delusion"],[20.447,0.171,"and"],[20.632,0.5,"worship"],[21.145,0.158,"Me"],[21.316,0.184,"with"],[21.513,0.316,"firm"],[21.842,0.592,"resolve"]]},{"s":"B","start":385.752,"end":399.648,"text":"And the chapter closes with a hint of what's next. Those who know Me as everything, even at the time of death, attain Me. Which is exactly where Chapter Eight begins: what happens at death?","L":["L7"],"words":[[0.079,0.118,"And"],[0.211,0.079,"the"],[0.303,0.461,"chapter"],[0.776,0.645,"closes"],[1.434,0.197,"with"],[1.645,0.053,"a"],[1.711,0.382,"hint"],[2.118,0.158,"of"],[2.289,0.276,"what's"],[2.579,0.539,"next"],[3.513,0.25,"Those"],[3.776,0.132,"who"],[3.921,0.224,"know"],[4.158,0.197,"Me"],[4.368,0.171,"as"],[4.553,0.645,"everything"],[5.671,0.329,"even"],[6.013,0.118,"at"],[6.145,0.079,"the"],[6.237,0.316,"time"],[6.566,0.132,"of"],[6.711,0.487,"death"],[7.632,0.474,"attain"],[8.118,0.289,"Me"],[8.829,0.158,"Which"],[9.0,0.118,"is"],[9.132,0.592,"exactly"],[9.737,0.263,"where"],[10.013,0.5,"Chapter"],[10.526,0.263,"Eight"],[10.803,0.645,"begins"],[12.171,0.197,"what"],[12.382,0.474,"happens"],[12.868,0.132,"at"],[13.013,0.487,"death"]]},{"s":"A","start":400.512,"end":404.688,"text":"Lesson one: God is the source and substance of everything.","L":["L1"],"words":[[0.129,0.408,"Lesson"],[0.55,0.355,"one"],[1.247,0.276,"God"],[1.537,0.145,"is"],[1.695,0.132,"the"],[1.839,0.434,"source"],[2.287,0.118,"and"],[2.418,0.605,"substance"],[3.037,0.092,"of"],[3.142,0.645,"everything"]]},{"s":"B","start":404.976,"end":414.696,"text":"Matter, energy, consciousness: all of it comes from God. The whole universe is strung on the Supreme like jewels on a thread.","L":["L1"],"words":[[0.052,0.579,"Matter"],[0.894,0.658,"energy"],[1.749,0.934,"consciousness"],[3.341,0.263,"all"],[3.618,0.092,"of"],[3.723,0.118,"it"],[3.855,0.289,"comes"],[4.157,0.197,"from"],[4.368,0.461,"God"],[5.237,0.066,"The"],[5.316,0.289,"whole"],[5.618,0.592,"universe"],[6.224,0.132,"is"],[6.368,0.5,"strung"],[6.882,0.171,"on"],[7.066,0.079,"the"],[7.158,0.618,"Supreme"],[7.789,0.224,"like"],[8.026,0.5,"jewels"],[8.539,0.158,"on"],[8.711,0.079,"a"],[8.803,0.526,"thread"]]},{"s":"A","start":414.984,"end":426.144,"text":"Nothing exists on its own. And the practical side is lovely: you can notice God in the taste of water, in the light of the sun, in the strength of someone strong and kind.","L":["L1"],"words":[[0.142,0.434,"Nothing"],[0.589,0.579,"exists"],[1.182,0.145,"on"],[1.339,0.211,"its"],[1.563,0.421,"own"],[2.382,0.132,"And"],[2.526,0.105,"the"],[2.645,0.553,"practical"],[3.211,0.342,"side"],[3.566,0.132,"is"],[3.711,0.487,"lovely"],[4.539,0.092,"you"],[4.645,0.171,"can"],[4.829,0.447,"notice"],[5.289,0.289,"God"],[5.592,0.092,"in"],[5.697,0.092,"the"],[5.803,0.342,"taste"],[6.158,0.092,"of"],[6.263,0.474,"water"],[6.987,0.105,"in"],[7.105,0.092,"the"],[7.211,0.276,"light"],[7.5,0.092,"of"],[7.605,0.105,"the"],[7.724,0.395,"sun"],[8.395,0.105,"in"],[8.513,0.092,"the"],[8.618,0.474,"strength"],[9.105,0.092,"of"],[9.211,0.382,"someone"],[9.605,0.434,"strong"],[10.053,0.118,"and"],[10.184,0.579,"kind"]]},{"s":"B","start":426.432,"end":438.912,"text":"A small practice from us, not the book. Once a day, pick one ordinary thing, the warmth of the sun, the taste of water, and pause for one breath to remember the thread.","L":[],"words":[[0.053,0.066,"A"],[0.132,0.382,"small"],[0.526,0.526,"practice"],[1.066,0.237,"from"],[1.316,0.276,"us"],[1.605,0.342,"not"],[1.961,0.105,"the"],[2.079,0.474,"book"],[2.974,0.25,"Once"],[3.237,0.066,"a"],[3.316,0.382,"day"],[4.25,0.25,"pick"],[4.513,0.303,"one"],[4.829,0.513,"ordinary"],[5.355,0.355,"thing"],[6.303,0.118,"the"],[6.434,0.395,"warmth"],[6.842,0.079,"of"],[6.934,0.079,"the"],[7.026,0.447,"sun"],[8.053,0.092,"the"],[8.158,0.342,"taste"],[8.513,0.092,"of"],[8.618,0.447,"water"],[9.618,0.092,"and"],[9.724,0.434,"pause"],[10.171,0.171,"for"],[10.355,0.25,"one"],[10.618,0.382,"breath"],[11.013,0.118,"to"],[11.145,0.382,"remember"],[11.539,0.092,"the"],[11.645,0.447,"thread"]]},{"s":"B","start":439.776,"end":446.304,"text":"Lesson two: God has two natures, a lower one, matter, and a higher one, Spirit.","L":["L2"],"words":[[0.066,0.355,"Lesson"],[0.434,0.382,"two"],[1.0,0.303,"God"],[1.316,0.237,"has"],[1.566,0.184,"two"],[1.763,0.645,"natures"],[2.789,0.118,"a"],[2.921,0.382,"lower"],[3.316,0.421,"one"],[4.013,0.539,"matter"],[4.566,0.132,"and"],[4.711,0.039,"a"],[4.763,0.382,"higher"],[5.158,0.355,"one"],[5.526,0.618,"Spirit"]]},{"s":"A","start":446.592,"end":459.288,"text":"The lower nature is the material world: earth, water, fire, air, ether, and also mind, intellect and ego. The higher nature is the living Spirit that holds it all up.","L":["L2"],"words":[[0.142,0.092,"The"],[0.247,0.289,"lower"],[0.55,0.513,"nature"],[1.076,0.145,"is"],[1.234,0.092,"the"],[1.339,0.579,"material"],[1.932,0.421,"world"],[2.695,0.408,"earth"],[3.313,0.526,"water"],[4.089,0.513,"fire"],[4.813,0.289,"air"],[5.366,0.447,"ether"],[6.05,0.158,"and"],[6.221,0.342,"also"],[6.576,0.408,"mind"],[7.208,0.539,"intellect"],[7.761,0.118,"and"],[7.892,0.487,"ego"],[8.803,0.092,"The"],[8.908,0.342,"higher"],[9.263,0.579,"nature"],[9.855,0.184,"is"],[10.053,0.105,"the"],[10.171,0.355,"living"],[10.539,0.553,"Spirit"],[11.105,0.145,"that"],[11.263,0.316,"holds"],[11.592,0.145,"it"],[11.75,0.197,"all"],[11.961,0.355,"up"]]},{"s":"B","start":459.576,"end":470.232,"text":"Understanding both is the key to understanding reality, and to understanding yourself. You have a body and a mind, and you are the awareness that knows them.","L":["L2"],"words":[[0.092,0.684,"Understanding"],[0.789,0.382,"both"],[1.197,0.224,"is"],[1.434,0.118,"the"],[1.566,0.342,"key"],[1.921,0.158,"to"],[2.092,0.711,"understanding"],[2.816,0.671,"reality"],[3.816,0.25,"and"],[4.079,0.145,"to"],[4.237,0.684,"understanding"],[4.934,0.671,"yourself"],[6.026,0.092,"You"],[6.132,0.158,"have"],[6.303,0.092,"a"],[6.408,0.487,"body"],[6.908,0.118,"and"],[7.039,0.053,"a"],[7.105,0.592,"mind"],[7.987,0.237,"and"],[8.237,0.25,"you"],[8.5,0.184,"are"],[8.697,0.079,"the"],[8.789,0.645,"awareness"],[9.447,0.171,"that"],[9.632,0.303,"knows"],[9.947,0.316,"them"]]},{"s":"A","start":471.096,"end":476.928,"text":"Lesson three: Maya, the divine illusion, is extremely difficult to overcome.","L":["L3"],"words":[[0.116,0.447,"Lesson"],[0.576,0.421,"three"],[1.313,0.474,"Maya"],[1.997,0.118,"the"],[2.129,0.421,"divine"],[2.563,0.566,"illusion"],[3.353,0.118,"is"],[3.484,0.592,"extremely"],[4.089,0.539,"difficult"],[4.642,0.118,"to"],[4.774,0.671,"overcome"]]},{"s":"B","start":477.216,"end":484.584,"text":"The three modes of nature delude almost everyone. Only those who surrender to God can cross beyond them.","L":["L3"],"words":[[0.066,0.105,"The"],[0.184,0.342,"three"],[0.539,0.421,"modes"],[0.974,0.145,"of"],[1.132,0.447,"nature"],[1.592,0.579,"delude"],[2.197,0.447,"almost"],[2.658,0.618,"everyone"],[3.697,0.303,"Only"],[4.013,0.316,"those"],[4.342,0.158,"who"],[4.513,0.592,"surrender"],[5.118,0.118,"to"],[5.25,0.395,"God"],[5.658,0.184,"can"],[5.855,0.408,"cross"],[6.276,0.395,"beyond"],[6.684,0.303,"them"]]},{"s":"A","start":484.872,"end":497.16,"text":"And notice what Krishna doesn't say. He doesn't say you can out-think Maya, or out-muscle it. Willpower and intellect alone aren't enough. Surrender is the way across.","L":["L3"],"words":[[0.142,0.171,"And"],[0.326,0.526,"notice"],[0.866,0.211,"what"],[1.089,0.447,"Krishna"],[1.55,0.355,"doesn't"],[1.918,0.474,"say"],[2.803,0.118,"He"],[2.934,0.355,"doesn't"],[3.303,0.224,"say"],[3.539,0.132,"you"],[3.684,0.171,"can"],[3.868,0.461,"out-think"],[4.342,0.487,"Maya"],[5.079,0.184,"or"],[5.276,0.632,"out-muscle"],[5.921,0.342,"it"],[6.658,0.816,"Willpower"],[7.487,0.184,"and"],[7.684,0.566,"intellect"],[8.263,0.434,"alone"],[8.711,0.237,"aren't"],[8.961,0.539,"enough"],[9.908,0.724,"Surrender"],[10.645,0.171,"is"],[10.829,0.105,"the"],[10.947,0.25,"way"],[11.211,0.684,"across"]]},{"s":"B","start":497.448,"end":505.848,"text":"It's a bit like trying to swim out of a strong current by force. You tire. But if you take the hand of someone on the bank, you're out.","L":[],"words":[[0.05,0.145,"It's"],[0.208,0.066,"a"],[0.287,0.237,"bit"],[0.537,0.211,"like"],[0.761,0.276,"trying"],[1.05,0.053,"to"],[1.116,0.513,"swim"],[1.655,0.171,"out"],[1.839,0.079,"of"],[1.932,0.053,"a"],[1.997,0.447,"strong"],[2.458,0.368,"current"],[2.839,0.158,"by"],[3.011,0.566,"force"],[3.961,0.118,"You"],[4.092,0.539,"tire"],[5.039,0.132,"But"],[5.184,0.118,"if"],[5.316,0.105,"you"],[5.434,0.276,"take"],[5.724,0.092,"the"],[5.829,0.316,"hand"],[6.158,0.079,"of"],[6.25,0.382,"someone"],[6.645,0.132,"on"],[6.789,0.092,"the"],[6.895,0.434,"bank"],[7.355,0.237,"you're"],[7.605,0.408,"out"]]},{"s":"B","start":506.712,"end":510.648,"text":"Lesson four: four types of people seek God.","L":["L4"],"words":[[0.052,0.447,"Lesson"],[0.512,0.5,"four"],[1.565,0.342,"four"],[1.92,0.408,"types"],[2.341,0.118,"of"],[2.473,0.316,"people"],[2.802,0.289,"seek"],[3.105,0.434,"God"]]},{"s":"A","start":510.936,"end":518.832,"text":"The one in distress, the one curious for knowledge, the one seeking wealth, and the wise one who has already tasted the Supreme.","L":["L4"],"words":[[0.142,0.092,"The"],[0.247,0.224,"one"],[0.484,0.105,"in"],[0.603,0.697,"distress"],[1.537,0.079,"the"],[1.629,0.237,"one"],[1.879,0.487,"curious"],[2.379,0.105,"for"],[2.497,0.553,"knowledge"],[3.287,0.079,"the"],[3.379,0.237,"one"],[3.629,0.421,"seeking"],[4.063,0.434,"wealth"],[4.8,0.092,"and"],[4.905,0.092,"the"],[5.011,0.355,"wise"],[5.379,0.237,"one"],[5.629,0.118,"who"],[5.761,0.145,"has"],[5.918,0.382,"already"],[6.313,0.461,"tasted"],[6.787,0.092,"the"],[6.892,0.618,"Supreme"]]},{"s":"B","start":519.12,"end":529.032,"text":"All are noble. But the enlightened devotee, with single-minded love, is the highest. They are dear to God, and God is dear to them.","L":["L4"],"words":[[0.079,0.145,"All"],[0.237,0.105,"are"],[0.355,0.579,"noble"],[1.368,0.145,"But"],[1.526,0.066,"the"],[1.605,0.618,"enlightened"],[2.237,0.684,"devotee"],[2.947,0.211,"with"],[3.171,0.816,"single-minded"],[4.0,0.434,"love"],[4.934,0.224,"is"],[5.171,0.092,"the"],[5.276,0.697,"highest"],[6.368,0.118,"They"],[6.5,0.132,"are"],[6.645,0.303,"dear"],[6.961,0.118,"to"],[7.092,0.526,"God"],[8.0,0.211,"and"],[8.224,0.316,"God"],[8.553,0.171,"is"],[8.737,0.276,"dear"],[9.026,0.132,"to"],[9.171,0.342,"them"]]},{"s":"A","start":529.32,"end":538.272,"text":"And the distressed one can become the enlightened one. People often start in the first group and end up in the fourth. That's the path.","L":[],"words":[[0.116,0.158,"And"],[0.287,0.118,"the"],[0.418,0.566,"distressed"],[0.997,0.303,"one"],[1.313,0.197,"can"],[1.524,0.395,"become"],[1.932,0.105,"the"],[2.05,0.618,"enlightened"],[2.682,0.382,"one"],[3.445,0.487,"People"],[3.945,0.368,"often"],[4.327,0.408,"start"],[4.748,0.092,"in"],[4.853,0.092,"the"],[4.959,0.408,"first"],[5.38,0.355,"group"],[5.748,0.184,"and"],[5.945,0.197,"end"],[6.156,0.145,"up"],[6.314,0.092,"in"],[6.419,0.092,"the"],[6.524,0.566,"fourth"],[7.513,0.329,"That's"],[7.855,0.118,"the"],[7.987,0.566,"path"]]},{"s":"A","start":539.136,"end":544.008,"text":"Lesson five: God fulfills every seeker according to their faith.","L":["L5"],"words":[[0.116,0.421,"Lesson"],[0.55,0.539,"five"],[1.405,0.263,"God"],[1.682,0.632,"fulfills"],[2.326,0.289,"every"],[2.629,0.5,"seeker"],[3.142,0.487,"according"],[3.642,0.118,"to"],[3.774,0.145,"their"],[3.932,0.553,"faith"]]},{"s":"B","start":544.296,"end":554.52,"text":"Whatever form a person worships sincerely, God makes that faith steady and answers through it. All sincere worship reaches the Supreme in the end.","L":["L5"],"words":[[0.092,0.342,"Whatever"],[0.447,0.355,"form"],[0.816,0.079,"a"],[0.908,0.395,"person"],[1.316,0.434,"worships"],[1.763,0.829,"sincerely"],[3.145,0.395,"God"],[3.553,0.276,"makes"],[3.842,0.211,"that"],[4.066,0.355,"faith"],[4.434,0.487,"steady"],[4.934,0.132,"and"],[5.079,0.487,"answers"],[5.579,0.224,"through"],[5.816,0.25,"it"],[6.487,0.197,"All"],[6.697,0.579,"sincere"],[7.289,0.553,"worship"],[7.855,0.487,"reaches"],[8.355,0.092,"the"],[8.461,0.632,"Supreme"],[9.118,0.158,"in"],[9.289,0.066,"the"],[9.368,0.474,"end"]]},{"s":"A","start":554.808,"end":564.264,"text":"But if what you ask for is material, what you get is temporary. The worship reaches God either way. The question is what you're asking for.","L":["L5"],"words":[[0.101,0.211,"But"],[0.324,0.158,"if"],[0.495,0.224,"what"],[0.732,0.158,"you"],[0.903,0.316,"ask"],[1.232,0.197,"for"],[1.443,0.145,"is"],[1.601,0.711,"material"],[2.601,0.197,"what"],[2.811,0.105,"you"],[2.93,0.237,"get"],[3.18,0.118,"is"],[3.311,0.605,"temporary"],[4.342,0.105,"The"],[4.461,0.553,"worship"],[5.026,0.447,"reaches"],[5.487,0.303,"God"],[5.803,0.276,"either"],[6.092,0.447,"way"],[6.961,0.105,"The"],[7.079,0.539,"question"],[7.632,0.158,"is"],[7.803,0.211,"what"],[8.026,0.158,"you're"],[8.197,0.461,"asking"],[8.671,0.395,"for"]]},{"s":"B","start":565.128,"end":569.496,"text":"Lesson six: rare is the one who truly knows God.","L":["L6"],"words":[[0.066,0.355,"Lesson"],[0.434,0.566,"six"],[1.526,0.487,"rare"],[2.026,0.197,"is"],[2.237,0.105,"the"],[2.355,0.276,"one"],[2.645,0.184,"who"],[2.842,0.382,"truly"],[3.237,0.289,"knows"],[3.539,0.434,"God"]]},{"s":"A","start":569.784,"end":578.496,"text":"Among thousands who strive, scarcely one truly understands. Most stay caught in likes and dislikes, pleasure and pain.","L":["L6"],"words":[[0.116,0.342,"Among"],[0.471,0.592,"thousands"],[1.076,0.105,"who"],[1.195,0.605,"strive"],[2.076,0.5,"scarcely"],[2.589,0.276,"one"],[2.879,0.408,"truly"],[3.3,0.908,"understands"],[4.618,0.355,"Most"],[4.987,0.237,"stay"],[5.237,0.368,"caught"],[5.618,0.105,"in"],[5.737,0.368,"likes"],[6.118,0.079,"and"],[6.211,0.724,"dislikes"],[7.171,0.447,"pleasure"],[7.632,0.171,"and"],[7.816,0.5,"pain"]]},{"s":"B","start":578.784,"end":589.632,"text":"Only those whose Karma has been purified by unselfish action come to real understanding. It's rare, but it's not closed. The door is selfless living.","L":["L6"],"words":[[0.092,0.316,"Only"],[0.421,0.289,"those"],[0.724,0.237,"whose"],[0.974,0.461,"Karma"],[1.447,0.211,"has"],[1.671,0.171,"been"],[1.855,0.671,"purified"],[2.539,0.263,"by"],[2.816,0.632,"unselfish"],[3.461,0.487,"action"],[3.961,0.237,"come"],[4.211,0.118,"to"],[4.342,0.342,"real"],[4.697,0.803,"understanding"],[5.879,0.211,"It's"],[6.103,0.487,"rare"],[6.971,0.184,"but"],[7.168,0.158,"it's"],[7.339,0.263,"not"],[7.616,0.605,"closed"],[8.632,0.105,"The"],[8.75,0.408,"door"],[9.171,0.171,"is"],[9.355,0.618,"selfless"],[9.987,0.474,"living"]]},{"s":"A","start":590.496,"end":594.408,"text":"And lesson seven: knowing God means knowing everything.","L":["L7"],"words":[[0.142,0.145,"And"],[0.3,0.395,"lesson"],[0.708,0.461,"seven"],[1.497,0.316,"knowing"],[1.826,0.368,"God"],[2.208,0.329,"means"],[2.55,0.329,"knowing"],[2.892,0.618,"everything"]]},{"s":"B","start":594.696,"end":600.936,"text":"Krishna promises Arjuna complete knowledge, after which nothing more remains to be known.","L":["L7"],"words":[[0.092,0.408,"Krishna"],[0.513,0.579,"promises"],[1.105,0.579,"Arjuna"],[1.697,0.474,"complete"],[2.184,0.632,"knowledge"],[3.316,0.342,"after"],[3.671,0.25,"which"],[3.934,0.382,"nothing"],[4.329,0.289,"more"],[4.632,0.5,"remains"],[5.145,0.105,"to"],[5.263,0.118,"be"],[5.395,0.461,"known"]]},{"s":"A","start":601.224,"end":608.544,"text":"Real knowledge of the Supreme isn't one more fact on the pile. It's the thread that makes sense of all the jewels.","L":["L7"],"words":[[0.129,0.316,"Real"],[0.458,0.421,"knowledge"],[0.892,0.105,"of"],[1.011,0.105,"the"],[1.129,0.658,"Supreme"],[1.8,0.329,"isn't"],[2.142,0.197,"one"],[2.353,0.184,"more"],[2.55,0.434,"fact"],[2.997,0.105,"on"],[3.116,0.079,"the"],[3.208,0.526,"pile"],[4.158,0.197,"It's"],[4.368,0.118,"the"],[4.5,0.434,"thread"],[4.947,0.171,"that"],[5.132,0.303,"makes"],[5.447,0.368,"sense"],[5.829,0.118,"of"],[5.961,0.158,"all"],[6.132,0.105,"the"],[6.25,0.671,"jewels"]]},{"s":"B","start":608.832,"end":616.32,"text":"Which is why the chapter starts with that promise and ends where it does. Know the thread, and every jewel makes sense.","L":[],"words":[[0.092,0.158,"Which"],[0.263,0.132,"is"],[0.408,0.316,"why"],[0.737,0.105,"the"],[0.855,0.474,"chapter"],[1.342,0.474,"starts"],[1.829,0.145,"with"],[1.987,0.211,"that"],[2.211,0.5,"promise"],[2.724,0.158,"and"],[2.895,0.329,"ends"],[3.237,0.197,"where"],[3.447,0.105,"it"],[3.566,0.447,"does"],[4.395,0.25,"Know"],[4.658,0.118,"the"],[4.789,0.553,"thread"],[5.368,0.211,"and"],[5.592,0.316,"every"],[5.921,0.368,"jewel"],[6.303,0.263,"makes"],[6.579,0.513,"sense"]]},{"s":"B","start":617.184,"end":628.68,"text":"So, Chapter Seven. God as the thread through everything, the two natures of reality, the illusion we can only cross by surrender, and the four kinds of people who come looking.","L":["L1","L2","L3","L4"],"words":[[0.051,0.342,"So"],[0.564,0.487,"Chapter"],[1.064,0.539,"Seven"],[2.026,0.368,"God"],[2.408,0.132,"as"],[2.553,0.118,"the"],[2.684,0.421,"thread"],[3.118,0.276,"through"],[3.408,0.645,"everything"],[4.079,0.132,"the"],[4.224,0.211,"two"],[4.447,0.461,"natures"],[4.921,0.105,"of"],[5.039,0.658,"reality"],[6.132,0.079,"the"],[6.224,0.5,"illusion"],[6.737,0.105,"we"],[6.855,0.132,"can"],[7.0,0.289,"only"],[7.303,0.395,"cross"],[7.711,0.132,"by"],[7.855,0.671,"surrender"],[8.855,0.211,"and"],[9.079,0.092,"the"],[9.184,0.329,"four"],[9.526,0.289,"kinds"],[9.829,0.079,"of"],[9.921,0.329,"people"],[10.263,0.118,"who"],[10.395,0.25,"come"],[10.658,0.434,"looking"]]},{"s":"A","start":628.968,"end":638.304,"text":"Seven lessons: the thread, two natures, Maya, four who seek, according to faith, rare understanding, and knowing everything.","L":["L1","L2","L3","L4","L5","L6","L7"],"words":[[0.129,0.382,"Seven"],[0.524,0.618,"lessons"],[1.445,0.092,"the"],[1.55,0.474,"thread"],[2.313,0.197,"two"],[2.524,0.645,"natures"],[3.418,0.5,"Maya"],[4.195,0.171,"four"],[4.379,0.184,"who"],[4.576,0.461,"seek"],[5.261,0.408,"according"],[5.682,0.105,"to"],[5.8,0.474,"faith"],[6.563,0.224,"rare"],[6.8,0.842,"understanding"],[7.839,0.132,"and"],[7.984,0.329,"knowing"],[8.326,0.618,"everything"]]},{"s":"B","start":638.592,"end":646.248,"text":"Next time, Chapter Eight: what we think of at the end, and where it takes us. Thanks for listening to Shruti.","L":[],"words":[[0.092,0.289,"Next"],[0.395,0.382,"time"],[0.789,0.5,"Chapter"],[1.303,0.355,"Eight"],[2.053,0.224,"what"],[2.289,0.145,"we"],[2.447,0.276,"think"],[2.737,0.118,"of"],[2.868,0.132,"at"],[3.013,0.066,"the"],[3.092,0.5,"end"],[3.921,0.224,"and"],[4.158,0.197,"where"],[4.368,0.092,"it"],[4.474,0.316,"takes"],[4.803,0.329,"us"],[5.553,0.342,"Thanks"],[5.908,0.171,"for"],[6.092,0.447,"listening"],[6.553,0.118,"to"],[6.684,0.579,"Shruti"]]}]}