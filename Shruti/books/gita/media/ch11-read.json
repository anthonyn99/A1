 but standing as all in One in the transcendental body of Krishna, the Lord of celestial rulers.","start":70.848,"dur":51.552,"words":[[0.1,0.575,"Sanjaya"],[0.675,0.375,"said"],[1.613,0.138,"O"],[1.762,0.375,"King"],[2.638,0.237,"having"],[2.875,0.225,"said"],[3.112,0.338,"this"],[3.812,0.35,"Lord"],[4.162,0.512,"Krishna"],[5.15,0.087,"the"],[5.25,0.362,"great"],[5.612,0.412,"Lord"],[6.025,0.087,"of"],[6.125,0.087,"the"],[6.225,0.425,"mystic"],[6.662,0.512,"power"],[7.188,0.062,"of"],[7.263,0.412,"yoga"],[8.175,0.45,"revealed"],[8.625,0.15,"His"],[8.787,0.475,"supreme"],[9.275,0.55,"majestic"],[9.838,0.388,"form"],[10.238,0.15,"to"],[10.4,0.613,"Arjuna"],[11.4,0.5,"Arjuna"],[11.912,0.275,"saw"],[12.2,0.062,"the"],[12.275,0.588,"Universal"],[12.863,0.35,"Form"],[13.225,0.087,"of"],[13.325,0.113,"the"],[13.45,0.375,"Lord"],[13.825,0.15,"with"],[13.988,0.388,"many"],[14.387,0.388,"mouths"],[14.787,0.188,"and"],[14.988,0.438,"eyes"],[15.675,0.175,"and"],[15.863,0.325,"many"],[16.2,0.5,"marvelous"],[16.712,0.45,"visions"],[17.163,0.163,"with"],[17.337,0.55,"numerous"],[17.9,0.425,"divine"],[18.337,0.475,"ornaments"],[19.225,0.362,"holding"],[19.587,0.287,"many"],[19.887,0.412,"divine"],[20.312,0.475,"weapons"],[21.2,0.287,"wearing"],[21.488,0.45,"divine"],[21.938,0.562,"garlands"],[22.5,0.113,"and"],[22.613,0.475,"apparel"],[23.525,0.55,"anointed"],[24.087,0.175,"with"],[24.275,0.65,"celestial"],[24.938,0.662,"perfumes"],[25.613,0.163,"and"],[25.788,0.487,"ointments"],[26.675,0.35,"full"],[27.038,0.15,"of"],[27.3,0.25,"all"],[27.562,0.537,"wonders"],[28.512,0.125,"the"],[28.65,0.537,"limitless"],[29.2,0.35,"God"],[29.55,0.212,"with"],[29.775,0.625,"faces"],[30.475,0.225,"on"],[30.712,0.212,"all"],[30.938,0.637,"sides"],[31.962,0.138,"If"],[32.112,0.087,"the"],[32.2,0.562,"splendor"],[32.775,0.075,"of"],[32.862,0.5,"thousands"],[33.375,0.075,"of"],[33.462,0.412,"suns"],[33.888,0.125,"were"],[34.013,0.075,"to"],[34.1,0.463,"blaze"],[34.575,0.375,"forth"],[35.025,0.325,"al