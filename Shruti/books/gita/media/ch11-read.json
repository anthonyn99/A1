n yogic powers — this particular, supreme, shining, universal, infinite, and primal form of Mine that has never been seen before by anyone other than you. O Arjuna, neither by study of the Vedas, nor by sacrifice, nor by charity, nor by rituals, nor by severe austerities, can I be seen in this cosmic form by anyone other than you in this human world.","start":561.0,"dur":42.72,"words":[[0.1,0.113,"I"],[0.225,0.312,"wish"],[0.55,0.075,"to"],[0.637,0.225,"see"],[0.875,0.138,"You"],[1.025,0.125,"with"],[1.15,0.037,"a"],[1.2,0.487,"crown"],[2.15,0.35,"holding"],[2.5,0.362,"mace"],[2.875,0.188,"and"],[3.075,0.5,"discus"],[3.587,0.062,"in"],[3.663,0.113,"Your"],[3.775,0.487,"hand"],[4.662,0.625,"Therefore"],[5.688,0.1,"O"],[5.787,0.525,"Lord"],[6.688,0.163,"with"],[6.862,0.55,"thousand"],[7.425,0.425,"arms"],[7.862,0.175,"and"],[8.05,0.537,"universal"],[8.6,0.4,"form"],[9.45,0.275,"please"],[9.738,0.562,"appear"],[10.312,0.125,"in"],[10.45,0.087,"the"],[10.537,0.65,"four-armed"],[11.2,0.487,"form"],[12.075,0.062,"The"],[12.137,0.5,"Supreme"],[12.65,0.287,"Lord"],[12.95,0.375,"said"],[13.912,0.138,"O"],[14.05,0.537,"Arjuna"],[14.975,0.237,"being"],[15.225,0.35,"pleased"],[15.588,0.113,"with"],[15.7,0.163,"you"],[15.875,0.113,"I"],[15.988,0.075,"have"],[16.075,0.325,"shown"],[16.413,0.212,"you"],[17.05,0.125,"through"],[17.188,0.212,"My"],[17.413,0.225,"own"],[17.65,0.312,"yogic"],[17.975,0.512,"powers"],[18.9,0.188,"this"],[19.1,0.613,"particular"],[19.95,0.625,"supreme"],[20.962,0.537,"shining"],[21.887,0.613,"universal"],[22.938,0.525,"infinite"],[23.538,0.15,"and"],[23.7,0.475,"primal"],[24.188,0.338,"form"],[24.538,0.1,"of"],[24.65,0.412,"Mine"],[25.075,0.087,"that"],[25.163,0.15,"has"],[25.325,0.338,"never"],[25.663,0.15,"been"],[25.825,0.3,"seen"],[26.125,0.45,"before"],[26.587,0.175,"by"],[26.825,0.487,"anyone"],[27.312,0.225,"other"],[27.55,0.15,"than"],[27.712,0.35,"you"],[28.45,0.15,"O"],[28.6,0.55,"Arjuna"],[29.675,0.263,"neither"],[29.95,0.125,"by"],[30.087,0.3