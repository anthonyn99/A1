,"truth"],[10.175,0.312,"even"],[10.5,0.163,"when"],[10.675,0.087,"it"],[10.775,0.537,"hurts"],[11.675,0.125,"And"],[11.812,0.15,"when"],[11.975,0.113,"you"],[12.1,0.1,"are"],[12.213,0.525,"lost"],[13.175,0.25,"say"],[13.438,0.388,"so"],[14.1,0.2,"and"],[14.312,0.263,"ask"],[14.588,0.138,"for"],[14.738,0.5,"wisdom"],[15.6,0.1,"In"],[15.713,0.412,"Chapter"],[16.137,0.388,"Two"],[16.538,0.438,"Krishna"],[16.988,0.388,"begins"],[17.387,0.113,"to"],[17.512,0.575,"answer"]]}]}