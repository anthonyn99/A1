ander elsewhere.","start":89.616,"at":90.192,"end":111.912,"words":[[0.087,0.35,"Krishna"],[0.45,0.55,"describes"],[1.012,0.075,"the"],[1.1,0.438,"yogi's"],[1.55,0.55,"departure"],[2.888,0.512,"gathering"],[3.413,0.062,"in"],[3.487,0.087,"the"],[3.587,0.562,"senses"],[4.625,0.362,"fixing"],[5.0,0.062,"the"],[5.075,0.375,"mind"],[5.463,0.15,"on"],[5.625,0.4,"God"],[6.612,0.175,"and"],[6.8,0.45,"uttering"],[7.263,0.362,"OM"],[8.15,0.087,"the"],[8.25,0.425,"sacred"],[8.688,0.438,"sound"],[9.525,0.237,"Such"],[9.775,0.075,"a"],[9.863,0.475,"person"],[10.35,0.487,"reaches"],[10.85,0.113,"the"],[10.975,0.525,"supreme"],[11.512,0.55,"abode"],[12.463,0.1,"And"],[12.575,0.188,"he"],[12.775,0.237,"adds"],[13.025,0.062,"a"],[13.1,0.637,"promise"],[14.275,0.163,"I"],[14.45,0.125,"am"],[14.6,0.463,"easily"],[15.075,0.4,"reached"],[15.488,0.138,"by"],[15.637,0.087,"the"],[15.738,0.35,"steady"],[16.1,0.45,"yogi"],[16.562,0.175,"who"],[16.75,0.3,"thinks"],[17.062,0.1,"of"],[17.175,0.225,"me"],[17.413,0.613,"always"],[18.375,0.25,"whose"],[18.637,0.425,"mind"],[19.075,0.15,"does"],[19.238,0.263,"not"],[19.512,0.4,"wander"],[19.925,0.562,"elsewhere"]]},{"layout":"story","headline":"Days and nights of creation","visual":["Brahma's day lasts a thousand ages","His night lasts a thousand more","Beings appear by day, dissolve by night"],"L":["L4"],"say":"Then the view widens to the scale of the cosmos. The creator's day, Krishna says, lasts a thousand ages, and his night as long. At the dawn of that day, all beings emerge. At nightfall, they dissolve again, only to reappear at the next dawn. Over and over, without end.","start":111.912,"at":112.488,"end":133.08,"words":[[0.087,0.275,"Then"],[0.375,0.075,"the"],[0.463,0.3,"view"],[0.775,0.575,"widens"],[1.363,0.125,"to"],[1.5,0.087,"the"],[1.6,0.487,"scale"],[2.1,0.1,"of"],[2.212,0.087,"the"],[2.312,0.713,"cosmos"],[3.413,0.062,"The"],[3.487,0.512,"creator's"],[4.013,0.412,"day"],[4.7,0.425,"Krishna"],[5.138,0.475,"says"],[6.188,0.475,"las