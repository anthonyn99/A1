,[9.438,0.237,"too"],[9.688,0.463,"little"],[10.512,0.325,"Only"],[10.85,0.1,"the"],[10.963,0.425,"person"],[11.4,0.125,"who"],[11.537,0.125,"is"],[11.675,0.475,"balanced"],[12.162,0.138,"in"],[12.312,0.45,"eating"],[13.012,0.537,"working"],[13.775,0.45,"sleeping"],[14.238,0.1,"and"],[14.35,0.525,"waking"],[14.887,0.2,"can"],[15.1,0.212,"use"],[15.325,0.675,"meditation"],[16.012,0.138,"to"],[16.163,0.237,"end"],[16.413,0.475,"sorrow"]]},{"layout":"lesson","headline":"Samadhi—The Goal of All Meditation Practice","visual":["A disciplined mind, free from all desires","Merges with the Eternal in samadhi","This is union, not the end of awareness"],"L":["L8"],"say":"Lesson eight. Samadhi is the goal of all meditation practice. When the disciplined mind becomes free of every desire and rests completely in God, that is union, samadhi. It is not the end of consciousness, but its fullness.","start":330.6,"at":331.176,"end":347.568,"words":[[0.113,0.475,"Lesson"],[0.6,0.475,"eight"],[1.462,0.75,"samadhi"],[2.225,0.163,"is"],[2.4,0.113,"the"],[2.525,0.388,"goal"],[2.925,0.138,"of"],[3.075,0.2,"all"],[3.288,0.625,"meditation"],[3.925,0.738,"practice"],[5.062,0.2,"When"],[5.275,0.113,"the"],[5.4,0.562,"disciplined"],[5.975,0.375,"mind"],[6.362,0.388,"becomes"],[6.763,0.225,"free"],[7.0,0.113,"of"],[7.125,0.225,"every"],[7.362,0.588,"desire"],[7.963,0.175,"and"],[8.15,0.425,"rests"],[8.588,0.562,"completely"],[9.162,0.125,"in"],[9.3,0.375,"God"],[9.988,0.163,"that"],[10.162,0.125,"is"],[10.3,0.475,"union"],[10.95,0.688,"samadhi"],[12.012,0.138,"It"],[12.162,0.125,"is"],[12.3,0.25,"not"],[12.562,0.15,"the"],[12.725,0.212,"end"],[12.95,0.113,"of"],[13.075,0.787,"consciousness"],[14.125,0.15,"but"],[14.287,0.188,"its"],[14.488,0.662,"fullness"]]},{"layout":"lesson","headline":"The Steady Mind Is Like a Sheltered Lamp","visual":["A lamp in a windless place","Does not flicker","So is the mind sheltered from desire"],"L":["L9"],"say":"Lesson nine. The steady mind is like a sheltered lamp. A flame in a place where no wind blows does not flicker. In the same way, the mind of the yogi, sheltered from the winds of desire, burns steady and clear.","start":347.568,"at":348.144,"end":363.0,"words":[[0.125,0.438,"Lesson"],[0.575,0.487,"nine"],[1.462,0.125,"The"],[1.6,0.35,"steady"],[1.962,0.438,"mind"],[2.413,0.175,"is"],[2.6,0.212,"like"],[2.825,0.05,"a"],[2.888,0.487,"sheltered"],[3.388,0.475,"lamp"],[4.263,0.075,"A"],[4.35,0.35,"flame"],[4.713,0.087,"in"],[4.812,0.062,"a"],[4.888,0.438,"place"],[5.338,0.175,"where"],[5.525,0.212,"no"],[5.75,0.338,"wind"],[6.1,0.388,"blows"],[6.5,0.163,"does"],[6.675,0.212,"not"],[6.9,0.5,"flicker"],[7.8,0.113,"In"],[7.925,0.1,"the"],[8.037,0.3,"same"],[8.35,0.362,"way"],[8.938,0.087,"the"],[9.037,0.312,"mind"],[9.363,0.087,"of"],[9.463,0.087,"the"],[9.562,0.512,"yogi"],[10.312,0.463,"sheltered"],[10.787,0.15,"from"],[10.95,0.087,"the"],[11.05,0.287,"winds"],[11.35,0.1,"of"],[11.463,0.55,"desire"],[12.262,0.338,"burns"],[12.613,0.4,"steady"],[13.025,0.125,"and"],[13.162,0.45,"clear"]]},{"layout":"lesson","headline":"Self-Realization Is the Highest Gain","visual":["Infinite bliss, beyond the senses","No gain seems greater","Even great sorrow cannot shake it"],"L":["L10"],"say":"Lesson ten. Self-realisation is the highest gain. Once the purified mind beholds the Eternal, it knows a bliss beyond the reach of the senses. After that, no other gain seems greater, and not even the heaviest sorrow can shake the person who has it.","start":363.0,"at":363.576,"end":381.24,"words":[[0.138,0.45,"Lesson"],[0.6,0.487,"ten"],[1.462,1.262,"Self-realisation"],[2.737,0.163,"is"],[2.913,0.1,"the"],[3.025,0.487,"highest"],[3.525,0.45,"gain"],[4.375,0.338,"Once"],[4.725,0.125,"the"],[4.862,0.662,"purified"],[5.537,0.412,"mind"],[5.963,0.438,"beholds"],[6.412,0.113,"the"],[6.537,0.537,"Eternal"],[7.375,0.1,"it"],[7.487,0.25,"knows"],[7.75,0.075,"a"],[7.838,0.362,"bliss"],[8.213,0.362,"beyond"],[8.588,0.1,"the"],[8.7,0.25,"reach"],[8.963,0.08