s"],[42.913,0.113,"is"],[43.038,0.237,"not"],[43.288,0.312,"bound"],[43.612,0.138,"by"],[43.763,0.45,"Karma"],[44.225,0.138,"though"],[44.375,0.537,"intensely"],[44.925,0.425,"engaged"],[45.362,0.1,"in"],[45.475,0.475,"work"]]},{"b":3,"part":0,"text":"A Karma-yogi works for God only","start":82.608,"dur":2.64,"words":[[0.125,0.087,"A"],[0.225,0.738,"Karma-yogi"],[0.975,0.463,"works"],[1.45,0.113,"for"],[1.575,0.25,"God"],[1.837,0.425,"only"]]},{"b":4,"part":0,"text":"The wise (or Samnyasi) who knows the truth thinks: \"I do nothing at all\". In seeing, hearing, touching, smelling, eating, walking, sleeping, breathing; and speaking, giving, taking, as well as opening and closing the eyes, a Samnyasi believes that only the senses are operating upon their objects. One who does all work as an offering to the Lord — abandoning attachment to the results — remains untouched by Karmic reaction or sin as a lotus leaf never gets wet by water, while living in it. The Karma-yogis perform action —without attachment — with their body, mind, intellect, and senses only for self-purification. A Karma-yogi attains Supreme Bliss by abandoning attachment to the fruits of work; while others, who are attached to the fruits of work, become bound by selfish work.","start":85.248,"dur":49.032,"words":[[0.138,0.087,"The"],[0.237,0.55,"wise"],[0.963,0.113,"or"],[1.087,0.738,"Samnyasi"],[2.062,0.1,"who"],[2.175,0.275,"knows"],[2.462,0.113,"the"],[2.587,0.325,"truth"],[2.925,0.438,"thinks"],[3.663,0.05,"I"],[3.725,0.175,"do"],[3.913,0.338,"nothing"],[4.263,0.138,"at"],[4.412,0.325,"all"],[5.112,0.175,"In"],[5.3,0.525,"seeing"],[6.037,0.475,"hearing"],[6.7,0.512,"touching"],[7.412,0.512,"smelling"],[8.175,0.425,"eating"],[8.85,0.487,"walking"],[9.575,0.55,"sleeping"],[10.375,0.5,"breathing"],[11.113,0.1,"and"],[11.225,0.613,"speaking"],[12.05,0.412,"giving"],[12.675,0.512,"taking"],[13.4,0.113,"as"],[13.525,0.15,"well"],[13.688,0.113,"as"],[13.812,0.388,"opening"],[14.213,0.087,"and"],[14.312,0.