0.362,"attain"],[88.662,0.637,"Nirvana"]]},{"b":9,"part":0,"text":"Path of meditation and contemplation","start":280.608,"dur":3.0,"words":[[0.1,0.35,"Path"],[0.463,0.113,"of"],[0.588,0.825,"meditation"],[1.425,0.175,"and"],[1.613,1.012,"contemplation"]]},{"b":10,"part":0,"text":"A sage is liberated by renouncing all material enjoyments, focusing the eyes and the mind between the eye-brows, equalizing the breath moving through the nostrils by using yogic techniques, keeping the senses, mind, and intellect under control, having salvation as the prime goal, and by becoming free from lust, anger, greed and fear. My devotee attains peace by knowing Me, the Supreme Being as the enjoyer of sacrifices and austerities, as the great Lord of all the universe, and the friend of all beings.","start":283.608,"dur":31.248,"words":[[0.125,0.075,"A"],[0.212,0.375,"sage"],[0.6,0.125,"is"],[0.738,0.613,"liberated"],[1.363,0.138,"by"],[1.512,0.637,"renouncing"],[2.163,0.175,"all"],[2.35,0.5,"material"],[2.862,0.65,"enjoyments"],[3.8,0.475,"focusing"],[4.287,0.125,"the"],[4.425,0.325,"eyes"],[4.763,0.075,"and"],[4.85,0.075,"the"],[4.938,0.375,"mind"],[5.325,0.3,"between"],[5.638,0.1,"the"],[5.75,0.613,"eye-brows"],[6.675,0.613,"equalizing"],[7.3,0.087,"the"],[7.4,0.325,"breath"],[7.737,0.375,"moving"],[8.125,0.163,"through"],[8.3,0.1,"the"],[8.412,0.537,"nostrils"],[8.963,0.113,"by"],[9.088,0.362,"using"],[9.463,0.338,"yogic"],[9.812,0.613,"techniques"],[10.725,0.325,"keeping"],[11.062,0.087,"the"],[11.162,0.6,"senses"],[11.988,0.45,"mind"],[12.625,0.138,"and"],[12.775,0.512,"intellect"],[13.3,0.188,"under"],[13.5,0.55,"control"],[14.338,0.237,"having"],[14.588,0.675,"salvation"],[15.275,0.15,"as"],[15.438,0.1,"the"],[15.55,0.325,"prime"],[15.887,0.388,"goal"],[16.55,0.15,"and"],[16.712,0.188,"by"],[16.913,0.45,"becoming"],[17.375,0.325,"free"],[17.712,0.237,"from"],[17.962,0.463,"lust"],[18.688,0.463,"anger"],[19.363,0.425,"greed"],[19.887,0.15,"and"],[20.05,0.475,"fear"],[20.913,0.17