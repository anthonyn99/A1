[19.65,0.25,"must"],[19.913,0.1,"be"],[20.025,0.475,"regarded"],[20.512,0.138,"as"],[20.663,0.062,"a"],[20.738,0.388,"saint"],[21.137,0.325,"because"],[21.462,0.075,"of"],[21.538,0.375,"making"],[21.913,0.087,"the"],[22.012,0.287,"right"],[22.312,0.713,"resolution"]]},{"b":19,"part":0,"text":"There are no unforgivable sins or sinners. The fire of sincere repentance burns all sins.","start":395.136,"dur":6.6,"words":[[0.087,0.125,"There"],[0.212,0.062,"are"],[0.287,0.362,"no"],[0.662,0.637,"unforgivable"],[1.312,0.438,"sins"],[1.762,0.163,"or"],[1.938,0.55,"sinners"],[2.862,0.075,"The"],[2.95,0.55,"fire"],[3.513,0.075,"of"],[3.587,0.588,"sincere"],[4.188,0.625,"repentance"],[4.812,0.45,"burns"],[5.362,0.237,"all"],[5.612,0.637,"sins"]]},{"b":20,"part":0,"text":"Such a person soon becomes righteous and attains everlasting peace. Be aware, O Arjuna, that My devotee shall never perish or fall down.","start":401.736,"dur":10.752,"words":[[0.1,0.25,"Such"],[0.362,0.062,"a"],[0.425,0.45,"person"],[0.887,0.338,"soon"],[1.225,0.425,"becomes"],[1.663,0.613,"righteous"],[2.513,0.237,"and"],[2.763,0.6,"attains"],[3.438,0.662,"everlasting"],[4.112,0.512,"peace"],[5.037,0.1,"Be"],[5.15,0.525,"aware"],[6.15,0.125,"O"],[6.275,0.537,"Arjuna"],[7.213,0.163,"that"],[7.388,0.15,"My"],[7.55,0.688,"devotee"],[8.238,0.237,"shall"],[8.488,0.312,"never"],[8.812,0.588,"perish"],[9.463,0.188,"or"],[9.662,0.263,"fall"],[9.925,0.45,"down"]]},{"b":21,"part":0,"text":"The path of devotional love is easier","start":412.488,"dur":2.952,"words":[[0.087,0.062,"The"],[0.163,0.463,"path"],[0.637,0.287,"of"],[0.938,0.537,"devotional"],[1.475,0.312,"love"],[1.875,0.15,"is"],[2.125,0.475,"easier"]]},{"b":22,"part":0,"text":"Anybody — including women, merchants, laborers, and the evil-minded — can attain the supreme abode by just surrendering unto My will with loving devotion, O Arjuna. It should then be very easy for holy priests and devout sages to attain the Supreme. Therefore, having obtained this joyless and transitory human life, one should always worship Me with loving devotion. Fix your mind on Me, be devoted to Me, worship Me, and bow down to Me. Thus, uniting yourself with Me by setting Me as the supreme goal and the sole refuge, you shall certainly come to Me.","start":415.44,"dur":38.088,"words":[[0.1,0.537,"Anybody"],[1.038,0.512,"including"],[1.562,0.375,"women"],[2.3,0.575,"merchants"],[2.962,0.575,"laborers"],[3.562,0.125,"and"],[3.688,0.05,"the"],[3.75,0.738,"evil-minded"],[4.938,0.163,"can"],[5.112,0.362,"attain"],[5.487,0.075,"the"],[5.575,0.463,"supreme"],[6.037,0.475,"abode"],[6.525,0.163,"by"],[6.7,0.375,"just"],[7.088,0.637,"surrendering"],[7.737,0.237,"unto"],[7.987,0.188,"My"],[8.188,0.35,"will"],[8.55,0.175,"with"],[8.738,0.4,"loving"],[9.15,0.637,"devotion"],[10.287,0.138,"O"],[10.438,0.662,"Arjuna"],[11.488,0.087,"It"],[11.588,0.263,"should"],[11.85,0.15,"then"],[12.012,0.113,"be"],[12.125,0.425,"very"],[12.562,0.35,"easy"],[12.925,0.163,"for"],[13.1,0.338,"holy"],[13.45,0.463,"priests"],[13.925,0.175,"and"],[14.113,0.325,"devout"],[14.45,0.588,"sages"],[15.05,0.113,"to"],[15.175,0.312,"attain"],[15.488,0.075,"the"],[15.575,0.613,"Supreme"],[16.587,0.588,"Therefore"],[17.587,0.25,"having"],[17.85,0.438,"obtained"],[18.3,0.175,"this"],[18.475,0.537,"joyless"],[19.025,0.2,"and"],[19.238,0.762,"transitory"],[20.012,0.375,"human"],[20.387,0.425,"life"],[21.225,0.212,"one"],[21.45,0.237,"should"],[21.762,0.45,"always"],[22.225,0.425,"worship"],[22.663,0.275,"Me"],[22.95,0.175,"with"],[23.137,0.4,"loving"],[23.55,0.637,"devotion"],[24.65,0.225,"Fix"],[24.887,0.113,"your"],[25.0,0.35,"mind"],[25.363,0.113,"on"],[25.475,0.275,"Me"],[26.225,0.1,"be"],[26.325,0.45,"devoted"],[26.788,0.113,"to"],[26.9,0.3,"Me"],[27.7,0.362,"worship"],[28.075,0.3,"Me"],[28.762,0.2,"and"],[28.962,0.25,"bow"],[29.225,0.287,"down"],[29.512,0.113,"to"],[29.637,0.338,"Me"],[30.35,0.4,"Thus"],[31.212,0.438,"uniting"],[31.663,0.388,"yourself"],[32.05,0.15,"with"],[32.2,0.25,