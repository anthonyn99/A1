 of devotion by the purehearted. O Arjuna, whatever you do, whatever you eat, whatever you offer as oblation to the sacred fire, whatever charity you give, whatever austerity you perform, do all that as an offering unto Me. You shall become free from the bondage — good and bad — of Karma by this attitude of complete renunciation (Samnyasa-yoga). Becoming liberated, you shall come to Me.","start":335.304,"dur":33.912,"words":[[0.15,0.575,"Whosoever"],[0.738,0.362,"offers"],[1.113,0.1,"Me"],[1.212,0.062,"a"],[1.275,0.438,"leaf"],[2.1,0.025,"a"],[2.138,0.575,"flower"],[3.112,0.025,"a"],[3.15,0.525,"fruit"],[4.088,0.212,"or"],[4.312,0.325,"water"],[4.65,0.125,"with"],[4.787,0.562,"devotion"],[5.812,0.062,"I"],[5.888,0.562,"accept"],[6.763,0.175,"and"],[7.088,0.125,"eat"],[7.225,0.087,"the"],[7.325,0.4,"offering"],[7.725,0.087,"of"],[7.812,0.588,"devotion"],[8.412,0.125,"by"],[8.55,0.113,"the"],[8.675,0.7,"purehearted"],[9.775,0.212,"O"],[10.0,0.6,"Arjuna"],[11.05,0.3,"whatever"],[11.363,0.113,"you"],[11.488,0.35,"do"],[12.262,0.3,"whatever"],[12.575,0.1,"you"],[12.675,0.3,"eat"],[13.412,0.3,"whatever"],[13.725,0.113,"you"],[13.85,0.487,"offer"],[14.35,0.125,"as"],[14.488,0.5,"oblation"],[15.0,0.087,"to"],[15.1,0.1,"the"],[15.213,0.4,"sacred"],[15.625,0.425,"fire"],[16.525,0.338,"whatever"],[16.863,0.4,"charity"],[17.275,0.1,"you"],[17.387,0.362,"give"],[18.163,0.312,"whatever"],[18.488,0.463,"austerity"],[18.95,0.075,"you"],[19.025,0.525,"perform"],[20.012,0.225,"do"],[20.25,0.287,"all"],[20.55,0.3,"that"],[20.913,0.125,"as"],[21.05,0.15,"an"],[21.288,0.45,"offering"],[21.75,0.237,"unto"],[22.0,0.3,"Me"],[22.675,0.113,"You"],[22.8,0.225,"shall"],[23.038,0.4,"become"],[23.45,0.35,"free"],[23.812,0.163,"from"],[23.975,0.075,"the"],[24.062,0.562,"bondage"],[25.025,0.25,"good"],[25.275,0.163,"and"],[25.45,0.4,"bad"],[26.3,0.113,"of"],[26.425,0.438,"Karma"],[26.875,0.15,"by"],[27.038,0.212,"this"],[27.3,0.613,"attitude"],[27.925,0.138,"of"],[28.075,0.463,"complete"],[28.55,0