{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the Shield UI, served from GitHub Pages, drive the local agent.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://anthonyn99.github.io/*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "global-shortcut:default",
    "autostart:default"
  ]
}
