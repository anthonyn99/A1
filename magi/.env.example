# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is gitignored -- it never gets committed.

# Powers the "Refine" button in the composer. Without it, refinement falls back
# to the slow browser path, which launches Chrome to rewrite one sentence.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
