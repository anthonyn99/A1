{
  // ── V1 suite website ──────────────────────────────────────────────────────
  // Serves EVERY app in the suite as static assets from one Worker:
  //
  //   dist/index.html          ->  https://tradeboard.<subdomain>.workers.dev/
  //   dist/finance/index.html  ->  https://tradeboard.<subdomain>.workers.dev/finance/
  //
  // The Worker keeps the name "tradeboard" on purpose: that hostname is already
  // deployed, bookmarked, and installed as a PWA. Renaming it would change the
  // URL and break every existing install, so the name stays and the wider scope
  // is documented here instead.
  //
  // Assets come from ../../dist, which `npm run build` generates from each app's
  // canonical HTML (see scripts/build.mjs). The deploy workflow runs that build
  // first, so one push publishes every app — no console step, no Pages project.
  //
  // This suite now lives at V1/ inside the A1 repo (anthonyn99/A1); it was
  // previously its own repo (VedaCPatel/V1). The relative ../../dist path is
  // unaffected by that move, and deploys are driven by
  // .github/workflows/deploy-v1-workers.yml against VEDA'S Cloudflare account
  // (CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID) — not Tony's CF_API_TOKEN.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradeboard",
  // Pinned because a second Cloudflare account exists on this login. Wrangler
  // cannot pick between accounts in CI and the deploy fails without it.
  "account_id": "b9a33dd573c14d5f446516ea8b46285f",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../../dist",
    // Serve /finance/ from /finance/index.html and keep the trailing slash
    // rather than redirecting it away — Plaid's OAuth redirect URI has to match
    // exactly, so the path must stay stable.
    "html_handling": "auto-trailing-slash",
    // A missing path returns 404 instead of silently serving the root app,
    // which would make a typo look like TradeBoard.
    "not_found_handling": "none"
  }
}
