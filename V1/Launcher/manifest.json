{
  "manifest_version": 3,
  "name": "Launcher",
  "version": "1.0.0",
  "description": "Veda's Links in the toolbar. Open one link or launch a whole group as a named tab group — synced both ways with the Links program.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://keychain-sync.av1.workers.dev/*",
    "https://anthonyn99.github.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Launcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
