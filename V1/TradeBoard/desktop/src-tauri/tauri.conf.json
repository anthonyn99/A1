{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeBoard",
  "version": "1.0.0",
  "identifier": "com.tradeboard.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm --prefix ../.. run build:desktop",
    "beforeDevCommand": "npm --prefix ../.. run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TradeBoard",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "tradeboard-tray",
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "tooltip": "TradeBoard"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
