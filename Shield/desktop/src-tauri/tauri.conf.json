{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shield",
  "version": "1.0.0",
  "identifier": "com.a1.shield",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shield",
        "url": "https://anthonyn99.github.io/A1/shield.html",
        "width": 520,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["shieldopen"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
